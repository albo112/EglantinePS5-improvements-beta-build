+/* EglantinePS5: the dump and the offer of it to the app are off unless EDEN_NX2_RADV_STALL_DUMP=1. */
+static bool
+radv_ps5_stall_dump_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *const value = getenv("EDEN_NX2_RADV_STALL_DUMP");
+      p_atomic_set(&enabled, value && value[0] == '1');
+   }
+   return enabled;
+}
+
 static void
 radv_ps5_dump_stall(struct radv_ps5_queue *queue, uint64_t seq, uint64_t completed)
 {
+   if (!radv_ps5_stall_dump_enabled())
+      return;
    /* Once per process: the console may hang right after, and a short burst is all it can flush. */
    static uint32_t dumped;
    if (p_atomic_cmpxchg(&dumped, 0u, 1u) != 0u)
@@ -1032,7 +1046,7 @@ extern void (*eden_radv_stall_dump)(void) __attribute__((weak));
 static void
 radv_ps5_offer_stall_dump(void)
 {
-   if (&eden_radv_stall_dump)
+   if (&eden_radv_stall_dump && radv_ps5_stall_dump_enabled())
       p_atomic_set(&eden_radv_stall_dump, radv_ps5_dump_stall_now);
 }
 
