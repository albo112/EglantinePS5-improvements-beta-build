       struct radeon_winsys_bo *bo;
-      result = radv_bo_create(device, NULL, RADV_MESH_COMPUTE_BYTES, 4096, RADEON_DOMAIN_VRAM,
+      result = radv_bo_create(device, NULL, radv_mesh_compute_bytes(), 4096, RADEON_DOMAIN_VRAM,
