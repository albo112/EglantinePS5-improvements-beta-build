       if (f) {
          char text[8] = {0};
-         if (fread(text, 1, sizeof(text) - 1, f) > 0 && text[0] == '0')
+         if (fread(text, 1, sizeof(text) - 1, f) > 0 && text[0] == '0') {
             value = 0;
