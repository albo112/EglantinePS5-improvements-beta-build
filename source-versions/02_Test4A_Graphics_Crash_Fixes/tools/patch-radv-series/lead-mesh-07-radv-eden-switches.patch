+      /* EglantinePS5: the task pipeline fails with this, and with EDEN_NX2_PIPELINE_FAIL_SOFT=1 that
+       * looks like mesh draws that show nothing. */
+      static uint32_t told;
+      if (result != VK_SUCCESS && told < 8 && p_atomic_inc_return(&told) <= 8)
+         fprintf(stderr, "radv/ps5: no memory for the mesh compute buffer (%u MiB): task pipeline refused\n",
+                 radv_mesh_compute_bytes() >> 20);
    }
    simple_mtx_unlock(&lock);
    return result;
@@ -117,6 +151,20 @@ radv_mesh_compute_lower_block(nir_shader *nir, const struct radv_shader_stage *s
 
 static const uint64_t allowed_vertex_outputs = VARYING_BIT_POS | BITFIELD64_RANGE(VARYING_SLOT_VAR0, 32);
 
+/* Why a mesh shader stays out of this path. With the path on its draws are then dropped
+ * (radv_mesh_draw_dropped in radv_cmd_buffer.c), so this line names what is left to do. */
+static void
+mesh_compute_refused(const nir_shader *mesh, const char *why)
+{
+   static uint32_t told;
+   if (told < 64 && p_atomic_inc_return(&told) <= 64)
+      fprintf(stderr,
+              "radv/ps5: mesh shader not run as compute: %s (vertices %u, primitives %u, outputs 0x%" PRIx64
+              ", per primitive 0x%" PRIx64 ")\n",
+              why, mesh->info.mesh.max_vertices_out, mesh->info.mesh.max_primitives_out, mesh->info.outputs_written,
+              mesh->info.per_primitive_outputs);
+}
+
 bool
 radv_mesh_compute_wanted(const struct radv_graphics_state_key *gfx_state, const struct radv_shader_stage *stages)
 {
@@ -124,31 +172,47 @@ radv_mesh_compute_wanted(const struct radv_graphics_state_key *gfx_state, const
    const nir_shader *task = stages[MESA_SHADER_TASK].nir;
    const nir_shader *fs = stages[MESA_SHADER_FRAGMENT].nir;
 
-   if (!mesh || !task || !radv_mesh_compute_enabled())
+   if (!mesh || !radv_mesh_compute_enabled())
+      return false;
+   if (!task) {
+      mesh_compute_refused(mesh, "no task shader");
       return false;
+   }
 
    /* First slice: triangles, outputs that are positions and generic varyings, no
     * per-primitive outputs but the indices, no multiview. */
-   if (mesh->info.mesh.primitive_type != MESA_PRIM_TRIANGLES || gfx_state->has_multiview_view_index)
+   if (mesh->info.mesh.primitive_type != MESA_PRIM_TRIANGLES || gfx_state->has_multiview_view_index) {
+      mesh_compute_refused(mesh, "not triangles, or multiview");
       return false;
+   }
    if (!mesh->info.mesh.max_vertices_out || mesh->info.mesh.max_vertices_out > 256 ||
-       !mesh->info.mesh.max_primitives_out || mesh->info.mesh.max_primitives_out > 256)
+       !mesh->info.mesh.max_primitives_out || mesh->info.mesh.max_primitives_out > 256) {
+      mesh_compute_refused(mesh, "vertex or primitive count out of range");
       return false;
+   }
 
    const uint64_t written = mesh->info.outputs_written;
    const uint64_t per_prim = mesh->info.per_primitive_outputs;
-   if ((written & ~per_prim) & ~allowed_vertex_outputs)
+   if ((written & ~per_prim) & ~allowed_vertex_outputs) {
+      mesh_compute_refused(mesh, "a vertex output other than position and generics");
       return false;
-   if ((written & per_prim) != VARYING_BIT_PRIMITIVE_INDICES)
+   }
+   if ((written & per_prim) != VARYING_BIT_PRIMITIVE_INDICES) {
+      mesh_compute_refused(mesh, "per-primitive outputs besides the indices");
       return false;
-   if (!(written & VARYING_BIT_POS))
+   }
+   if (!(written & VARYING_BIT_POS)) {
+      mesh_compute_refused(mesh, "no position");
       return false;
+   }
 
    if (fs) {
       nir_foreach_shader_in_variable (var, fs) {
          if (var->data.per_primitive || var->data.location == VARYING_SLOT_PRIMITIVE_ID ||
-             var->data.location == VARYING_SLOT_LAYER || var->data.location == VARYING_SLOT_VIEWPORT)
+             var->data.location == VARYING_SLOT_LAYER || var->data.location == VARYING_SLOT_VIEWPORT) {
+            mesh_compute_refused(mesh, "a per-primitive fragment input");
             return false;
+         }
       }
    }
    return true;
@@ -434,7 +498,7 @@ radv_mesh_compute_split(const struct radv_compiler_info *compiler_info, struct r
    l.max_primitives = mesh->info.mesh.max_primitives_out;
    l.prim_offset = 16 + l.max_vertices * l.num_vtx_slots * 16;
    l.stride = align(l.prim_offset + l.max_primitives * 4, 64);
-   l.capacity = MIN2((RADV_MESH_COMPUTE_BYTES - RADV_MESH_COMPUTE_HEADER_BYTES) / l.stride,
+   l.capacity = MIN2((radv_mesh_compute_bytes() - RADV_MESH_COMPUTE_HEADER_BYTES) / l.stride,
