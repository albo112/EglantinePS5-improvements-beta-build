diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index fa3909d..0b54dbb 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -9028,6 +9028,11 @@ radv_bind_mesh_shader(struct radv_cmd_buffer *cmd_buffer, const struct radv_shad
 {
    radv_bind_pre_rast_shader(cmd_buffer, ms);
 
+#ifdef RADV_GS_COMPUTE
+   /* EglantinePS5: its draws are dropped (radv_mesh_draw_dropped): no 320 MiB ring for them. */
+   if (radv_mesh_compute_enabled())
+      return;
+#endif
    cmd_buffer->queue_state.mesh_scratch_ring_needed |= ms->info.ms.needs_ms_scratch_ring;
 }
 
@@ -15740,7 +15745,8 @@ radv_mesh_compute_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_ta
    const struct radv_pipeline *pipeline = &cmd_buffer->state.graphics_pipeline->base;
    struct radv_cmd_stream *cs = cmd_buffer->cs;
    const uint32_t capacity = pipeline->mesh_compute_capacity;
-   const uint32_t passes = MIN2(DIV_ROUND_UP(RADV_MESH_COMPUTE_CHUNK_WORKGROUPS, capacity), RADV_MESH_COMPUTE_MAX_PASSES);
+   const uint32_t passes = MIN3(DIV_ROUND_UP(RADV_MESH_COMPUTE_CHUNK_WORKGROUPS, capacity), RADV_MESH_COMPUTE_MAX_PASSES,
+                                radv_mesh_compute_pass_limit());
    const uint64_t header_va = radv_buffer_get_va(device->mesh_compute_bo);
 
    radv_meta_mesh_compute_records(cmd_buffer, emu->draw_ring_va, AC_TASK_DRAW_ENTRY_BYTES, count_va, count,
@@ -15857,9 +15863,11 @@ radv_mesh_compute_draw(struct radv_cmd_buffer *cmd_buffer, const struct radv_dra
                                   chunks, emu.entries, out_va);
 
             for (uint32_t i = 0; i < draws * chunks; i++) {
-               const uint64_t block_va = out_va + i * sizeof(struct radv_task_emu_block);
+               /* EglantinePS5: its own name. As block_va this hid the draw's block, and the chunk's
+                * compute pass read records, payload, header and slots from the wrong memory. */
+               const uint64_t task_block_va = out_va + i * sizeof(struct radv_task_emu_block);
                const uint64_t args_va = out_va + draws * chunks * sizeof(struct radv_task_emu_block) + i * 16;
-               radv_task_emu_dispatch(cmd_buffer, &emu, block_va, 0, args_va);
+               radv_task_emu_dispatch(cmd_buffer, &emu, task_block_va, 0, args_va);
                radv_mesh_compute_chunk(cmd_buffer, &emu, block_va, first_draw + i / chunks, emu.entries, args_va);
             }
          }
@@ -15878,6 +15886,21 @@ radv_mesh_compute_bound(const struct radv_cmd_buffer *cmd_buffer)
 {
    return cmd_buffer->state.graphics_pipeline && cmd_buffer->state.graphics_pipeline->base.mesh_compute;
 }
+
+/* EglantinePS5: with the path on, a mesh draw of a pipeline it refused (mesh_compute_refused) is
+ * dropped, as EDEN_NX2_NO_MESH drops them all. exploitizm leaves those on the NGG mesh path, the
+ * one that stops this GPU. */
+static bool
+radv_mesh_draw_dropped(const struct radv_cmd_buffer *cmd_buffer)
+{
+   if (!radv_mesh_compute_enabled())
+      return false;
+   static uint32_t told;
+   if (told < 32 && p_atomic_inc_return(&told) <= 32)
+      fprintf(stderr, "radv/ps5: mesh draw dropped: pipeline %016" PRIx64 " is not run as compute\n",
+              cmd_buffer->state.graphics_pipeline ? cmd_buffer->state.graphics_pipeline->base.pipeline_hash : 0);
+   return true;
+}
 #endif
 
 VKAPI_ATTR void VKAPI_CALL
@@ -15893,6 +15916,8 @@ radv_CmdDrawMeshTasksEXT(VkCommandBuffer commandBuffer, uint32_t x, uint32_t y,
       radv_mesh_compute_draw(cmd_buffer, NULL, x, y, z);
       return;
    }
+   if (radv_mesh_draw_dropped(cmd_buffer))
+      return;
 #endif
 
    info.count = x * y * z;
@@ -15961,6 +15986,8 @@ radv_CmdDrawMeshTasksIndirect2EXT(VkCommandBuffer commandBuffer, const VkDrawInd
       radv_mesh_compute_draw(cmd_buffer, &info, 0, 0, 0);
       return;
    }
+   if (radv_mesh_draw_dropped(cmd_buffer))
+      return;
 #endif
 
    const uint64_t records_va = radv_mesh_draw_records(cmd_buffer, &info);
@@ -16031,6 +16058,8 @@ radv_CmdDrawMeshTasksIndirectCount2EXT(VkCommandBuffer commandBuffer, const VkDr
       radv_mesh_compute_draw(cmd_buffer, &info, 0, 0, 0);
       return;
    }
+   if (radv_mesh_draw_dropped(cmd_buffer))
+      return;
 #endif
 
    const uint64_t records_va = radv_mesh_draw_records(cmd_buffer, &info);
diff --git a/src/amd/vulkan/radv_mesh_compute.c b/src/amd/vulkan/radv_mesh_compute.c
