+         }
          fclose(f);
       }
-      if (!value)
-         fprintf(stderr, "radv/ps5: mesh shaders of emulated task draws run as mesh shaders "
-                         "(radv-mesh-compute.txt)\n");
+      if (value)
+         fprintf(stderr, "radv/ps5: mesh shaders of emulated task draws run as compute "
+                         "(EDEN_NX2_RADV_MESH_COMPUTE)\n");
       p_atomic_set(&enabled, value);
    }
    return enabled;
 }
 
+uint32_t
+radv_mesh_compute_bytes(void)
+{
+   static uint32_t bytes;
+   if (!bytes) {
+      const char *const value = getenv("EDEN_NX2_RADV_MESH_COMPUTE_MIB");
+      const unsigned long mib = value ? strtoul(value, NULL, 10) : 0;
+      p_atomic_set(&bytes, mib >= 8 && mib <= 512 ? (uint32_t)mib << 20 : RADV_MESH_COMPUTE_BYTES);
+   }
+   return bytes;
+}
+
+uint32_t
+radv_mesh_compute_pass_limit(void)
+{
+   static uint32_t limit;
+   if (!limit) {
+      const char *const value = getenv("EDEN_NX2_RADV_MESH_COMPUTE_PASSES");
+      const unsigned long passes = value ? strtoul(value, NULL, 10) : 0;
+      p_atomic_set(&limit, passes ? (uint32_t)MIN2(passes, UINT32_MAX) : UINT32_MAX);
+   }
+   return limit;
+}
+
 VkResult
 radv_mesh_compute_init(struct radv_device *device)
 {
@@ -53,7 +81,7 @@ radv_mesh_compute_init(struct radv_device *device)
    simple_mtx_lock(&lock);
