From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sat, 7 Nov 2026 07:45:00 +0100
Subject: [PATCH] radv/ps5: mesh shaders with no task shader read zero from the payload, and four smaller fixes

Driver patch, after lead-mesh-09. All of it only touches the lone path, apart from the push constant and
descriptor flags, which also cover task pipelines run as compute.

- Every mesh program the emulator makes declares a task payload and reads its stage buffer from it. With
  no task shader the compute pass read whatever the last task draw left in the ring. It now reads zero,
  as the core's own compute path does. Lone draws are Ocarina's leaves, and this may be behind flashes.
- The pipeline's push constant size and its upload and descriptor flags looked only at shaders[], which
  doesn't hold the compute pass. A depth-only lone pipeline has nothing else to cover them.
- RADV_MESH_COMPUTE_LONE_REVISION goes into the hash of lone pipelines, or T47's cached copies would stay in use.
  Task pipelines keep their hash.
- A lone draw takes its passes from its own count, not the 65536 cap of a task chunk.
- The stall dump's note names a lone draw instead of the last task draw.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index cfeb990..330271c 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15806,7 +15806,8 @@ radv_mesh_compute_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_ta
    /* With no task shader the draw says how many there are: only the passes they fill, each one
     * costs its flushes even when empty. */
    if (known_workgroups)
-      passes = MIN2(passes, DIV_ROUND_UP(known_workgroups, capacity));
+      passes = MIN2(MIN2(DIV_ROUND_UP(known_workgroups, capacity), RADV_MESH_COMPUTE_MAX_PASSES),
+                    radv_mesh_compute_pass_limit());
    const uint64_t header_va = radv_buffer_get_va(device->mesh_compute_bo);
 
    radv_meta_mesh_compute_records(cmd_buffer, emu->draw_ring_va, AC_TASK_DRAW_ENTRY_BYTES, count_va, count,
@@ -15895,6 +15896,15 @@ radv_mesh_compute_draw_body(struct radv_cmd_buffer *cmd_buffer, const struct rad
       emu.records_va = radv_buffer_get_va(device->task_emu_bo) + RADV_TASK_EMU_RECORDS_OFFSET;
       emu.draw_ring_va = radv_buffer_get_va(cmd_buffer->upload.upload_bo) + entry_offset;
       radv_cs_add_buffer(device->ws, cmd_buffer->cs->b, device->task_emu_bo);
+#ifdef RADV_PS5
+      radv_ps5_task_emu_note[1] = 0;
+      radv_ps5_task_emu_note[2] = 1;
+      radv_ps5_task_emu_note[3] = 16;
+      radv_ps5_task_emu_note[4] = 0xff;
+      radv_ps5_task_emu_note[6]++;
+      radv_ps5_task_emu_note[7] = pipeline->mesh_compute->va;
+      radv_ps5_task_emu_note[0] = radv_buffer_get_va(device->task_emu_bo);
+#endif
    } else if (!radv_task_emu_begin(cmd_buffer, &emu)) {
       return;
    }
diff --git a/src/amd/vulkan/radv_mesh_compute.c b/src/amd/vulkan/radv_mesh_compute.c
index 495ed1a..119abaa 100644
--- a/src/amd/vulkan/radv_mesh_compute.c
+++ b/src/amd/vulkan/radv_mesh_compute.c
@@ -128,6 +128,7 @@ struct mesh_compute_layout {
    unsigned stride;      /* a slot */
    unsigned capacity;    /* slots in a pass */
    unsigned payload_stride;
+   bool no_payload;       /* no task shader: its payload reads give zero */
    uint32_t address32_hi; /* of the block (radv_mesh_compute_block) */
 };
 
@@ -363,6 +364,13 @@ lower_mesh_intrinsic(nir_builder *b, nir_intrinsic_instr *intr, void *data)
       nir_def_replace(&intr->def, nir_imm_int(b, 0));
       return true;
    case nir_intrinsic_load_task_payload: {
+      /* The emulator's mesh programs all declare a payload and read their stage buffer from it. With
+       * no task shader nothing wrote it: zero, as the core's own compute path gives, not what the
+       * last task draw left in the ring. */
+      if (l->no_payload) {
+         nir_def_replace(&intr->def, nir_imm_zero(b, intr->def.num_components, intr->def.bit_size));
+         return true;
+      }
       nir_def *base = nir_iadd_imm(b, nir_imul_imm(b, s->entry, l->payload_stride), nir_intrinsic_base(intr));
       nir_def *addr = nir_iadd(b, s->payload, nir_u2u64(b, nir_iadd(b, base, intr->src[0].ssa)));
       nir_def *value = nir_build_load_global(b, intr->def.num_components, intr->def.bit_size, addr, .align_mul = 4);
@@ -515,8 +523,8 @@ radv_mesh_compute_split(const struct radv_compiler_info *compiler_info, struct r
    l.stride = align(l.prim_offset + l.max_primitives * 4, 64);
    l.capacity = MIN2((radv_mesh_compute_bytes() - RADV_MESH_COMPUTE_HEADER_BYTES) / l.stride,
                      RADV_MESH_COMPUTE_CHUNK_WORKGROUPS);
-   /* A mesh shader with no task shader reads no payload. */
    const nir_shader *task = stages[MESA_SHADER_TASK].nir;
+   l.no_payload = !task;
    l.payload_stride = align(MAX2(task ? task->info.task_payload_size : 0, 16), 16);
    l.address32_hi = compiler_info->hw.address32_hi;
 
diff --git a/src/amd/vulkan/radv_mesh_compute.h b/src/amd/vulkan/radv_mesh_compute.h
index aa1ff1a..c657146 100644
--- a/src/amd/vulkan/radv_mesh_compute.h
+++ b/src/amd/vulkan/radv_mesh_compute.h
@@ -73,6 +73,10 @@ uint32_t radv_mesh_compute_pass_limit(void);
  * env.txt. A direct draw of one is a single record, its grid the draw's. Unset, those draws are dropped. */
 bool radv_mesh_compute_lone(void);
 
+/* Goes into the hash of mesh pipelines with no task shader: raise it when what they compile to changes,
+ * or a cached copy stays in use. Task pipelines keep their hash, so only these rebuild. */
+#define RADV_MESH_COMPUTE_LONE_REVISION 2u
+
 struct radv_device;
 /* The device's buffer, made once (the first pipeline that may use it). */
 VkResult radv_mesh_compute_init(struct radv_device *device);
diff --git a/src/amd/vulkan/radv_pipeline_graphics.c b/src/amd/vulkan/radv_pipeline_graphics.c
index 526ae09..a6d8a8c 100644
--- a/src/amd/vulkan/radv_pipeline_graphics.c
+++ b/src/amd/vulkan/radv_pipeline_graphics.c
@@ -3082,6 +3082,10 @@ radv_graphics_pipeline_hash(const struct radv_device *device, const struct radv_
        radv_mesh_compute_enabled()) {
       const uint32_t mesh_compute_bytes = radv_mesh_compute_bytes();
       _mesa_blake3_update(&ctx, &mesh_compute_bytes, sizeof(mesh_compute_bytes));
+      if (gfx_state->stages[MESA_SHADER_TASK].stage == MESA_SHADER_NONE) {
+         const uint32_t lone_revision = RADV_MESH_COMPUTE_LONE_REVISION;
+         _mesa_blake3_update(&ctx, &lone_revision, sizeof(lone_revision));
+      }
    }
 #endif
 
@@ -3354,6 +3358,16 @@ radv_pipeline_init_shader_stages_state(const struct radv_device *device, struct
          }
       }
    }
+
+#ifdef RADV_GS_COMPUTE
+   /* A mesh shader run as compute is not among the pipeline's shaders. */
+   if (pipeline->base.mesh_compute) {
+      pipeline->base.need_indirect_descriptors |= radv_shader_need_indirect_descriptors(pipeline->base.mesh_compute);
+      pipeline->base.need_push_constants_upload |= radv_shader_need_push_constants_upload(pipeline->base.mesh_compute);
+      pipeline->base.need_dynamic_descriptors_offset_addr |=
+         radv_shader_need_dynamic_descriptors_offset_addr(pipeline->base.mesh_compute);
+   }
+#endif
 }
 
 static void
@@ -3505,6 +3519,10 @@ radv_graphics_pipeline_init(struct radv_graphics_pipeline *pipeline, struct radv
 
       push_constant_size = MAX2(push_constant_size, shader->info.push_constant_size);
    }
+#ifdef RADV_GS_COMPUTE
+   if (pipeline->base.mesh_compute)
+      push_constant_size = MAX2(push_constant_size, pipeline->base.mesh_compute->info.push_constant_size);
+#endif
 
    pipeline->base.push_constant_size = align(push_constant_size, 4);
    pipeline->base.dynamic_offset_count = gfx_state.layout.dynamic_offset_count;
