diff --git b/src/video_core/zpass_cut.h b/src/video_core/zpass_cut.h
new file mode 100644
index 0000000..326deb4
--- /dev/null
+++ b/src/video_core/zpass_cut.h
@@ -0,0 +1,254 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdlib>
+#include <mutex>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+
+namespace VideoCommon::ZpassCut {
+
+/// EDEN_NX2_ZPASS_CUT_LOG=1: log only. Counts the submissions that land inside a guest's ZPass
+/// window (from its reset to its report), who asked for each, and what the reports after them
+/// read. With EDEN_NX2_ZPASS_PAUSE unset such a submission drops the samples counted so far
+/// (Scheduler::EndPendingOperations), and a report that reads 0 tells the game "occluded".
+inline bool Enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_ZPASS_CUT_LOG");
+        return value != nullptr && value[0] != '0';
+    }();
+    return enabled;
+}
+
+/// EDEN_NX2_ZPASS_PAUSE_AB=<seconds>: a submission resets the counter for <seconds>, then pauses
+/// it for <seconds>, round and round from the first submission, so one run at one spot compares
+/// the two (Kajcsi's A/B on one binary, Lichii PR 121). Each change is logged with the console's
+/// wall clock. Unset, this returns pause. The pause phases carry EDEN_NX2_ZPASS_PAUSE's risks.
+inline bool PauseNow(bool pause) {
+    static const std::chrono::seconds period = [] {
+        const char* value = std::getenv("EDEN_NX2_ZPASS_PAUSE_AB");
+        return std::chrono::seconds{value != nullptr ? std::strtoul(value, nullptr, 10) : 0UL};
+    }();
+    if (period.count() == 0) {
+        return pause;
+    }
+    static const auto start = std::chrono::steady_clock::now();
+    static bool last{};
+    const bool now_paused = ((std::chrono::steady_clock::now() - start) / period) % 2 != 0;
+    if (now_paused != last) {
+        last = now_paused;
+        const auto clock = std::chrono::duration_cast<std::chrono::seconds>(
+            std::chrono::system_clock::now().time_since_epoch());
+        LOG_INFO(HW_GPU, "ZPASS pause A/B: {} from unix time {}", now_paused ? "pause" : "reset",
+                 clock.count());
+    }
+    return now_paused;
+}
+
+/// Who asked for a submission. Other is every caller without a SiteScope: the present, Finish.
+enum class Site : u32 { Other, Draws, Astc, Fence, FenceFlush, ListCopy, Idle, Count };
+
+inline constexpr std::size_t SiteCount = static_cast<std::size_t>(Site::Count);
+inline constexpr std::array<const char*, SiteCount> SiteNames{
+    "other", "draws", "astc", "fence", "fence flush", "list copy", "idle"};
+
+/// QueryBase::cut_note: 0 for a clean window, else 1 + the site of the last submission inside it.
+/// NoDrawAfter: no draw counted after that submission, so a reset leaves this report at 0.
+inline constexpr u32 SiteMask = 0xff;
+inline constexpr u32 NoDrawAfter = 0x100;
+
+/// The site of the submission this thread is making. Submissions run on the split's back.
+inline thread_local Site current_site = Site::Other;
+
+class SiteScope {
+public:
+    explicit SiteScope(Site site) : previous{current_site} {
+        current_site = site;
+    }
+    ~SiteScope() {
+        current_site = previous;
+    }
+    SiteScope(const SiteScope&) = delete;
+    SiteScope& operator=(const SiteScope&) = delete;
+
+private:
+    Site previous;
+};
+
+/// One report address. Bits are one a report, newest lowest.
+struct ReportSlot {
+    DAddr address;
+    u64 value_bits; ///< 1: the report wasn't 0
+    u64 cut_bits;   ///< 1: a submission fell in its window
+    u32 reports;    ///< This second
+    u32 to_zero;    ///< This second: reports of 0 after one that wasn't
+    u32 to_zero_cut;
+    u32 last_cut_note;
+};
+
+inline constexpr std::size_t TableSize = std::size_t{1} << 14;
+
+struct Stats {
+    std::array<std::atomic<u64>, SiteCount> submissions{};
+    std::array<std::atomic<u64>, SiteCount> cuts{};
+    std::atomic<u64> held{};
+
+    std::mutex mutex; ///< All below. Reports are written by more than one thread
+    std::array<ReportSlot, TableSize> table{};
+    std::array<u64, SiteCount> to_zero_by_site{};
+    u64 reports{};
+    u64 zero_reports{};
+    u64 cut_reports{};
+    u64 cut_zero_reports{};
+    u64 cut_no_draw_reports{};
+    u64 to_zero{};     ///< Reports of 0 after one that wasn't
+    u64 to_zero_cut{}; ///< Those with a cut in their window
+    u64 stayed{};      ///< Reports that weren't 0 after one that wasn't
+    u64 stayed_cut{};  ///< Those with a cut in their window
+    u64 untracked{};
+    s64 next_log_ms{};
+};
+
+inline Stats& Get() {
+    static Stats stats;
+    return stats;
+}
+
+/// A submission on this thread: open is whether a guest's window has samples at stake.
+inline void NoteSubmission(bool open) {
+    auto& stats = Get();
+    const auto site = static_cast<std::size_t>(current_site);
+    stats.submissions[site].fetch_add(1, std::memory_order_relaxed);
+    if (open) {
+        stats.cuts[site].fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+/// EDEN_NX2_ZPASS_KEEP_WINDOW held back a submission that could wait.
+inline void NoteHeld() {
+    if (Enabled()) {
+        Get().held.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+/// The name of the site in a cut note.
+inline const char* CutSiteName(u32 cut_note) {
+    const std::size_t site = (cut_note & SiteMask) - 1;
+    return cut_note != 0 && site < SiteCount ? SiteNames[site] : "none";
+}
+
+/// Keeps one report under its address. Only the first 0 of a row counts: once a game hides an
+/// object, its next reports can read 0 for reasons of their own.
+inline void NoteHistory(Stats& stats, DAddr address, bool non_zero, u32 cut_note) {
+    static constexpr std::size_t max_probes = 8;
+    const std::size_t index =
+        static_cast<std::size_t>(((address >> 2) * 0x9E3779B97F4A7C15ULL) >> 50);
+    for (std::size_t probe = 0; probe < max_probes; ++probe) {
+        ReportSlot& slot = stats.table[(index + probe) & (TableSize - 1)];
+        if (slot.address != address && slot.address != 0) {
+            continue;
+        }
+        const bool cut = cut_note != 0;
+        if (slot.address != 0 && (slot.value_bits & 1) != 0) {
+            if (non_zero) {
+                ++stats.stayed;
+                stats.stayed_cut += cut ? 1 : 0;
+            } else {
+                ++stats.to_zero;
+                ++slot.to_zero;
+                if (cut) {
+                    ++stats.to_zero_cut;
+                    ++slot.to_zero_cut;
+                    const std::size_t site = (cut_note & SiteMask) - 1;
+                    if (site < SiteCount) {
+                        ++stats.to_zero_by_site[site];
+                    }
+                }
+            }
+        }
+        slot.address = address;
+        slot.value_bits = (slot.value_bits << 1) | (non_zero ? 1 : 0);
+        slot.cut_bits = (slot.cut_bits << 1) | (cut ? 1 : 0);
+        slot.last_cut_note = cut ? cut_note : slot.last_cut_note;
+        ++slot.reports;
+        return;
+    }
+    ++stats.untracked;
+}
+
+/// Once a second: the addresses that went to 0 at least twice, 32 at most, then totals since the
+/// start. "stayed" against "to zero", each with its share after a cut, tells whether a cut makes a
+/// report read 0 with no clock to line up: an object that keeps flipping with the camera still
+/// isn't really going in and out of view.
+inline void LogSecond(Stats& stats) {
+    static constexpr u32 min_to_zero = 2;
+    static constexpr std::size_t max_lines = 32;
+    std::size_t lines = 0;
+    for (ReportSlot& slot : stats.table) {
+        if (slot.to_zero >= min_to_zero && lines < max_lines) {
+            ++lines;
+            LOG_INFO(HW_GPU,
+                     "ZPASS flip: addr={:#x} reports={} to zero={} after a cut={} last site={} "
+                     "value bits={:032b} cut bits={:032b}",
+                     slot.address, slot.reports, slot.to_zero, slot.to_zero_cut,
+                     CutSiteName(slot.last_cut_note), slot.value_bits & 0xffffffffULL,
+                     slot.cut_bits & 0xffffffffULL);
+        }
+        slot.reports = 0;
+        slot.to_zero = 0;
+        slot.to_zero_cut = 0;
+    }
+    const auto at = [](const std::array<std::atomic<u64>, SiteCount>& list, Site site) {
+        return list[static_cast<std::size_t>(site)].load(std::memory_order_relaxed);
+    };
+    const auto zero_at = [&stats](Site site) {
+        return stats.to_zero_by_site[static_cast<std::size_t>(site)];
+    };
+    LOG_INFO(HW_GPU,
+             "ZPASS cut totals: reports {} zero {} cut {} cut zero {} cut no draw {} held {}; "
+             "to zero {} after a cut {}; stayed {} after a cut {}; untracked {}",
+             stats.reports, stats.zero_reports, stats.cut_reports, stats.cut_zero_reports,
+             stats.cut_no_draw_reports, stats.held.load(std::memory_order_relaxed), stats.to_zero,
+             stats.to_zero_cut, stats.stayed, stats.stayed_cut, stats.untracked);
+    LOG_INFO(HW_GPU,
+             "ZPASS cut sites, to zero, cuts/submissions: draws {}, {}/{} astc {}, {}/{} fence {}, "
+             "{}/{} fence flush {}, {}/{} list copy {}, {}/{} idle {}, {}/{} other {}, {}/{}",
+             zero_at(Site::Draws), at(stats.cuts, Site::Draws), at(stats.submissions, Site::Draws),
+             zero_at(Site::Astc), at(stats.cuts, Site::Astc), at(stats.submissions, Site::Astc),
+             zero_at(Site::Fence), at(stats.cuts, Site::Fence), at(stats.submissions, Site::Fence),
+             zero_at(Site::FenceFlush), at(stats.cuts, Site::FenceFlush),
+             at(stats.submissions, Site::FenceFlush), zero_at(Site::ListCopy),
+             at(stats.cuts, Site::ListCopy), at(stats.submissions, Site::ListCopy),
+             zero_at(Site::Idle), at(stats.cuts, Site::Idle), at(stats.submissions, Site::Idle),
+             zero_at(Site::Other), at(stats.cuts, Site::Other), at(stats.submissions, Site::Other));
+}
+
+/// Runs where the report is written to guest memory, with its final value.
+inline void NoteReport(DAddr address, u64 value, u32 cut_note) {
+    auto& stats = Get();
+    std::scoped_lock lock{stats.mutex};
+    ++stats.reports;
+    stats.zero_reports += value == 0 ? 1 : 0;
+    if (cut_note != 0) {
+        ++stats.cut_reports;
+        stats.cut_zero_reports += value == 0 ? 1 : 0;
+        stats.cut_no_draw_reports += (cut_note & NoDrawAfter) != 0 ? 1 : 0;
+    }
+    NoteHistory(stats, address, value != 0, cut_note);
+    const s64 now = std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+    if (now >= stats.next_log_ms) {
+        stats.next_log_ms = now + 1000;
+        LogSecond(stats);
+    }
+}
+
+} // namespace VideoCommon::ZpassCut
