diff --git a/src/video_core/dma_pusher.cpp b/src/video_core/dma_pusher.cpp
index c7bdfc9bb8294ec76dcd5d43afcd28d4c12c000e..9cfc3b64122a6485e020c4f6ae501de1df9479ff 100644
