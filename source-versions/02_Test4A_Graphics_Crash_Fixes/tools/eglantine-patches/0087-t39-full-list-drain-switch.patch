@@ -89,6 +89,18 @@ void DmaPusher::DispatchCalls() {
     system.GPU().OnCommandListEnd();
 }
 
+// EDEN_NX2_LIST_DRAIN_FULL=1 (A/B): a command list on pages the GPU wrote waits for everything
+// queued for the split's back and is flushed and read from guest memory (FlushGpuWrittenCommands),
+// as the Zortos-based Mario Kart World builds did by default, instead of reading the buffer cache's
+// copy after waiting only for compute and copy work (ReadGpuWrittenCommands).
+static bool ListDrainFull() {
+    static const bool full = [] {
+        const char* value = std::getenv("EDEN_NX2_LIST_DRAIN_FULL");
+        return value != nullptr && value[0] == '1';
+    }();
+    return full;
+}
