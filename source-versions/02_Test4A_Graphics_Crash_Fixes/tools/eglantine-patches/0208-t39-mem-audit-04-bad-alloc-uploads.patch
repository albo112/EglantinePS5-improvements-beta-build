     }
     // The host GPU has its own copy now and the guest rarely reads this memory again: TickFrame
     // marks it cold, so the OS pages it out before anything else when it needs RAM (title 1
@@ -1981,6 +1978,19 @@ void TextureCache<P>::RefreshContents(Image& image, ImageId image_id) {
     }
 }
 
+template <class P>
+void TextureCache<P>::KeepContentsAfterBadAlloc(Image& image) {
+    static const bool ends = [] {
+        const char* value = std::getenv("EDEN_NX2_BAD_ALLOC_ENDS");
+        return value != nullptr && value[0] == '1';
+    }();
+    if (ends) {
+        throw;
+    }
+    LOG_ERROR(HW_GPU, "No memory to upload the image at {:#x}: kept as it is", image.gpu_addr);
+    runtime.TransitionImageLayout(image);
+}
