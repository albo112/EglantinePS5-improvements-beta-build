+bool DropMeshDrawsBeforeBuild() {
+    static const bool drop = [] {
+        const char* value = std::getenv("EDEN_NX2_NO_MESH_BUILD");
+        return value != nullptr && value[0] == '1' && std::getenv("EDEN_NX2_NO_MESH") != nullptr &&
+               std::getenv("EDEN_NX2_NO_MESH_FILE") == nullptr;
+    }();
+    return drop;
+}
