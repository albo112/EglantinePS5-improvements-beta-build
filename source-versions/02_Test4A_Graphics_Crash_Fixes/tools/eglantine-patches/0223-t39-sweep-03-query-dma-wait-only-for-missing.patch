diff --git a/src/video_core/query_dma.h b/src/video_core/query_dma.h
index 849a3c9050..f6a97eed7d 100644
--- a/src/video_core/query_dma.h
+++ b/src/video_core/query_dma.h
@@ -30,12 +30,17 @@ inline bool TraceEnabled() {
 
 /// EDEN_NX2_QUERY_DMA_SYNC=1 (Lichii's experiment, branch test/all-in-one-flash): before such a
 /// read, wait for the host GPU and the fence that writes the results, as High accuracy does.
-inline bool SyncEnabled() {
-    static const bool enabled = [] {
+/// EDEN_NX2_QUERY_DMA_SYNC=2 (Lichii PR 215): write out reports with a final value at once, and
+/// wait only when one still has no host result. Reports already landed cost no wait.
+inline int SyncMode() {
+    static const int mode = [] {
         const char* value = std::getenv("EDEN_NX2_QUERY_DMA_SYNC");
-        return value != nullptr && value[0] != '0';
+        if (value == nullptr || value[0] == '0') {
+            return 0;
+        }
+        return value[0] == '2' ? 2 : 1;
     }();
-    return enabled;
+    return mode;
 }
 
 /// Whether [source, source + size) holds reports still waiting for host query results. Runs
@@ -57,6 +62,21 @@ inline bool HasPendingQueries(const Tegra::MemoryManager& memory,
     return false;
 }
 
+/// Writes the reports in [source, source + size) to guest memory, waiting for pending host
+/// results. Runs where the rasterizer's caches are owned.
+inline void FlushPending(const Tegra::MemoryManager& memory,
+                         VideoCore::RasterizerInterface& rasterizer, GPUVAddr source, size_t size) {
+    constexpr GPUVAddr page_size = 0x1000;
+    const GPUVAddr end = source + size;
+    for (GPUVAddr begin = source; begin < end;) {
+        const GPUVAddr page_end = (std::min)((begin & ~(page_size - 1)) + page_size, end);
+        if (const auto device = memory.GpuToCpuAddress(begin)) {
+            rasterizer.FlushQueryResults(*device, page_end - begin);
+        }
+        begin = page_end;
+    }
+}
+
 /// Logs a read of pending reports with the words it reads, and the same words once the next
 /// fence has popped and the results have landed.
 inline void Trace(const Tegra::MemoryManager& memory, VideoCore::RasterizerInterface& rasterizer,
@@ -84,11 +104,11 @@ inline void Trace(const Tegra::MemoryManager& memory, VideoCore::RasterizerInter
     });
 }
 
-/// Traces and, with EDEN_NX2_QUERY_DMA_SYNC, waits for the pending reports a read covers.
+/// Traces and, with EDEN_NX2_QUERY_DMA_SYNC=1, waits for the pending reports a read covers.
 inline void BeforeRead(const Tegra::MemoryManager& memory,
                        VideoCore::RasterizerInterface& rasterizer, u32 macro, u32 method,
                        GPUVAddr source, size_t size) {
-    if (!TraceEnabled() && !SyncEnabled()) {
+    if (!TraceEnabled() && SyncMode() != 1) {
         return;
     }
     if (!HasPendingQueries(memory, rasterizer, source, size)) {
@@ -97,9 +117,19 @@ inline void BeforeRead(const Tegra::MemoryManager& memory,
     if (TraceEnabled()) {
         Trace(memory, rasterizer, macro, method, source, size);
     }
-    if (SyncEnabled()) {
+    if (SyncMode() == 1) {
         rasterizer.WaitForQueries();
     }
 }
 
+/// EDEN_NX2_QUERY_DMA_SYNC=2: the last step before a read, after the buffer cache flush, so that
+/// the flush cannot put older words over the reports.
+inline void AfterBufferFlush(const Tegra::MemoryManager& memory,
+                             VideoCore::RasterizerInterface& rasterizer, GPUVAddr source,
+                             size_t size) {
+    if (SyncMode() == 2) {
+        FlushPending(memory, rasterizer, source, size);
+    }
+}
+
 } // namespace VideoCommon::QueryDma
