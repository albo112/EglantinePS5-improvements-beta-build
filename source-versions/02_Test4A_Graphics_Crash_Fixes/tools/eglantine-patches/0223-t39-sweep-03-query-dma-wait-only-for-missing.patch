+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1619,6 +1619,15 @@ void RasterizerVulkan::WaitForQueries() {
     fence_manager.SignalAndWait();
 }
 
+void RasterizerVulkan::FlushQueryResults(DAddr addr, u64 size) {
+    if (addr == 0 || size == 0 || !query_cache.SemiFlushRegion(addr, size)) {
+        return;
+    }
+    // Below High GPU accuracy a fence runs its own callback at once, so ReleaseFences would return
+    // before the report writes ran. SignalAndWait waits for an operation queued behind them.
+    fence_manager.SignalAndWait();
+}
