+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <memory>
+
+#include "common/common_types.h"
+
+namespace VideoCommon {
+
+/// EDEN_NX2_INVALIDATION_FILTER=1: the GPU's own cached writes (constant buffer data, every draw)
+/// are invalidated in the texture, query and shader caches at the next draw. Those caches only
+/// visit objects registered on the written pages, and constant buffer memory holds none, so each
+/// call took the cache's lock and walked its page tables for nothing (Lichii PR 250, thibaut:
+/// about 88k times a second in Ocarina of Time, +3.4% on a 4090). With the switch each cache keeps
+/// a PageFilter and InnerInvalidation skips the caches whose pages were never registered.
+/// Unset: no filter is allocated, every cache is told as before.
+inline bool InvalidationFilterEnabled() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_NX2_INVALIDATION_FILTER");
+        return value != nullptr && value[0] != '0';
+    }();
+    return enabled;
+}
+
+/// The 4 KiB device pages a cache has ever registered objects on. Bits are never cleared, so a
+/// clear bit proves the cache holds nothing there and an invalidation of those pages does nothing.
+/// Without the switch there are no words: Mark does nothing and Any answers true.
+class PageFilter {
+public:
+    PageFilter() {
+        if (InvalidationFilterEnabled()) {
+            words = std::make_unique<std::atomic<u64>[]>(NumWords);
+        }
+    }
+
+    void Mark(u64 address, u64 size) {
+        if (!words || size == 0) {
+            return;
+        }
+        const u64 first = address >> PageBits;
+        const u64 last = (address + size - 1) >> PageBits;
+        if (last >= NumWords * 64) {
+            overflow.store(true, std::memory_order_relaxed);
+            return;
+        }
+        for (u64 page = first; page <= last;) {
+            const u64 bit = page % 64;
+            const u64 count = (std::min<u64>)(64 - bit, last - page + 1);
+            const u64 mask = (count == 64 ? ~u64{0} : (u64{1} << count) - 1) << bit;
+            auto& word = words[page / 64];
+            if ((word.load(std::memory_order_relaxed) & mask) != mask) {
+                word.fetch_or(mask, std::memory_order_relaxed);
+            }
+            page += count;
+        }
+    }
+
+    /// Whether the cache may hold objects on [address, address + size).
+    [[nodiscard]] bool Any(u64 address, u64 size) const {
+        if (!words) {
+            return true;
+        }
+        if (size == 0) {
+            return false;
+        }
+        const u64 first = address >> PageBits;
+        const u64 last = (address + size - 1) >> PageBits;
+        if (last >= NumWords * 64 || overflow.load(std::memory_order_relaxed)) {
+            return true;
+        }
+        for (u64 page = first; page <= last;) {
+            const u64 bit = page % 64;
+            const u64 count = (std::min<u64>)(64 - bit, last - page + 1);
+            const u64 mask = (count == 64 ? ~u64{0} : (u64{1} << count) - 1) << bit;
+            if (words[page / 64].load(std::memory_order_relaxed) & mask) {
+                return true;
+            }
+            page += count;
+        }
+        return false;
+    }
+
+private:
+    static constexpr u64 PageBits = 12;
+    static constexpr u64 NumWords = (u64{1} << (36 - PageBits)) / 64; // 2 MiB of bits
+    std::unique_ptr<std::atomic<u64>[]> words;
+    std::atomic<bool> overflow{};
+};
+
+} // namespace VideoCommon
