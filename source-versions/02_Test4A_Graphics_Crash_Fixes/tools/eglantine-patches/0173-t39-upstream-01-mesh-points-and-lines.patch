+// EDEN_NX2_MESH_POINTS=1: mesh programs that output points (topology 0) or lines (1) compile; unset
+// they are refused as before and their draws stay skipped. Mesh draws as compute only know triangle
+// lists (fable-mesh-compute 0180: stride 3, degenerate triangles, a triangle-list readback), so with
+// EDEN_NX2_MESH_AS_COMPUTE=1 they stay refused whatever this says. A function-local static: env.txt
+// is read in main.
+bool MeshPointsAndLines() {
+    static const bool allowed = [] {
+        const char* const points = std::getenv("EDEN_NX2_MESH_POINTS");
+        const char* const as_compute = std::getenv("EDEN_NX2_MESH_AS_COMPUTE");
+        return points != nullptr && points[0] == '1' &&
+               (as_compute == nullptr || as_compute[0] != '1');
+    }();
+    return allowed;
+}
