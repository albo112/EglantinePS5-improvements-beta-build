+std::string FailedMacroParameters(u32 start, std::span<const u32> parameters) {
+    // The GPU thread and the split front both run macros.
+    static std::mutex mutex;
+    static std::unordered_map<u32, u32> failures_by_start;
+    static u32 failures_shown = 0;
+    std::scoped_lock lock{mutex};
+    if (failures_shown >= 128 || failures_by_start[start]++ >= 16) {
+        return {};
+    }
+    ++failures_shown;
+    const auto shown = parameters.first(std::min<size_t>(parameters.size(), 64));
+    return fmt::format(", parameters={:08x}{}", fmt::join(shown, ","),
+                       shown.size() < parameters.size() ? ",..." : "");
+}
