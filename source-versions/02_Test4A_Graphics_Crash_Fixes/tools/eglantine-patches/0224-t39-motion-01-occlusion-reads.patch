+    /// SignalAndWait with a time limit: false when it gave up. The wait state is on the heap, because
+    /// the operation can still run after that.
+    bool SignalAndWaitFor(std::chrono::milliseconds limit) {
+        struct WaitState {
+            std::mutex mutex;
+            std::condition_variable cv;
+            bool finished{};
+        };
+        const auto state = std::make_shared<WaitState>();
+        SyncOperation([state] {
+            std::scoped_lock lk(state->mutex);
+            state->finished = true;
+            state->cv.notify_all();
+        });
+        SignalFence([] {});
+        rasterizer.FlushCommands();
+        SubmitDeferred();
+        if constexpr (!can_async_check) {
+            TryReleasePendingFences<true>();
+        }
+        const auto deadline = std::chrono::steady_clock::now() + limit;
+        std::unique_lock lk(state->mutex);
+        while (!state->cv.wait_for(lk, std::chrono::milliseconds{5},
+                                   [&state] { return state->finished; })) {
+            if (std::chrono::steady_clock::now() >= deadline) {
+                return false;
+            }
+            lk.unlock();
+            SubmitDeferred();
+            lk.lock();
+        }
+        return true;
+    }
+
     void WaitPendingFences([[maybe_unused]] bool force) {
         if constexpr (!can_async_check) {
             TryReleasePendingFences<true>();
diff --git a/src/video_core/query_dma.h b/src/video_core/query_dma.h
index f6a97eed7d..e64e5e1b46 100644
--- a/src/video_core/query_dma.h
+++ b/src/video_core/query_dma.h
@@ -32,13 +32,15 @@ inline bool TraceEnabled() {
 /// read, wait for the host GPU and the fence that writes the results, as High accuracy does.
 /// EDEN_NX2_QUERY_DMA_SYNC=2 (Lichii PR 215): write out reports with a final value at once, and
 /// wait only when one still has no host result. Reports already landed cost no wait.
+/// EDEN_NX2_QUERY_DMA_SYNC=3: at the same place as 2, but wait first and write after, so that no
+/// report goes out before its operation added the carried count, and give up after 2 s.
 inline int SyncMode() {
     static const int mode = [] {
         const char* value = std::getenv("EDEN_NX2_QUERY_DMA_SYNC");
         if (value == nullptr || value[0] == '0') {
             return 0;
         }
-        return value[0] == '2' ? 2 : 1;
+        return value[0] == '2' || value[0] == '3' ? value[0] - '0' : 1;
     }();
     return mode;
 }
@@ -122,12 +124,12 @@ inline void BeforeRead(const Tegra::MemoryManager& memory,
     }
 }
 
-/// EDEN_NX2_QUERY_DMA_SYNC=2: the last step before a read, after the buffer cache flush, so that
-/// the flush cannot put older words over the reports.
+/// EDEN_NX2_QUERY_DMA_SYNC=2 and 3: the last step before a read, after the buffer cache flush, so
+/// that the flush cannot put older words over the reports.
 inline void AfterBufferFlush(const Tegra::MemoryManager& memory,
                              VideoCore::RasterizerInterface& rasterizer, GPUVAddr source,
                              size_t size) {
-    if (SyncMode() == 2) {
+    if (SyncMode() >= 2) {
         FlushPending(memory, rasterizer, source, size);
     }
 }
