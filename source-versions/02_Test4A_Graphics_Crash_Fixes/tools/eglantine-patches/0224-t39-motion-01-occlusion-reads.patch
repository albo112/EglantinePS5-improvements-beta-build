 void RasterizerVulkan::FlushQueryResults(DAddr addr, u64 size) {
+    if (addr != 0 && size != 0 && VideoCommon::QueryDma::SyncMode() == 3) {
+        // SemiFlushRegion alone writes a final value before its operation adds the carried count:
+        // a report with no draw after a sync would go out as 0. So wait for the operations first.
+        if (query_cache.IsRegionGpuModified(addr, size) &&
+            !fence_manager.SignalAndWaitFor(std::chrono::seconds{2})) {
+            static u32 gave_up{};
+            if (++gave_up <= 16 || gave_up % 1000 == 0) {
+                LOG_WARNING(Render_Vulkan, "Query DMA wait gave up after 2 s at {:#x} ({} so far)",
+                            addr, gave_up);
+            }
+        }
+        query_cache.SemiFlushRegion(addr, size);
+        return;
+    }
     if (addr == 0 || size == 0 || !query_cache.SemiFlushRegion(addr, size)) {
         return;
     }
