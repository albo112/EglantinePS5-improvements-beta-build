+template <class P>
+void TextureCache<P>::CollectForBuffer(u64 wanted) {
+    static constexpr u64 MIN_AGE = 3;
+    static constexpr size_t MAX_IMAGES = 32;
+    if (frame_tick < MIN_AGE) {
+        return;
+    }
+    boost::container::small_vector<ImageId, MAX_IMAGES> clean;
+    u64 total = 0;
+    lru_cache.ForEachItemBelow(frame_tick - MIN_AGE, [&](ImageId image_id) {
+        const Image& image = slot_images[image_id];
+        if (True(image.flags & ImageFlagBits::IsDecoding) ||
+            (IsDownloadable(image) && False(image.flags & ImageFlagBits::BadOverlap))) {
+            return false;
+        }
+        const u64 bytes = ImageMemoryBytes(image);
+        total += bytes;
+        clean.push_back(image_id);
+        return bytes >= wanted || total >= wanted * 4 || clean.size() == MAX_IMAGES;
+    });
+    for (const ImageId image_id : clean) {
+        Image& image = slot_images[image_id];
+        if (True(image.flags & ImageFlagBits::Tracked)) {
+            UntrackImage(image, image_id);
+        }
+        UnregisterImage(image_id);
+        DeleteImage(image_id, image.scale_tick > frame_tick + 5);
+    }
+    std::fprintf(stderr, "EDEN_BUFFER_REFUSED %zu images, %llu MiB, deleted for %llu MiB\n",
+                 clean.size(), static_cast<unsigned long long>(total >> 20),
+                 static_cast<unsigned long long>(wanted >> 20));
+}
+
+template <class P>
+void TextureCache<P>::ReleaseFinished() {
+    if constexpr (requires { runtime.CurrentTick(); }) {
+        while (!gpu_sentenced_images.empty() &&
+               runtime.IsFree(gpu_sentenced_images.front().tick)) {
+            gpu_sentenced_bytes -= gpu_sentenced_images.front().bytes;
+            gpu_sentenced_images.pop_front();
+        }
+    }
+}
