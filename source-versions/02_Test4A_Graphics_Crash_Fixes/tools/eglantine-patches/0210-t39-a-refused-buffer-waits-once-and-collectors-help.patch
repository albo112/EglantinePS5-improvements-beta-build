+template <class P>
+void BufferCache<P>::CollectRefused() {
+    buffer_refused_bytes.store(0, std::memory_order_relaxed);
+    if (!channel_state) {
+        return;
+    }
+    RunGarbageCollector(true);
+    buffer_refused_size = ~u64{0};
+    if (std::exchange(bindings_cut, false)) {
+        // Uniform, storage and texture bindings are looked up again when the guest sets them.
+        auto& flags = maxwell3d->dirty.flags;
+        flags[Dirty::IndexBuffer] = true;
+        flags[Dirty::VertexBuffers] = true;
+        for (u32 index = 0; index < NUM_VERTEX_BUFFERS; ++index) {
+            flags[Dirty::VertexBuffer0 + index] = true;
+        }
+    }
+}
+
+template <class P>
+void BufferCache<P>::ReleaseFinished() {
+    delayed_destruction_ring.Clear();
+}
