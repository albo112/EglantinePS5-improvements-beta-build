+    // A refused buffer's relief: here, nothing is being set up and nothing is locked.
+    if (const u64 refused = buffer_cache.RefusedBytes(); refused != 0) [[unlikely]] {
+        std::scoped_lock lock{buffer_cache.mutex, texture_cache.mutex};
+        texture_cache.CollectForBuffer(refused);
+        buffer_cache.CollectRefused();
+        ReleaseFinishedMemory();
+    }
