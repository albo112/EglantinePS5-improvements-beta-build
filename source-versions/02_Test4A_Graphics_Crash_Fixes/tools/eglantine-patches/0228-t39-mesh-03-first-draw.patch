--- /dev/null
+++ b/src/tests/video_core/mesh_compute_push.cpp
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// CMake target mesh_compute_push_test; CTest also validates each output when spirv-val
+// is installed. No GPU or native mesh extension is needed.
+#include <array>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <stdexcept>
+#include <string>
+
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/backend/spirv/emit_spirv_mesh_readback.h"
+#include "shader_recompiler/backend/spirv/mesh_compute_layout.h"
+#include "shader_recompiler/frontend/ir/basic_block.h"
+#include "shader_recompiler/frontend/ir/ir_emitter.h"
+
+using namespace Shader;
+
+int main() {
+    for (const Stage stage : {Stage::Task, Stage::Mesh}) {
+        for (const bool scaled : {false, true}) {
+            ObjectPool<IR::Inst> pool;
+            IR::Block block{pool};
+            IR::IREmitter ir{block};
+            ir.Prologue();
+            if (scaled) {
+                // Keep every push read live through a guest output, in both stages.
+                ir.IsbeWriteAttribute(ir.Imm32(0), ir.BitCast<IR::U32>(ir.ResolutionDownFactor()));
+                ir.IsbeWriteAttribute(ir.Imm32(4),
+                    IR::U32{ir.Select(ir.IsTextureScaled(ir.Imm32(0)), ir.Imm32(1), ir.Imm32(0))});
+                ir.IsbeWriteAttribute(ir.Imm32(8),
+                    IR::U32{ir.Select(ir.IsImageScaled(ir.Imm32(0)), ir.Imm32(1), ir.Imm32(0))});
+                ir.IsbeWriteAttribute(ir.Imm32(12), ir.BitCast<IR::U32>(ir.RenderAreaWidth()));
+            }
+            ir.Epilogue();
+            IR::Program program;
+            program.stage = stage;
+            program.workgroup_size = {32, 1, 1};
+            program.blocks = {&block};
+            program.post_order_blocks = {&block};
+            program.syntax_list = {{{.block = &block}, IR::AbstractSyntaxNode::Type::Block},
+                                   {{}, IR::AbstractSyntaxNode::Type::Return}};
+            program.info.uses_workgroup_id = true;
+            program.info.uses_local_invocation_id = true;
+            program.info.is_task = stage == Stage::Task;
+            program.info.is_mesh = stage == Stage::Mesh;
+            program.info.uses_rescaling_uniform = scaled;
+            program.info.uses_render_area = scaled;
+            program.mesh.payload_words = 32;
+            program.mesh.max_vertices = 3;
+            program.mesh.max_primitives = 1;
+            program.mesh.topology = 4;
+            program.mesh.vertex_lines = {
+                static_cast<u32>(IR::Attribute::PositionX),
+                static_cast<u32>(IR::Attribute::PositionY),
+                static_cast<u32>(IR::Attribute::PositionZ),
+                static_cast<u32>(IR::Attribute::PositionW),
+            };
+            Profile profile{};
+            profile.supported_spirv = 0x00010600;
+            profile.support_int64 = true;
+            profile.unified_descriptor_binding = true;
+            RuntimeInfo runtime{};
+            runtime.mesh_as_compute = true;
+            Backend::Bindings bindings{};
+            const auto code = Backend::SPIRV::EmitSPIRV(profile, runtime, program, bindings);
+            u32 push_variables{};
+            u32 push_struct{};
+            std::map<u32, u32> pointer_types;
+            std::map<std::pair<u32, u32>, u32> offsets;
+            for (size_t pos = 5; pos < code.size();) {
+                const u32 words = code[pos] >> 16;
+                if (words == 0 || pos + words > code.size()) {
+                    throw std::runtime_error("Malformed SPIR-V");
+                }
+                const u32 op = code[pos] & 0xffff;
+                if (op == 32 && words == 4 && code[pos + 2] == 9) {
+                    pointer_types[code[pos + 1]] = code[pos + 3]; // OpTypePointer
+                }
+                if (op == 72 && words == 5 && code[pos + 3] == 35) {
+                    offsets[{code[pos + 1], code[pos + 2]}] = code[pos + 4]; // Offset
+                }
+                if (op == 59 && words >= 4 && code[pos + 3] == 9) {
+                    ++push_variables; // OpVariable, PushConstant
+                    push_struct = pointer_types.at(code[pos + 1]);
+                }
+                pos += words;
+            }
+            if (push_variables != 1) {
+                throw std::runtime_error("Expected one shared push block");
+            }
+            constexpr std::array<u32, 9> expected_offsets{0, 16, 24, 32, 48, 52, 56, 60, 64};
+            for (u32 member = 0; member < expected_offsets.size(); ++member) {
+                if (offsets.at({push_struct, member}) != expected_offsets[member]) {
+                    throw std::runtime_error("Push block ABI changed");
+                }
+            }
+            const std::string name = std::string{stage == Stage::Task ? "task" : "mesh"} +
+                                     (scaled ? "_scaled.spv" : "_plain.spv");
+            std::ofstream file{name, std::ios::binary};
+            file.write(reinterpret_cast<const char*>(code.data()), code.size() * sizeof(u32));
+            if (!file) {
+                throw std::runtime_error("Cannot write SPIR-V");
+            }
+            std::printf("%s: one push block, ABI checked\n", name.c_str());
+            if (stage == Stage::Mesh && !scaled) {
+                const auto readback = Backend::SPIRV::EmitMeshReadbackVertex(profile, runtime,
+                                                                           program.mesh);
+                std::ofstream vertex{"mesh_readback.spv", std::ios::binary};
+                vertex.write(reinterpret_cast<const char*>(readback.data()),
+                             readback.size() * sizeof(u32));
+                if (!vertex) {
+                    throw std::runtime_error("Cannot write readback SPIR-V");
+                }
+            }
+        }
+    }
+}
