@@ -580,6 +580,7 @@ bool GraphicsPipeline::ConfigureImpl(bool is_indexed) {
         scheduler.RequestOutsideRenderPassOperationContext();
     }
 
+    u64 geometry_tick = scheduler.CurrentTick();
     {
         Profile::Scope scope{Profile::Zone::UpdateBuffers};
         buffer_cache.UpdateGraphicsBuffers(is_indexed);
@@ -643,6 +644,12 @@ bool GraphicsPipeline::ConfigureImpl(bool is_indexed) {
     if (IsBuilt() && !pipeline) {
         return false;
     }
+    // An upload that waited for the GPU may have ended the command buffer, and the index and
+    // vertex buffers bound above went with it. Descriptors are written after this.
+    while (scheduler.CurrentTick() != geometry_tick) {
+        geometry_tick = scheduler.CurrentTick();
+        buffer_cache.RebindHostGeometryBuffers(is_indexed);
+    }
     Profile::Scope scope{Profile::Zone::ConfigureDraw};
     return ConfigureDraw(rescaling, render_area);
 }
