+StagingBufferRef StagingBufferPool::WaitForStream(size_t size) {
+    if (const std::optional<StagingBufferRef> ref = TryRequest(size, MemoryUsage::Upload)) {
+        return *ref;
+    }
+    // The pool has nothing and the regions this request needs are with the GPU. Their memory has
+    // been there since the start, so waiting for them is an answer that needs none. An older tick
+    // costs only the wait; a tick still being recorded is submitted first, which ends the command
+    // buffer in the middle of a draw's setup (GraphicsPipeline::ConfigureImpl binds again).
+    const size_t region_begin = Region(free_iterator) + 1;
+    const size_t region_end = (std::min)(Region(iterator + size) + 1, NUM_SYNCS);
+    const size_t start_end = iterator + size >= stream_buffer_size ? Region(size) + 1 : 0;
+    const auto needed = [=](size_t region) {
+        return region < start_end || (region >= region_begin && region < region_end);
+    };
+    u64 tick = 0;
+    for (size_t region = 0; region < NUM_SYNCS; ++region) {
+        if (needed(region)) {
+            tick = (std::max)(tick, sync_ticks[region]);
+        }
+    }
+    static u64 times = 0;
+    if (++times; (times & (times - 1)) == 0) { // the 1st, 2nd, 4th, 8th ... time
+        LOG_WARNING(Render_Vulkan, "No staging buffer for an upload of {} bytes, {} times so far: "
+                                   "waited for the GPU and took the stream ring",
+                    size, times);
+    }
+    const u64 old_tick = scheduler.CurrentTick();
+    scheduler.Wait(tick);
+    if (const u64 new_tick = scheduler.CurrentTick(); new_tick != old_tick) {
+        // The draw being set up is now recorded in the new tick, and it reads what it got in the
+        // old one: its uniforms, in the ring or in a kept buffer. Those stay busy for one tick more.
+        // Copies already recorded in the old tick look busy a little longer, which does no harm.
+        // The regions this request needs keep their stamp, they are what was waited for.
+        for (size_t region = 0; region < NUM_SYNCS; ++region) {
+            if (sync_ticks[region] == old_tick && !needed(region)) {
+                sync_ticks[region] = new_tick;
+            }
+        }
+        for (StagingBuffers& level : upload_cache) {
+            for (StagingBuffer& entry : level.entries) {
+                if (entry.tick == old_tick) {
+                    entry.tick = new_tick;
+                }
+            }
+        }
+    }
+    return GetStreamBuffer(size, false);
+}
