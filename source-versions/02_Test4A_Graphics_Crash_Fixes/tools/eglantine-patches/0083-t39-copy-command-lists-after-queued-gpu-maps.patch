Subject: [PATCH] Migrate 0025-copy-command-lists-after-queued-gpu-maps.patch

Source: 0025-copy-command-lists-after-queued-gpu-maps.patch
Build gate: EDEN_MIGRATE_020=1 (default off). Original runtime gates retained.
Assisted-by: OpenAI Codex (offline migration).

diff --git a/src/core/hle/service/nvdrv/devices/nvhost_gpu.cpp b/src/core/hle/service/nvdrv/devices/nvhost_gpu.cpp
index 433fff4151b93b507159a5f43da275e16f705144..5dd830eb23bb4376f747658241cc6b4bfa250fd4 100644
--- a/src/core/hle/service/nvdrv/devices/nvhost_gpu.cpp
+++ b/src/core/hle/service/nvdrv/devices/nvhost_gpu.cpp
@@ -470,8 +470,15 @@ NvResult nvhost_gpu::SubmitGPFIFOImpl(IoctlSubmitGpfifo& params, Tegra::CommandL
                 // copies it after the map instead.
                 const u64 bytes = static_cast<u64>(entry.size) * sizeof(u32);
                 if (system.GPU().IsMapPending(entry.addr, bytes)) {
-                    entries.submitted_offsets.push_back(static_cast<u32>(offset));
+                    static std::atomic<u32> deferred_reported{0};
+                    if (deferred_reported.fetch_add(1, std::memory_order_relaxed) < 16) {
+                        LOG_INFO(Service_NVDRV,
+                                 "Command list at {:#x} ({} words) lies on a GPU map still queued: "
+                                 "copied after the map",
+                                 static_cast<u64>(entry.addr), static_cast<u32>(entry.size));
+                    }
                     entries.deferred_entries.push_back(i);
+                    entries.submitted_offsets.push_back(static_cast<u32>(offset));
                     offset += entry.size;
                     continue;
                 }
