+// EDEN_NX2_LIST_CPU_SYNC=1: a CPU write to a command list page the GPU also wrote counts at once.
+// Otherwise it is collected until the next fence, and until then the split's front runs the host
+// copy of the page's old lists, a whole earlier frame. The flush of such a page applies the
+// collected writes first, or the download would put the old lists back over them.
+// From sylvieistaken/selevet-eglantine a3644b1b3e (Performance build 7). On by default there.
+[[nodiscard]] inline bool Nx2ListCpuSync() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_LIST_CPU_SYNC");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
