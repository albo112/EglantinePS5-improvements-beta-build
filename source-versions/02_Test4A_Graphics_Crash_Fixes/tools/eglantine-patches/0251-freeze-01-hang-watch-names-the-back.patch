diff --git a/src/common/hang_site.h b/src/common/hang_site.h
new file mode 100644
index 0000000..ba1150b
--- /dev/null
+++ b/src/common/hang_site.h
@@ -0,0 +1,97 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdlib>
+#include <thread>
+
+namespace Common {
+
+/// The threads whose place the hang watch reports.
+enum class HangThread : std::size_t { Back, Worker, Present, Fence, Count };
+
+/// EDEN_NX2_HANG_WATCH=1. A function-local static: env.txt is read in main, after the globals.
+[[nodiscard]] inline bool HangWatchOn() {
+    static const bool on = [] {
+        const char* const value = std::getenv("EDEN_NX2_HANG_WATCH");
+        return value != nullptr && value[0] != '0';
+    }();
+    return on;
+}
+
+/// Where each watched thread is now: a string literal, or null when it is at no marked place.
+inline std::array<std::atomic<const char*>, static_cast<std::size_t>(HangThread::Count)>
+    hang_sites{};
+/// Who each watched thread is, to name a lock's holder.
+inline std::array<std::atomic<std::thread::id>, static_cast<std::size_t>(HangThread::Count)>
+    hang_ids{};
+/// The calling thread's entry in hang_sites; null on every other thread and with the switch off.
+inline thread_local std::atomic<const char*>* hang_slot{};
+
+/// Called by a watched thread as it starts.
+inline void HangThreadStarts(HangThread thread) {
+    if (HangWatchOn()) {
+        const auto index = static_cast<std::size_t>(thread);
+        hang_ids[index].store(std::this_thread::get_id(), std::memory_order_relaxed);
+        hang_slot = &hang_sites[index];
+    }
+}
+
+[[nodiscard]] inline const char* HangSiteOf(HangThread thread) {
+    const char* const site =
+        hang_sites[static_cast<std::size_t>(thread)].load(std::memory_order_relaxed);
+    return site != nullptr ? site : "none";
+}
+
+/// A lock's holder by name, for a report written on the split's front. "another thread" is one the
+/// watch doesn't follow, such as a CPU write trap.
+[[nodiscard]] inline const char* HangHolderName(std::thread::id holder) {
+    static constexpr std::array<const char*, static_cast<std::size_t>(HangThread::Count)> names{
+        "the back", "the worker", "the present thread", "the fencing thread"};
+    if (holder == std::thread::id{}) {
+        return "nobody";
+    }
+    if (holder == std::this_thread::get_id()) {
+        return "the front";
+    }
+    for (std::size_t index = 0; index < names.size(); ++index) {
+        if (hang_ids[index].load(std::memory_order_relaxed) == holder) {
+            return names[index];
+        }
+    }
+    return "another thread";
+}
+
+/// Marks a place a watched thread can wait at for as long as it lives, and restores the mark it
+/// found. Takes string literals only: the front reads them while the thread is stuck.
+class HangSite {
+public:
+    explicit HangSite(const char* name) noexcept : slot{hang_slot} {
+        if (slot != nullptr) {
+            previous = slot->exchange(name, std::memory_order_relaxed);
+        }
+    }
+    ~HangSite() {
+        if (slot != nullptr) {
+            slot->store(previous, std::memory_order_relaxed);
+        }
+    }
+    HangSite(const HangSite&) = delete;
+    HangSite& operator=(const HangSite&) = delete;
+
+    void Set(const char* name) noexcept {
+        if (slot != nullptr) {
+            slot->store(name, std::memory_order_relaxed);
+        }
+    }
+
+private:
+    std::atomic<const char*>* const slot;
+    const char* previous{};
+};
+
+} // namespace Common
