+void GpuSplit::ReportBack() {
+    if (!Common::HangWatchOn() || hang_reports >= 64) {
+        return;
+    }
+    ++hang_reports;
+    static constexpr std::array<const char*, 5> kinds{"wrap", "engine", "method", "multi", "call"};
+    // As Tegra::Engines::EngineTypes.
+    static constexpr std::array<const char*, 6> engines{"timer", "compute", "3D",
+                                                        "2D",    "DMA",     "memory"};
+    const u64 position = back_entry_position.load(std::memory_order_relaxed);
+    const u64 head = back_entry_head.load(std::memory_order_relaxed);
+    const u64 kind = head & 0xf;
+    const auto* const engine = back_engine_now.load(std::memory_order_relaxed);
+    const size_t type =
+        engine != nullptr ? static_cast<size_t>(engine->hang_engine_type) : engines.size();
+    // A call entry has no method: its thunk says what the front deferred (address - 0x400000 is
+    // eboot+offset).
+    LOG_WARNING(HW_GPU,
+                "Hang watch: the back runs word {} of {}: {} entry, {} engine, method {:#x}, "
+                "value {:#x}, last thunk {:#x}, at: {}",
+                position, write_position, kind < kinds.size() ? kinds[kind] : "unknown",
+                type < engines.size() ? engines[type] : "no", (head >> 8) & 0xffff, head >> 32,
+                back_entry_call.load(std::memory_order_relaxed),
+                Common::HangSiteOf(Common::HangThread::Back));
+    // Once per place: the entry and what is queued behind it. The front is the ring's only writer,
+    // and it is here.
+    if (position != hang_dumped_position) {
+        hang_dumped_position = position;
+        const u64 end = (std::min)(write_position, position + 128);
+        for (u64 at = position; at < end; at += 8) {
+            std::string line;
+            for (u64 word = at; word < (std::min)(end, at + 8); ++word) {
+                line += fmt::format(" {:016x}", ring[word & RingMask]);
+            }
+            LOG_WARNING(HW_GPU, "Hang watch: ring at {}:{}", at, line);
+        }
+    }
+    if (hang_report != nullptr) {
+        hang_report(hang_argument);
+    }
+}
