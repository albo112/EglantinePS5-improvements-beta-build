+/// For the watchdog: each GPU thread that has not gone round its loop for 5 s or more, and the
+/// zone it is in ("idle" or "split wait": waiting for work). Empty while the profile is off.
+inline std::string StoppedPlaces() {
+    std::string text;
+    const u64 now = Now();
+    const u32 count = (std::min)(g_place_count.load(std::memory_order_relaxed),
+                                 static_cast<u32>(g_places.size()));
+    for (u32 i = 0; i < count; ++i) {
+        const ThreadPlace& place = g_places[i];
+        const u64 beat = place.beat.load(std::memory_order_relaxed);
+        const char* const name = place.name.load(std::memory_order_relaxed);
+        if (beat == 0 || name == nullptr || now < beat + 5'000'000'000ULL) {
+            continue;
+        }
+        const u32 zone = place.zone.load(std::memory_order_relaxed);
+        text += fmt::format(" | {}: {} s, in zone \"{}\"", name, (now - beat) / 1'000'000'000ULL,
+                            zone == 0 || zone > zone_names.size() ? "none" : zone_names[zone - 1]);
+    }
+    return text;
+}
