     const u64 ticks = m_parent.m_system.CoreTiming().GetClockTicks();
     // Guest code that waits by polling the counter (title 1's main thread reads it ~17 million
@@ -176,11 +188,7 @@ u64 DynarmicCallbacks64::GetCNTPCT() {
     // GPU thread is often on the other half of that SMT core. Two reads within ~1.7 us of each
     // other are such a loop: pause, which hands the core's resources to the sibling thread for a
     // moment. The guest sees the same counter. EDEN_NX2_CNTPCT_PAUSE=0 turns it off.
-    static const bool pause_spins = [] {
-        const char* value = std::getenv("EDEN_NX2_CNTPCT_PAUSE");
-        return value == nullptr || value[0] != '0';
-    }();
-    if (pause_spins && ticks - m_last_cntpct < m_spin_ticks) {
+    if (ShouldPauseCntpctSpins() && ticks - m_last_cntpct < m_spin_ticks) {
 #if defined(_M_X64) || defined(__x86_64__)
         _mm_pause();
         _mm_pause();
@@ -279,6 +287,23 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
     // Timing
     config.wall_clock_cntpct = m_uses_wall_clock;
     config.enable_cycle_counting = !m_uses_wall_clock;
+    // EDEN_NX2_INLINE_CNTPCT=1: guest counter reads stay in generated code (a read costs one
+    // RDTSC instead of a call, two LFENCEs and the spills around them). Only where CoreTiming's
+    // GetClockTicks is that one multiply: a wall clock on a host counter with one rate, and no
+    // scaling for a CPU clock setting or for the emulated speed. Lichii PR 161, commit d51b04d80a
+    // (there on by default; here off until the console has run it).
+    if (m_uses_wall_clock && Settings::values.cpu_clock.GetValue() == Settings::CpuClock::Normal &&
+        !Settings::values.sync_core_speed.GetValue()) {
+        static const bool inline_cntpct = [] {
+            const char* value = std::getenv("EDEN_NX2_INLINE_CNTPCT");
+            return value != nullptr && value[0] == '1';
+        }();
+        if (inline_cntpct) {
+            config.inline_cntpct_factor = Common::g_wall_clock.GuestCNTPCTFactor();
+            config.inline_cntpct_spin_ticks =
+                ShouldPauseCntpctSpins() ? static_cast<std::uint32_t>(m_cb->m_spin_ticks) : 0;
+        }
+    }
 
     // Code cache size
 #if defined(ARCHITECTURE_arm64) || defined(__sun__) || defined(__NetBSD__) || defined(__DragonFly__) || defined(__OpenBSD__)
diff --git a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp
index 40610d7094..699b333d30 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64.cpp
@@ -577,6 +577,34 @@ void A64EmitX64::EmitA64GetCNTFRQ(A64EmitContext& ctx, IR::Inst* inst) {
 }
 
 void A64EmitX64::EmitA64GetCNTPCT(A64EmitContext& ctx, IR::Inst* inst) {
+    // Lichii PR 161 (zortos293/Lichii, commit d51b04d80a), GPL-3.0-or-later: the counter without
+    // leaving generated code. No HostCall: nothing is spilled, and the guest's read costs one
+    // RDTSC and one multiply. Like WallClock::GetCNTPCT, minus its two LFENCEs.
+    if (conf.wall_clock_cntpct && conf.inline_cntpct_factor != 0) {
+        const Xbyak::Reg64 low = ctx.reg_alloc.ScratchGpr(code, HostLoc::RAX);
+        const Xbyak::Reg64 result = ctx.reg_alloc.ScratchGpr(code, HostLoc::RDX);
+        const Xbyak::Reg64 factor = ctx.reg_alloc.ScratchGpr(code);
+        code.rdtsc();
+        code.shl(result, 32);
+        code.or_(low, result);
+        code.mov(factor, conf.inline_cntpct_factor);
+        code.mul(factor); // rdx = the high half of tsc * factor: MultiplyHigh
+        if (conf.inline_cntpct_spin_ticks != 0) {
+            // DynarmicCallbacks64::GetCNTPCT's polling test, on this core's own last read.
+            Xbyak::Label no_pause;
+            const auto last = qword[code.ABI_JIT_PTR + offsetof(A64JitState, cntpct_last)];
+            code.mov(low, result);
+            code.sub(low, last);
+            code.mov(last, result);
+            code.cmp(low, conf.inline_cntpct_spin_ticks);
+            code.jae(no_pause);
+            code.pause();
+            code.pause();
+            code.L(no_pause);
+        }
+        ctx.reg_alloc.DefineValue(code, inst, result);
+        return;
+    }
     ctx.reg_alloc.HostCall(code, inst);
     if (!conf.wall_clock_cntpct) {
         code.UpdateTicks();
