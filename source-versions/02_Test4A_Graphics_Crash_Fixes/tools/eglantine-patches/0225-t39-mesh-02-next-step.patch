 bool GraphicsPipeline::ConfigureImpl(bool is_indexed) {
+    if (RunsMeshAsCompute()) {
+        // The compute path reads pipeline handles on this thread, before scheduler.Record.
+        std::unique_lock lock{build_mutex};
+        build_condvar.wait(lock, [this] { return is_built.load(std::memory_order_relaxed); });
+    }
     boost::container::small_vector<VideoCommon::ImageViewInOut, 160> views;
     boost::container::small_vector<VideoCommon::SamplerId, 96> samplers;
     views.reserve(num_image_elements);
@@ -1310,8 +1315,7 @@ void GraphicsPipeline::MakeMeshComputePipelines() {
         };
         return device.GetLogical().CreateComputePipeline(compute_ci, *pipeline_cache);
     };
-    // The mesh pipeline last: this runs on a worker, RecordMeshComputePasses does not wait for it,
-    // and it takes a set mesh_pipeline to mean the draw's other pipelines are there too.
+    // The mesh pipeline last: a failed task or scan build leaves it empty.
     if (mesh_compute->task) {
         task_pipeline = make(mesh_compute->task, true);
         scan_pipeline = make(mesh_compute->scan, false);
