+// EDEN_NX2_AMD_SHADER_FIXES=1 (mja00/Lichii 5e8d409f81): offsets are relative to a binding base
+// aligned only to the device's storage buffer alignment (4 bytes on RADV), so the vector view
+// (offset >> 3 or 4) is right only for offsets known to be multiples of the access size; otherwise
+// it reads the vector before (Ocarina's lighting). Off, the view is taken as before.
+static bool VectorViewIsExact(EmitContext& ctx, const IR::Value& offset, u32 size) {
+    if (!ctx.profile.support_descriptor_aliasing) {
+        return false;
+    }
+    if (!AmdShaderFixes()) {
+        return true;
+    }
+    if (offset.IsImmediate()) {
+        return offset.U32() % size == 0;
+    }
+    return ctx.profile.min_ssbo_alignment >= size;
+}
