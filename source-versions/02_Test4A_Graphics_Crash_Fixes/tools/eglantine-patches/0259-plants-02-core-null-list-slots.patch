+    /// EDEN_NX2_NULL_SLOTS: what a compute program's translation left unbound because it was null.
+    struct NullPointerSlots {
+        std::vector<std::pair<u32, u32>> slots;
+        std::set<std::pair<u32, u32>> told;
+        u32 rebuilds{};
