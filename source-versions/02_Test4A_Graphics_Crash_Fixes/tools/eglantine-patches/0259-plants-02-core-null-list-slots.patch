     return false;
 }
 
+// EDEN_NX2_NULL_SLOTS (Lichii PR 395, atk3001): a native program's pointer slot that held null at
+// translation gets no binding, its accesses through it are lost, and the disk cache keeps that
+// answer for good. =1 logs a compute program's slot that holds a pointer now, once per program and
+// slot. =2 also rebuilds the program from the live state, at most 4 times a run. A rebuild is not
+// written to the disk cache: the first entry of a key wins on load, so it would never be read.
+u32 NullSlotsMode() {
+    static const u32 mode = [] {
+        const char* value = std::getenv("EDEN_NX2_NULL_SLOTS");
+        return value != nullptr ? static_cast<u32>(std::strtoul(value, nullptr, 10)) : 0U;
+    }();
+    return mode;
+}
+
 // EDEN_NX2_PRELOAD_ALL_PIPELINES=1 builds every cached pipeline at boot, as before.
 bool PreloadAllPipelines() {
     static const bool all = [] {
@@ -1134,6 +1147,9 @@ ComputePipeline* PipelineCache::CurrentComputePipeline() {
     };
     const auto [pair, is_new]{compute_cache.try_emplace(key)};
     auto& pipeline{pair->second};
+    if (!is_new && NullSlotsMode() != 0 && pipeline) {
+        RecheckNullPointerSlots(key, shader, pipeline);
+    }
     if (!is_new) {
         return pipeline.get();
     }
@@ -1141,6 +1157,70 @@ ComputePipeline* PipelineCache::CurrentComputePipeline() {
     return pipeline.get();
 }
 
+void PipelineCache::RecheckNullPointerSlots(const ComputePipelineCacheKey& key,
+                                            const ShaderInfo* shader,
+                                            std::unique_ptr<ComputePipeline>& pipeline) {
+    constexpr u32 MaxRebuilds = 4;
+    const auto& qmd{kepler_compute->launch_description};
+    {
+        std::scoped_lock lock{compute_null_slots_mutex};
+        const auto it = compute_null_slots.find(key);
+        if (it == compute_null_slots.end() || it->second.slots.empty()) {
+            return;
+        }
+        NullPointerSlots& entry = it->second;
+        bool stale{};
+        for (const auto& [index, offset] : entry.slots) {
+            if (index >= qmd.const_buffer_config.size() ||
+                ((qmd.const_buffer_enable_mask.Value() >> index) & 1) == 0) {
+                continue;
+            }
+            const auto& cbuf{qmd.const_buffer_config[index]};
+            if (offset + sizeof(u64) > cbuf.size) {
+                continue; // The translator reads past the bound size as zero, too
+            }
+            const GPUVAddr slot{cbuf.Address() + offset};
+            if (!gpu_memory->IsFullyMappedRange(slot, sizeof(u64))) {
+                continue;
+            }
+            const GPUVAddr address{gpu_memory->Read<u64>(slot)};
+            if (address == 0 || !gpu_memory->IsWithinGPUAddressRange(address) ||
+                !gpu_memory->IsFullyMappedRange(address, 1)) {
+                continue;
+            }
+            stale = true;
+            if (entry.told.emplace(index, offset).second) {
+                LOG_INFO(Render_Vulkan,
+                         "Compute program {:016x}: c{}[{:#x}] was null at translation and now "
+                         "points to {:#x}",
+                         key.unique_hash, index, offset, address);
+            }
+        }
+        if (!stale || NullSlotsMode() < 2 || entry.rebuilds >= MaxRebuilds) {
+            return;
+        }
+        ++entry.rebuilds;
+    }
+    const GPUVAddr program_base{kepler_compute->regs.code_loc.Address()};
+    ComputeEnvironment env{*kepler_compute, *gpu_memory, program_base, qmd.program_start,
+                           shader->lowered_native};
+    env.SetCachedSize(shader->size_bytes);
+    ShaderPools& pools{main_pools};
+    pools.ReleaseContents();
+    auto rebuilt{CreateComputePipeline(pools, key, env, nullptr, true)};
+    if (!rebuilt) {
+        LOG_WARNING(Render_Vulkan, "Compute program {:016x}: rebuild failed, keeping the old one",
+                    key.unique_hash);
+        std::scoped_lock lock{compute_null_slots_mutex};
+        compute_null_slots[key].rebuilds = MaxRebuilds;
+        return;
+    }
+    LOG_INFO(Render_Vulkan, "Compute program {:016x} rebuilt from the live constant buffers",
+             key.unique_hash);
+    retired_compute_pipelines.push_back(std::move(pipeline));
+    pipeline = std::move(rebuilt);
+}
+
 void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading,
                                       const VideoCore::DiskResourceLoadCallback& callback) {
     visual_workaround_title = title_id;
@@ -1949,6 +2029,10 @@ std::unique_ptr<ComputePipeline> PipelineCache::CreateComputePipeline(
         const auto name{fmt::format("Shader {:016x}", key.unique_hash)};
         spv_module.SetObjectNameEXT(name.c_str());
     }
+    if (NullSlotsMode() != 0 && env.IsNativeProgram()) {
+        std::scoped_lock lock{compute_null_slots_mutex};
+        compute_null_slots[key].slots = env.NullStoragePointerSlots();
+    }
     Common::ThreadWorker* const thread_worker{build_in_parallel ? &workers : nullptr};
     return std::make_unique<ComputePipeline>(device, scheduler, vulkan_pipeline_cache, descriptor_pool,
                                              guest_descriptor_queue, descriptor_buffer_ring,
