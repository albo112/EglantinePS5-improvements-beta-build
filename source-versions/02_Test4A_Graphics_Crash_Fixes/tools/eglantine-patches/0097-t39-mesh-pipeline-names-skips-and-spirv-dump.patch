+namespace {
+// A task/mesh pipeline's name across runs: its task (or lone mesh) program and its mesh program
+// (shader hashes of their code and the mesh registers, the names of their EDEN_NX2_MESH_SPIRV_DUMP
+// files). The first draw with each is logged with its workgroup count. To find a pipeline that
+// hangs the GPU, skip some and keep the rest:
+// - EDEN_NX2_MESH_SKIP=<id>[,<id>...]: these pipelines (hex, as logged);
+// - EDEN_NX2_MESH_SKIP_BITS=<n>:<v>: those whose id's low n bits are v (n = 1: half of them,
+//   v = 0 or 1; n = 2: a quarter; ...), without knowing the ids beforehand;
+// - EDEN_NX2_MESH_ONLY=<id>[,<id>...]: all but these.
+u64 MeshPipelineId(const GraphicsPipelineCacheKey& key) {
+    return (key.unique_hashes[1] * 0x9e3779b97f4a7c15ULL) ^ key.unique_hashes[3];
+}
+
+std::vector<u64> ParseMeshIds(const char* text) {
+    std::vector<u64> ids;
+    for (const char* cursor = text; cursor != nullptr && *cursor != '\0';) {
+        char* end = nullptr;
+        const u64 id = std::strtoull(cursor, &end, 16);
+        if (end == cursor) {
+            break;
+        }
+        ids.push_back(id);
+        cursor = *end == ',' ? end + 1 : end;
+    }
+    return ids;
+}
+
+bool MeshPipelineSkipped(const GraphicsPipeline& pipeline,
+                         const Tegra::Engines::Maxwell3D::DrawManager::State& draw_state) {
+    static const std::vector<u64> skip = ParseMeshIds(std::getenv("EDEN_NX2_MESH_SKIP"));
+    static const std::vector<u64> only = ParseMeshIds(std::getenv("EDEN_NX2_MESH_ONLY"));
+    static const std::pair<u32, u64> bits = [] {
+        const char* value = std::getenv("EDEN_NX2_MESH_SKIP_BITS");
+        if (value == nullptr) {
+            return std::pair<u32, u64>{0, 0};
+        }
+        char* end = nullptr;
+        const u32 count = static_cast<u32>(std::strtoul(value, &end, 10));
+        const u64 match = *end == ':' ? std::strtoull(end + 1, nullptr, 10) : 0;
+        return std::pair<u32, u64>{(std::min)(count, 63U), match};
+    }();
+    const auto& key = pipeline.Key();
+    const u64 id = MeshPipelineId(key);
+    bool skipped = std::ranges::find(skip, id) != skip.end() ||
+                   (!only.empty() && std::ranges::find(only, id) == only.end());
+    if (bits.first != 0) {
+        const u64 mask = (u64{1} << bits.first) - 1;
+        skipped |= (id & mask) == (bits.second & mask);
+    }
+    static std::mutex seen_mutex;
+    static std::set<u64> seen;
+    std::scoped_lock lock{seen_mutex};
+    if (seen.size() < 512 && seen.insert(id).second) {
+        LOG_INFO(Render_Vulkan,
+                 "Mesh pipeline {:016x} first draw (#{}): task/mesh {:016x}, mesh {:016x}, {} "
+                 "workgroups{}",
+                 id, seen.size(), key.unique_hashes[1], key.unique_hashes[3],
+                 draw_state.vertex_buffer.count, skipped ? ", skipped" : "");
+    }
+    return skipped;
+}
+} // Anonymous namespace
+
