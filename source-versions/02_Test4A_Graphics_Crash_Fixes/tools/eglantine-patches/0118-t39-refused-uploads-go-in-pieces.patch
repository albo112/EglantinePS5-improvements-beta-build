+// A staging buffer for an upload, or nothing when the pool has none: the caller goes on without it
+// or tries again next frame. A refusal here used to end the session.
+template <typename Runtime>
+[[nodiscard]] auto TryUploadStaging(Runtime& runtime, size_t size, bool deferred = false) {
+    if constexpr (requires { runtime.TryUploadStagingBuffer(size, deferred); }) {
+        return runtime.TryUploadStagingBuffer(size, deferred);
+    } else {
+        return std::optional{runtime.UploadStagingBuffer(size, deferred)};
+    }
+}
+
+// The same for an upload that has to go now: up to a stream region the pool waits for the GPU and
+// always gives one, so only a larger request can come back empty.
+template <typename Runtime>
+[[nodiscard]] auto UploadStagingNow(Runtime& runtime, size_t size) {
+    if constexpr (requires { runtime.UploadSliceBytes(); }) {
+        if (size > runtime.UploadSliceBytes()) {
+            return runtime.TryUploadStagingBuffer(size);
+        }
+    }
+    return std::optional{runtime.UploadStagingBuffer(size)};
+}
