+template <class P>
+void BufferCache<P>::UploadInPieces([[maybe_unused]] Buffer& buffer,
+                                    [[maybe_unused]] std::span<const BufferCopy> copies) {
+    if constexpr (requires { runtime.UploadSliceBytes(); }) {
+        const u64 piece_size = runtime.UploadSliceBytes();
+        for (const BufferCopy& copy : copies) {
+            const DAddr device_addr = buffer.CpuAddr() + copy.dst_offset;
+            for (u64 done = 0; done < copy.size;) {
+                const u64 size = (std::min)(copy.size - done, piece_size);
+                auto upload_staging = runtime.UploadStagingBuffer(size);
+                device_memory.ReadBlockUnsafe(device_addr + done, upload_staging.mapped_span.data(),
+                                              size);
+                const std::array part{BufferCopy{
+                    .src_offset = upload_staging.offset,
+                    .dst_offset = copy.dst_offset + done,
+                    .size = size,
+                }};
+                const bool can_reorder = runtime.CanReorderUpload(buffer, part);
+                runtime.CopyBuffer(buffer, upload_staging.buffer, part, true, can_reorder);
+                done += size;
+            }
+            if (copy.size >= 256_KiB) {
+                uploaded_buffer_ranges.emplace_back(device_addr, copy.size);
+            }
+        }
+    }
+}
