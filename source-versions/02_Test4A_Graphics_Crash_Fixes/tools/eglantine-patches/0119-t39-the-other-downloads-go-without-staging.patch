+// A staging buffer for a download, or nothing when the pool has none.
+template <typename Runtime>
+[[nodiscard]] auto TryDownloadStaging(Runtime& runtime, size_t size, bool deferred) {
+    if constexpr (requires { runtime.TryDownloadStagingBuffer(size, deferred); }) {
+        return runtime.TryDownloadStagingBuffer(size, deferred);
+    } else {
+        return std::optional{runtime.DownloadStagingBuffer(size, deferred)};
+    }
+}
