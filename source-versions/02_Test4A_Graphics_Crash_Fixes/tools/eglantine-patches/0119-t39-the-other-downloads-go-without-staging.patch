+template <class P>
+void TextureCache<P>::FlushOnNextRead(ImageBase& image) {
+    using namespace std::chrono_literals;
+    // An image downloaded at fences has forced_flushed set, and a read of it goes by without a
+    // flush (GetFlushArea makes the area preemtive, OnCPURead returns on that). With no download
+    // nothing would bring the bytes until a later fence gets a buffer. Three things stand in the
+    // way of the read: the flag, a page without its GPU written mark on a Switch 2 title with no
+    // fastmem arena (HandleRasterizerDownload reads those directly, and only the buffer cache
+    // marks pages), and the area a core kept from an earlier read, which holds until the read trap
+    // generation moves. Every read after that asks the GPU thread, so the generation moves at most
+    // as often as the pool looks for new memory: a read of a large image that is refused again
+    // must not cost a round trip per word.
+    image.info.forced_flushed = false;
+    if (Tegra::g_nx2_ampere.load(std::memory_order_relaxed)) {
+        Tegra::Nx2MarkGpuWritten(image.cpu_addr, image.guest_size_bytes);
+    }
+    if (const auto now = std::chrono::steady_clock::now(); now - read_areas_ended >= 250ms) {
+        read_areas_ended = now;
+        device_memory.ArmReadTraps(image.cpu_addr, image.guest_size_bytes);
+    }
+}
