 #include "core/hle/service/ipc_helpers.h"
 #include "core/memory.h"
 
+// PS5 port: cold guest memory can have no mapping (src/guest_memory_service.inc). A processor's touch
+// of it faults and brings it back, but a system call given a pointer into it only fails with EFAULT,
+// and what the guest sends to a file or a socket reaches one from here as a span of its own memory.
+// While that can happen the span is copied, and the copy's touch is an ordinary fault.
+extern "C" bool eden_guest_swap_active(void) noexcept __attribute__((weak));
+
 namespace Service {
 
+namespace {
+std::span<const u8> CopiedIfSwapping(std::span<const u8> span, Common::ScratchBuffer<u8>& backup) {
+    if (span.empty() || span.data() == backup.data() || !eden_guest_swap_active ||
+        !eden_guest_swap_active()) {
+        return span;
+    }
+    backup.resize_destructive(span.size());
+    std::memcpy(backup.data(), span.data(), span.size());
+    return std::span<const u8>(backup.data(), span.size());
+}
+} // namespace
+
 SessionRequestHandler::SessionRequestHandler(Kernel::KernelCore& kernel_, const char* service_name_)
     : kernel{kernel_} {}
 
