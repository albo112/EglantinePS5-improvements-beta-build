@@ -691,6 +696,53 @@ std::unordered_map<u64, u8> LoadUsedPipelines(const std::filesystem::path& path,
 // boot that ran out of memory never saved one and the next boot did the same.
 constexpr size_t MaxPipelinesWithoutUsedList = 3000;
 
+// EDEN_NX2_MESH_COMPUTE_ONLY=<hash>[,<hash>...]: with EDEN_NX2_MESH_AS_COMPUTE=1, only task/mesh
+// pipelines whose task (or lone mesh) program or mesh program has one of these shader hashes (hex,
+// the hashes of the "Mesh pipeline ... runs as compute"/"first draw" lines and of the
+// EDEN_NX2_MESH_SPIRV_DUMP files) run as compute. The others are not built and their draws stay
+// skipped, as without the switch, and each is logged once with its two hashes, so a value that
+// names no hash (EDEN_NX2_MESH_COMPUTE_ONLY=none) lists every task/mesh pipeline a scene uses while
+// running none: the first run on a console, before a hang needs someone at it.
+bool MeshComputeAllowed(const GraphicsPipelineCacheKey& key) {
+    static const std::optional<std::vector<u64>> only = [] {
+        const char* text = std::getenv("EDEN_NX2_MESH_COMPUTE_ONLY");
+        if (text == nullptr) {
+            return std::optional<std::vector<u64>>{};
+        }
+        std::vector<u64> hashes;
+        for (const char* cursor = text; *cursor != '\0';) {
+            char* end = nullptr;
+            const u64 hash = std::strtoull(cursor, &end, 16);
+            if (end == cursor) {
+                break;
+            }
+            hashes.push_back(hash);
+            cursor = *end == ',' ? end + 1 : end;
+        }
+        LOG_INFO(Render_Vulkan, "Mesh draws as compute: only {} listed program(s) run", hashes.size());
+        return std::optional{std::move(hashes)};
+    }();
+    if (!only) {
+        return true;
+    }
+    const u64 first = key.unique_hashes[1];
+    const u64 mesh = key.unique_hashes[3];
+    if (std::ranges::find(*only, first) != only->end() ||
+        (mesh != 0 && std::ranges::find(*only, mesh) != only->end())) {
+        return true;
+    }
+    static std::mutex seen_mutex;
+    static std::set<std::pair<u64, u64>> seen;
+    std::scoped_lock lock{seen_mutex};
+    if (seen.size() < 256 && seen.emplace(first, mesh).second) {
+        LOG_INFO(Render_Vulkan,
+                 "Mesh pipeline not in EDEN_NX2_MESH_COMPUTE_ONLY, draws skipped: task/mesh {:016x}, "
+                 "mesh {:016x}",
+                 first, mesh);
+    }
+    return false;
+}
+
 // EDEN_NX2_PRELOAD_ALL_PIPELINES=1 builds every cached pipeline at boot, as before.
 bool PreloadAllPipelines() {
     static const bool all = [] {
@@ -1472,10 +1524,12 @@ std::unique_ptr<GraphicsPipeline> PipelineCache::CreateGraphicsPipeline(
         ++env_index;
 
         // Without VK_EXT_mesh_shader the driver cannot build a task/mesh pipeline; the draw is
-        // skipped (see the pipeline check in the rasterizer), unless the programs run as compute.
+        // skipped (see the pipeline check in the rasterizer), unless the programs run as compute
+        // and EDEN_NX2_MESH_COMPUTE_ONLY, if set, lists one of them.
         if ((env.ShaderStage() == Shader::Stage::Task ||
              env.ShaderStage() == Shader::Stage::Mesh) &&
-            !device.IsExtMeshShaderSupported() && !mesh_as_compute) {
+            !device.IsExtMeshShaderSupported() &&
+            (!mesh_as_compute || !MeshComputeAllowed(key))) {
             return nullptr;
         }
 
