+    // EDEN_NX2_SHADER_FAST_SCAN=1: blocks never overlap, so only the last one starting at or
+    // before pc can contain it. A function-local static: env.txt is read in main.
+    static const bool fast_scan = [] {
+        const char* const value = std::getenv("EDEN_NX2_SHADER_FAST_SCAN");
+        return value != nullptr && value[0] == '1';
+    }();
+    auto it{function.blocks.end()};
+    if (fast_scan) {
+        it = function.blocks.upper_bound(pc, Compare{});
+        if (it == function.blocks.begin() || !std::prev(it)->Contains(pc)) {
+            it = function.blocks.end();
+        } else {
+            --it;
+        }
+    } else {
+        it = std::ranges::find_if(function.blocks,
+                                  [pc](auto& block) { return block.Contains(pc); });
+    }
     if (it == function.blocks.end()) {
