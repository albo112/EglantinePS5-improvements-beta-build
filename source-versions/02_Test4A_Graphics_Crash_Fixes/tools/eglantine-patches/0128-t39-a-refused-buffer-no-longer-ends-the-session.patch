+template <class P>
+template <typename Unused>
+BufferId BufferCache<P>::CreateRefusedBuffer(DAddr device_addr, u32 wanted_size,
+                                             bool sparse_compatible) {
+    static const bool cut_buffers = [] {
+        const char* value = std::getenv("EDEN_NX2_BUFFER_CUT");
+        return value == nullptr || value[0] != '0';
+    }();
+    if (!cut_buffers) {
+        runtime.ThrowRefused();
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const bool first = now >= buffer_refused_until;
+    if (first) {
+        buffer_refused_until = now + std::chrono::milliseconds(250);
+        buffer_hole_refused = ~u64{0};
+    }
+    // A leap adds 8 MiB for a buffer that keeps growing. With nothing to spare it can do without.
+    if (const BufferId id = JoinBuffer(device_addr, wanted_size, sparse_compatible, false)) {
+        buffer_refused_size = ~u64{0};
+        return id;
+    }
+    if (first) {
+        std::fprintf(stderr,
+                     "EDEN_BUFFER_REFUSED %llu bytes at %llx (%u bytes wanted): since the last time "
+                     "%llu buffers held only the start of a range and %llu ranges went without\n",
+                     static_cast<unsigned long long>(buffer_refused_size),
+                     static_cast<unsigned long long>(device_addr), wanted_size,
+                     static_cast<unsigned long long>(buffers_cut),
+                     static_cast<unsigned long long>(buffers_dropped));
+        buffers_cut = buffers_dropped = 0;
+    }
+    // No join can be had, but what the range starts with can. The caller sees to the rest. Not for
+    // the inline index buffer, at 0, or a source of a multi range binding.
+    buffer_cut = true;
+    if (device_addr == 0 || sparse_compatible) {
+        ++buffers_dropped;
+        return NULL_BUFFER_ID;
+    }
+    const u64 page = device_addr >> CACHING_PAGEBITS;
+    if (const BufferId held = page_table[page]) {
+        ++buffers_cut;
+        return held;
+    }
+    // Free pages from the start, up to the next buffer: as much of them as fits a hole. The largest
+    // hole was 6 MiB when 10 MiB was refused (Ocarina, 2026-11-05), with 200 MiB in holes.
+    const u64 page_end =
+        (std::min<u64>)(page + (wanted_size >> CACHING_PAGEBITS), page_table.size());
+    u64 pages = 1;
+    while (page + pages < page_end && !page_table[page + pages]) {
+        ++pages;
+    }
+    for (; pages != 0; pages /= 2) {
+        const u64 bytes = pages << CACHING_PAGEBITS;
+        if (bytes >= buffer_hole_refused) {
+            continue;
+        }
+        std::optional<Buffer> made = runtime.TryCreateBufferInHoles(device_addr, bytes);
+        if (!made) {
+            buffer_hole_refused = bytes;
+            continue;
+        }
+        const BufferId id = slot_buffers.insert(std::move(*made));
+        Buffer& buffer = slot_buffers[id];
+        runtime.ClearBuffer(buffer, 0, bytes, 0);
+        buffer.MarkUsage(0, bytes);
+        Register(id);
+        TouchBuffer(buffer, id);
+        ++buffers_cut;
+        return id;
+    }
+    ++buffers_dropped;
+    return NULL_BUFFER_ID;
+}
