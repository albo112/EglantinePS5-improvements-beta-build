+template <class P>
+template <typename BindingType>
+void BufferCache<P>::FindBinding(BindingType& binding, bool whole) {
+    binding.buffer_id = FindBuffer(binding.device_addr, binding.size, false);
+    if (!buffer_cut) [[likely]] {
+        return;
+    }
+    buffer_cut = false;
+    bindings_cut = true;
+    const Buffer& buffer = slot_buffers[binding.buffer_id];
+    if (buffer.IsInBounds(binding.device_addr, binding.size)) {
+        return;
+    }
+    if (!whole && buffer.IsInBounds(binding.device_addr, 1)) {
+        binding.size = static_cast<u32>(buffer.CpuAddr() + buffer.SizeBytes() - binding.device_addr);
+        return;
+    }
+    // As an address with nothing mapped: reads give zero, writes are dropped.
+    static_cast<Binding&>(binding) = NULL_BINDING;
+    if constexpr (std::is_same_v<BindingType, TextureBufferBinding>) {
+        binding.format = PixelFormat::Invalid;
+    }
+}
