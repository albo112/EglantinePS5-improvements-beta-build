diff --git a/src/video_core/fence_manager.h b/src/video_core/fence_manager.h
index 068ecbfbfd..5c72c5ad75 100644
--- a/src/video_core/fence_manager.h
+++ b/src/video_core/fence_manager.h
@@ -136,6 +136,29 @@ public:
         SignalFence(std::move(func));
     }
 
+    /// Signals a fence and blocks until it has popped, with the operations queued before it
+    /// (the query writes among them), at any accuracy: WaitPendingFences returns at once when
+    /// fences aren't delayed, because SignalFence then runs its function immediately.
+    void SignalAndWait() {
+        std::mutex wait_mutex;
+        std::condition_variable wait_cv;
+        bool finished{};
+        SyncOperation([&] {
+            std::scoped_lock lk(wait_mutex);
+            finished = true;
+            wait_cv.notify_all();
+        });
+        SignalFence([] {});
+        rasterizer.FlushCommands();
+        // As in WaitPendingFences: the fencing thread needs what the split's back defers.
+        SubmitDeferred();
+        if constexpr (!can_async_check) {
+            TryReleasePendingFences<true>();
+        }
+        std::unique_lock lk(wait_mutex);
+        wait_cv.wait(lk, [&finished] { return finished; });
+    }
+
     void WaitPendingFences([[maybe_unused]] bool force) {
         if constexpr (!can_async_check) {
             TryReleasePendingFences<true>();
diff --git a/src/video_core/query_dma.h b/src/video_core/query_dma.h
new file mode 100644
index 0000000000..849a3c9050
--- /dev/null
+++ b/src/video_core/query_dma.h
@@ -0,0 +1,105 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdlib>
+
+#include <fmt/ranges.h>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "video_core/memory_manager.h"
+#include "video_core/rasterizer_interface.h"
+
+namespace VideoCommon::QueryDma {
+
+/// EDEN_NX2_QUERY_DMA_TRACE=1: logs MME DMA reads of reports whose host query results are not
+/// in guest memory yet. Below High GPU accuracy, counter reports are written when a later fence
+/// pops, so such a read returns an older count.
+inline bool TraceEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_QUERY_DMA_TRACE");
+        return value != nullptr && value[0] != '0';
+    }();
+    return enabled;
+}
+
+/// EDEN_NX2_QUERY_DMA_SYNC=1 (Lichii's experiment, branch test/all-in-one-flash): before such a
+/// read, wait for the host GPU and the fence that writes the results, as High accuracy does.
+inline bool SyncEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_QUERY_DMA_SYNC");
+        return value != nullptr && value[0] != '0';
+    }();
+    return enabled;
+}
+
+/// Whether [source, source + size) holds reports still waiting for host query results. Runs
+/// where the rasterizer's caches are owned (the back of a split GPU thread). A report that has
+/// landed counts too until it is unregistered: nothing sets IsGuestSynced here.
+inline bool HasPendingQueries(const Tegra::MemoryManager& memory,
+                              VideoCore::RasterizerInterface& rasterizer, GPUVAddr source,
+                              size_t size) {
+    constexpr GPUVAddr page_size = 0x1000;
+    const GPUVAddr end = source + size;
+    for (GPUVAddr begin = source; begin < end;) {
+        const GPUVAddr page_end = (std::min)((begin & ~(page_size - 1)) + page_size, end);
+        if (const auto device = memory.GpuToCpuAddress(begin);
+            device && rasterizer.HasPendingQueries(*device, page_end - begin)) {
+            return true;
+        }
+        begin = page_end;
+    }
+    return false;
+}
+
+/// Logs a read of pending reports with the words it reads, and the same words once the next
+/// fence has popped and the results have landed.
+inline void Trace(const Tegra::MemoryManager& memory, VideoCore::RasterizerInterface& rasterizer,
+                  u32 macro, u32 method, GPUVAddr source, size_t size) {
+    static constexpr u64 max_reads = 4000;
+    static std::atomic<u64> reads{};
+    const u64 read = reads.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (read > max_reads) {
+        if (read % 10000 == 0) {
+            LOG_INFO(HW_GPU, "Query DMA read of pending reports ({} so far)", read);
+        }
+        return;
+    }
+    std::array<u32, 4> words{};
+    const size_t bytes = (std::min)(size, sizeof(words));
+    memory.ReadBlockUnsafe(source, words.data(), bytes);
+    LOG_INFO(HW_GPU,
+             "Query DMA read #{} of pending reports: macro={:#x} method={:#x} gpu={:#x} "
+             "bytes={:#x} words={:08x}",
+             read, macro, method, source, size, fmt::join(words, ","));
+    rasterizer.SyncOperation([&memory, source, bytes, read] {
+        std::array<u32, 4> landed{};
+        memory.ReadBlockUnsafe(source, landed.data(), bytes);
+        LOG_INFO(HW_GPU, "Query DMA read #{} landed words={:08x}", read, fmt::join(landed, ","));
+    });
+}
+
+/// Traces and, with EDEN_NX2_QUERY_DMA_SYNC, waits for the pending reports a read covers.
+inline void BeforeRead(const Tegra::MemoryManager& memory,
+                       VideoCore::RasterizerInterface& rasterizer, u32 macro, u32 method,
+                       GPUVAddr source, size_t size) {
+    if (!TraceEnabled() && !SyncEnabled()) {
+        return;
+    }
+    if (!HasPendingQueries(memory, rasterizer, source, size)) {
+        return;
+    }
+    if (TraceEnabled()) {
+        Trace(memory, rasterizer, macro, method, source, size);
+    }
+    if (SyncEnabled()) {
+        rasterizer.WaitForQueries();
+    }
+}
+
+} // namespace VideoCommon::QueryDma
