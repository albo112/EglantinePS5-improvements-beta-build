@@ -76,6 +76,7 @@ struct AsyncDecodeContext {
     boost::container::small_vector<BufferImageCopy, 16> copies;
     std::mutex mutex;
     std::atomic_bool complete;
+    std::atomic_bool failed{}; ///< No memory for the decode: set before complete, nothing to upload.
     bool cancelled{}; ///< The image was deleted meanwhile: drop the result (GPU thread only).
     size_t next_copy{}; ///< A large image uploads over several frames: the next copy...
     s32 next_layer{};   ///< ...and the next layer of it (GPU thread only).
