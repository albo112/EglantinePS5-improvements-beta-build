From: EglantinePS5 <noreply@eglantineps5.local>
Subject: [PATCH] Migrate 0090-decoder-survives-a-refusal.patch

Source: 0090-decoder-survives-a-refusal.patch
Build gate: EDEN_MIGRATE_020=1 (default off). Original runtime gates retained.
Assisted-by: OpenAI Codex (offline migration).

diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index a6bb012f84f2da181b3f4c10eb2c338c58606bdb..c5dda1f729aff476166b903cfd0683dbbfe25288 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -13,6 +13,7 @@
 #include <cstdlib>
 #include <limits>
 #include <map>
+#include <new>
 #include <vector>
 #include <optional>
 #include <bit>
@@ -1764,7 +1765,21 @@ void TextureCache<P>::RefreshContents(Image& image, ImageId image_id) {
         return;
     }
     if (True(image.flags & ImageFlagBits::AsynchronousDecode)) {
-        QueueAsyncDecode(image, image_id);
+        try {
+            QueueAsyncDecode(image, image_id);
+        } catch (const std::bad_alloc&) {
+            // No memory for the compressed input, one piece of tens of MiB. The image stays as it
+            // is until the guest writes it again, and the session goes on.
+            LOG_ERROR(HW_GPU, "No memory to decode the image at {:#x}", image.gpu_addr);
+            if (!async_decodes.empty() && async_decodes.back()->image_id == image_id &&
+                !async_decodes.back()->complete) {
+                async_decodes.back()->failed = true;
+                async_decodes.back()->complete = true;
+            } else {
+                image.flags &= ~ImageFlagBits::IsDecoding;
+            }
+            runtime.TransitionImageLayout(image);
+        }
         return;
     }
 
@@ -2409,6 +2424,17 @@ void TextureCache<P>::ReportMemory() {
 constexpr size_t UPLOAD_SLICE_BYTES = size_t{8} << 20;
 constexpr size_t UPLOAD_FRAME_BYTES = size_t{32} << 20;
 
+// A staging buffer for an upload, or nothing when the pool has none: the caller goes on without it
+// or tries again next frame. A refusal here used to end the session.
+template <typename Runtime>
+[[nodiscard]] auto TryUploadStaging(Runtime& runtime, size_t size) {
+    if constexpr (requires { runtime.TryUploadStagingBuffer(size); }) {
+        return runtime.TryUploadStagingBuffer(size);
+    } else {
+        return std::optional{runtime.UploadStagingBuffer(size)};
+    }
+}
+
 // The next slice of `copies`: whole layers, at most `limit` bytes but at least one layer. The
 // layers of a copy sit back to back in its buffer range (ConvertedLayout gives its size).
 template <typename Copies>
@@ -2467,10 +2493,14 @@ void TextureCache<P>::QueueAsyncDecode(Image& image, ImageId image_id) {
         image.flags |= ImageFlagBits::ZeroFilled;
         auto zero_copies = copies;
         ConvertedLayout(image.info, zero_copies);
+        // With no staging buffer the image only goes without its clear until the decode lands.
         if (out_size <= UPLOAD_SLICE_BYTES) {
-            auto staging = runtime.UploadStagingBuffer(out_size);
-            std::memset(staging.mapped_span.data(), 0, out_size);
-            image.UploadMemory(staging, zero_copies);
+            if (auto staging = TryUploadStaging(runtime, out_size)) {
+                std::memset(staging->mapped_span.data(), 0, out_size);
+                image.UploadMemory(*staging, zero_copies);
+            } else {
+                runtime.TransitionImageLayout(image);
+            }
         } else {
             // Every slice reads the same zeros: one buffer the size of the largest slice.
             size_t zero_bytes = UPLOAD_SLICE_BYTES;
@@ -2481,16 +2511,18 @@ void TextureCache<P>::QueueAsyncDecode(Image& image, ImageId image_id) {
             // UploadMemory marks the image initialized at its first call, and each call's barrier
             // covers its slice: every later slice would claim GENERAL on layers still UNDEFINED.
             runtime.TransitionImageLayout(image);
-            auto staging = runtime.UploadStagingBuffer(zero_bytes);
-            std::memset(staging.mapped_span.data(), 0, zero_bytes);
+            auto staging = TryUploadStaging(runtime, zero_bytes);
+            if (staging) {
+                std::memset(staging->mapped_span.data(), 0, zero_bytes);
+            }
             size_t next_copy = 0;
             s32 next_layer = 0;
-            while (next_copy < zero_copies.size()) {
+            while (staging && next_copy < zero_copies.size()) {
                 auto slice = NextUploadSlice(zero_copies, next_copy, next_layer, zero_bytes);
                 for (BufferImageCopy& part : slice) {
                     part.buffer_offset = 0;
                 }
-                image.UploadMemory(staging, slice);
+                image.UploadMemory(*staging, slice);
             }
         }
         runtime.InsertUploadMemoryBarrier();
@@ -2499,9 +2531,14 @@ void TextureCache<P>::QueueAsyncDecode(Image& image, ImageId image_id) {
     auto func = [out_size, copies, info = image.info,
                  input = std::move(local_unswizzle_data_buffer),
                  async_decode = decode_ptr]() mutable {
-        async_decode->decoded_data.resize_destructive(out_size);
-        std::span copies_span{copies.data(), copies.size()};
-        ConvertImage(input, info, async_decode->decoded_data, copies_span);
+        try {
+            async_decode->decoded_data.resize_destructive(out_size);
+            std::span copies_span{copies.data(), copies.size()};
+            ConvertImage(input, info, async_decode->decoded_data, copies_span);
+        } catch (const std::bad_alloc&) {
+            // One piece of up to 214 MiB, on a thread with nobody to catch it: the session ended.
+            async_decode->failed = true;
+        }
 
         // TODO: Do we need this lock?
         std::unique_lock lock{async_decode->mutex};
@@ -2546,6 +2583,14 @@ void TextureCache<P>::TickAsyncDecode() {
             continue;
         }
         Image& image = slot_images[async_decode->image_id];
+        if (async_decode->failed) {
+            // Nothing to upload. The image keeps its clear until the guest writes it again; left
+            // marked as decoding, the collector could never free it.
+            LOG_ERROR(HW_GPU, "No memory to decode the image at {:#x}, dropped", image.gpu_addr);
+            image.flags &= ~ImageFlagBits::IsDecoding;
+            i = async_decodes.erase(i);
+            continue;
+        }
         if (async_decode->decoded_data.size() > MapSizeBytes(image)) {
             LOG_ERROR(HW_GPU, "Async decode of {} bytes for a {}-byte image at {:#x}, dropped",
                       async_decode->decoded_data.size(), MapSizeBytes(image), image.gpu_addr);
@@ -2557,22 +2602,29 @@ void TextureCache<P>::TickAsyncDecode() {
                 ConvertedLayout(image.info, async_decode->copies);
             }
             while (upload_budget > 0 && async_decode->next_copy < async_decode->copies.size()) {
-                auto slice = NextUploadSlice(async_decode->copies, async_decode->next_copy,
-                                             async_decode->next_layer, UPLOAD_SLICE_BYTES);
+                size_t next_copy = async_decode->next_copy;
+                s32 next_layer = async_decode->next_layer;
+                auto slice = NextUploadSlice(async_decode->copies, next_copy, next_layer,
+                                             UPLOAD_SLICE_BYTES);
                 size_t bytes = 0;
                 for (const BufferImageCopy& part : slice) {
                     bytes += part.buffer_size;
                 }
-                auto staging = runtime.UploadStagingBuffer(bytes);
+                auto staging = TryUploadStaging(runtime, bytes);
+                if (!staging) {
+                    break; // the same slice next frame
+                }
+                async_decode->next_copy = next_copy;
+                async_decode->next_layer = next_layer;
                 size_t offset = 0;
                 for (BufferImageCopy& part : slice) {
-                    std::memcpy(staging.mapped_span.data() + offset,
+                    std::memcpy(staging->mapped_span.data() + offset,
                                 async_decode->decoded_data.data() + part.buffer_offset,
                                 part.buffer_size);
                     part.buffer_offset = offset;
                     offset += part.buffer_size;
                 }
-                image.UploadMemory(staging, slice);
+                image.UploadMemory(*staging, slice);
                 has_uploads = true;
                 upload_budget -= (std::min)(upload_budget, bytes);
             }
@@ -2581,10 +2633,14 @@ void TextureCache<P>::TickAsyncDecode() {
                 continue;
             }
         } else {
-            auto staging = runtime.UploadStagingBuffer(MapSizeBytes(image));
-            std::memcpy(staging.mapped_span.data(), async_decode->decoded_data.data(),
+            auto staging = TryUploadStaging(runtime, MapSizeBytes(image));
+            if (!staging) {
+                ++i; // next frame
+                continue;
+            }
+            std::memcpy(staging->mapped_span.data(), async_decode->decoded_data.data(),
                         async_decode->decoded_data.size());
-            image.UploadMemory(staging, async_decode->copies);
+            image.UploadMemory(*staging, async_decode->copies);
             has_uploads = true;
         }
         image.flags &= ~ImageFlagBits::IsDecoding;
diff --git a/src/video_core/texture_cache/texture_cache_base.h b/src/video_core/texture_cache/texture_cache_base.h
