 template <class P>
+ImageId TextureCache<P>::TryMakeImage(const ImageInfo& info, GPUVAddr gpu_addr, DAddr cpu_addr) {
+    ImageId new_image_id{};
+    const auto make_image = [&] {
+        new_image_id = slot_images.insert(runtime, info, gpu_addr, cpu_addr);
+    };
+    if constexpr (requires { runtime.SurvivesImageRefusal(make_image); }) {
+        // The device could not back this image, or even create an empty sparse image. Do not
+        // keep a clean cached image with missing content. As for an unmapped address, a texture reads
+        // zero, a render target is left out, a blit goes through guest memory. Nothing needs
+        // undoing (an overlap's Alias mark is only read to be cleared). What the GPU writes
+        // meanwhile is lost; guest memory keeps the guest's data, and a later use makes the image
+        // and loads it as any new image. For a moment nothing this size or larger is asked for.
+        constexpr auto RefusalPause = std::chrono::seconds(1);
+        const u64 image_bytes = CalculateGuestSizeInBytes(info);
+        const auto now = std::chrono::steady_clock::now();
+        const bool paused = now < image_refused_until && image_bytes >= image_refused_bytes;
+        if (paused || !runtime.SurvivesImageRefusal(make_image)) {
+            if (!paused) {
+                LOG_ERROR(HW_GPU, "No memory for the image at {:#x} ({}x{}, {} MiB): left out",
+                          gpu_addr, info.size.width, info.size.height, image_bytes >> 20);
+                image_refused_until = now + RefusalPause;
+                image_refused_bytes = image_bytes;
+            }
+            image_refused = true;
+            return ImageId{};
+        }
+    } else {
+        make_image();
+    }
+    return new_image_id;
+}
