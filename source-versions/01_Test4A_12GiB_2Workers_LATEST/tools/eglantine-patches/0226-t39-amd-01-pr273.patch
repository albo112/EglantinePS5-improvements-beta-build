diff --git a/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp b/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp
index 8d83509961..85d3e328eb 100644
--- a/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp
+++ b/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp
@@ -90,8 +90,15 @@ Id GuestLane(EmitContext& ctx, Id index) {
     return ctx.OpBitwiseAnd(ctx.U32[1], index, ctx.Const(31U));
 }
 
+// Lichii PR 273 (68caa6c75e): fragment shaders take the broadcast fallback where the driver's
+// fragment-stage shuffles are wrong (AMD's Windows driver there; EDEN_NX2_AMD_PR273=1 on RADV).
+bool UseShuffleFallback(EmitContext& ctx) {
+    return ctx.profile.has_broken_spirv_subgroup_shuffle ||
+           (ctx.profile.has_broken_spirv_fragment_shuffle && ctx.stage == Stage::Fragment);
+}
+
 Id ShuffleAbsolute(EmitContext& ctx, Id value, Id src_thread_id) {
-    if (!ctx.profile.has_broken_spirv_subgroup_shuffle) {
+    if (!UseShuffleFallback(ctx)) {
         return ctx.OpGroupNonUniformShuffle(ctx.U32[1], SubgroupScope(ctx), value, src_thread_id);
     }
     Id result{ctx.u32_zero_value};
@@ -105,7 +112,7 @@ Id ShuffleAbsolute(EmitContext& ctx, Id value, Id src_thread_id) {
 }
 
 Id ShuffleRelative(EmitContext& ctx, Id value, Id delta, Id src_thread_id, spv::Op op) {
-    if (!ctx.profile.support_shuffle_relative) {
+    if (!ctx.profile.support_shuffle_relative || UseShuffleFallback(ctx)) {
         return ShuffleAbsolute(ctx, value, HostThreadId(ctx, src_thread_id));
     }
     const Id result{ctx.OpGroupNonUniformShuffleXor(ctx.U32[1], SubgroupScope(ctx), value, delta)};
diff --git a/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp b/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp
index e2af16e85b..4bd5c38930 100644
--- a/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp
+++ b/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp
@@ -27,6 +27,14 @@
 
 namespace Shader::Backend::SPIRV {
 
+bool AmdPr273Fixes() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_NX2_AMD_PR273");
+        return value != nullptr && value[0] != '0';
+    }();
+    return enabled;
+}
+
 bool AmdShaderFixes() {
     static const bool enabled = [] {
         const char* const value = std::getenv("EDEN_NX2_AMD_SHADER_FIXES");
@@ -756,22 +764,37 @@ void EmitContext::DefineSharedMemory(const IR::Program& program) {
         const Id offset{OpFunctionParameter(U32[1])};
         const Id insert_value{OpFunctionParameter(U32[1])};
         AddLabel();
-        OpBranch(loop_header);
-
-        AddLabel(loop_header);
+        // EDEN_NX2_AMD_PR273=1 (Lichii PR 273, 68caa6c75e): each attempt expects the word the
+        // previous compare-exchange returned, as CasLoopReturnedWord does for the other loops
+        // under EDEN_NX2_CAS_RETURNED; a plain reload can keep returning a stale copy on AMD and
+        // the invocations that lost never match again. This 8/16-bit shared store loop was the
+        // one loop sweep-01 left as it was.
+        const bool returned_word{AmdPr273Fixes()};
         const Id word_offset{OpShiftRightArithmetic(U32[1], offset, Const(2U))};
         const Id shift_offset{OpShiftLeftLogical(U32[1], offset, Const(3U))};
         const Id bit_offset{OpBitwiseAnd(U32[1], shift_offset, Const(mask))};
         const Id count{Const(size)};
+        const Id word_pointer{OpAccessChain(shared_u32, shared_memory_u32, word_offset)};
+        Id expected_var{};
+        if (returned_word) {
+            expected_var = AddLocalVariable(TypePointer(spv::StorageClass::Function, U32[1]),
+                                            spv::StorageClass::Function);
+            OpStore(expected_var, OpLoad(U32[1], word_pointer));
+        }
+        OpBranch(loop_header);
+
+        AddLabel(loop_header);
         OpLoopMerge(merge_block, continue_block, spv::LoopControlMask::MaskNone);
         OpBranch(continue_block);
 
         AddLabel(continue_block);
-        const Id word_pointer{OpAccessChain(shared_u32, shared_memory_u32, word_offset)};
-        const Id old_value{OpLoad(U32[1], word_pointer)};
+        const Id old_value{OpLoad(U32[1], returned_word ? expected_var : word_pointer)};
         const Id new_value{OpBitFieldInsert(U32[1], old_value, insert_value, bit_offset, count)};
         const Id atomic_res{OpAtomicCompareExchange(U32[1], word_pointer, Const(1U), u32_zero_value,
                                                     u32_zero_value, new_value, old_value)};
+        if (returned_word) {
+            OpStore(expected_var, atomic_res);
+        }
         const Id success{OpIEqual(U1, atomic_res, old_value)};
         OpBranchConditional(success, merge_block, loop_header);
 
