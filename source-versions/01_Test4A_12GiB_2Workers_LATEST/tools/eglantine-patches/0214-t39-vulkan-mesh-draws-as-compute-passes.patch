@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "common/common_types.h"
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan {
+
+class Device;
+class MemoryAllocator;
+
+// Task and mesh programs run as compute (EDEN_NX2_MESH_AS_COMPUTE=1): the one scratch region every
+// such draw uses in turn (shader_recompiler/backend/spirv/mesh_compute_layout.h). A draw's compute
+// passes write it and its readback draw reads it; a barrier between one draw's reads and the next
+// draw's writes serialises them on the one queue, so no draw needs a region of its own.
+// EDEN_NX2_MESH_COMPUTE_MIB sets its size (default 32); a draw that needs more is skipped and logged.
+// The device must give buffer device addresses: the shaders reach the region through them.
+class MeshComputeScratch {
+public:
+    /// The switch, read once.
+    [[nodiscard]] static bool Requested() noexcept;
+
+    explicit MeshComputeScratch(const Device& device, MemoryAllocator& memory_allocator);
+    ~MeshComputeScratch();
+
+    [[nodiscard]] bool IsValid() const noexcept {
+        return address != 0;
+    }
+    [[nodiscard]] VkBuffer Handle() const noexcept {
+        return *buffer;
+    }
+    [[nodiscard]] VkDeviceAddress Address() const noexcept {
+        return address;
+    }
+    [[nodiscard]] u64 SizeBytes() const noexcept {
+        return size;
+    }
+    /// Why the region could not be made (for the log), "" when it was.
+    [[nodiscard]] const char* Refusal() const noexcept {
+        return refusal;
+    }
+
+private:
+    vk::Buffer buffer;
+    VkDeviceAddress address{};
+    u64 size{};
+    const char* refusal{""};
+};
+
+} // namespace Vulkan
