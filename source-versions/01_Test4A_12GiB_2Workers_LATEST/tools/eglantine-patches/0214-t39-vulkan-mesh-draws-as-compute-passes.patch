+// Task and mesh programs run as compute: their pipelines, over the graphics pipeline's layout
+// (the same descriptors and push constants, with the compute stage in every range).
+void GraphicsPipeline::MakeMeshComputePipelines() {
+    // NVN task and mesh programs are written for 32-lane warps, as the compute programs are
+    // (vk_compute_pipeline.cpp): the subgroup size is pinned where the device allows it.
+    const VkPipelineShaderStageRequiredSubgroupSizeCreateInfoEXT subgroup_size_ci{
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO_EXT,
+        .pNext = nullptr,
+        .requiredSubgroupSize = GuestWarpSize,
+    };
+    const bool pin_subgroup{device.IsExtSubgroupSizeControlSupported() &&
+                            device.IsGuestWarpSizeSupported(VK_SHADER_STAGE_COMPUTE_BIT)};
+    VkPipelineCreateFlags flags{};
+    if (uses_descriptor_buffer) {
+        flags |= VK_PIPELINE_CREATE_DESCRIPTOR_BUFFER_BIT_EXT;
+    }
+    const auto make = [&](const vk::ShaderModule& module, bool guest_program) {
+        const VkComputePipelineCreateInfo compute_ci{
+            .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = flags,
+            .stage{
+                .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                .pNext = guest_program && pin_subgroup ? &subgroup_size_ci : nullptr,
+                .flags = 0,
+                .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                .module = *module,
+                .pName = "main",
+                .pSpecializationInfo = nullptr,
+            },
+            .layout = *pipeline_layout,
+            .basePipelineHandle = 0,
+            .basePipelineIndex = 0,
+        };
+        return device.GetLogical().CreateComputePipeline(compute_ci, *pipeline_cache);
+    };
+    mesh_pipeline = make(mesh_compute->mesh, true);
+    if (mesh_compute->task) {
+        task_pipeline = make(mesh_compute->task, true);
+        scan_pipeline = make(mesh_compute->scan, false);
+    }
+}
+
+// Records the draw's compute passes (mesh_compute_layout.h) before its render pass: the scratch
+// region is reused draw after draw behind a barrier, its header cleared, then the task pass, the
+// scan and the mesh pass (or the mesh pass alone) write it for the readback draw. False when the
+// draw does not fit the region or the pipelines are not there: the draw is skipped.
+bool GraphicsPipeline::RecordMeshComputePasses(const void* descriptor_data,
+                                               VkDeviceSize descriptor_buffer_offset,
+                                               u32 descriptor_buffer_chunk,
+                                               const RescalingPushConstant& rescaling) {
+    using namespace Shader::Backend::SPIRV;
+    mesh_compute_draw = {};
+    if (!mesh_scratch || !mesh_scratch->IsValid() || !mesh_pipeline) {
+        return false;
+    }
+    static std::atomic<u32> refusals{};
+    const auto refuse = [&](const char* why, u64 a, u64 b) {
+        if (refusals.fetch_add(1, std::memory_order_relaxed) < 32) {
+            LOG_WARNING(Render_Vulkan, "Mesh draw as compute skipped: {} ({}, {})", why, a, b);
+        }
+        return false;
+    };
+    const Shader::MeshInfo& mesh{mesh_compute->mesh_info};
+    const bool has_task{static_cast<bool>(task_pipeline)};
+    const u32 groups{mesh_draw_groups};
+    if (groups == 0) {
+        return true; // nothing to draw (mesh_compute_draw.recorded stays false)
+    }
+    // Vulkan guarantees 65535 workgroups per dispatch dimension (RADV allows no more).
+    static constexpr u32 MaxDispatch = 65535;
+    const u64 budget_words{mesh_scratch->SizeBytes() / sizeof(u32)};
+    u32 tasks{};
+    u32 mesh_groups{};
+    if (has_task) {
+        tasks = groups;
+        if (tasks > MaxDispatch) {
+            return refuse("too many task workgroups", tasks, MaxDispatch);
+        }
+        // The region holds as many mesh groups as fit after the header, prefix sums and payloads:
+        // the scan caps the task pass's count there.
+        const u64 per_group{2 + 3ull * mesh.max_primitives +
+                            u64{mesh.max_vertices} * mesh.vertex_lines.size() +
+                            u64{mesh.max_primitives} * mesh.primitive_lines.size()};
+        const u64 fixed{PlanMeshScratch(tasks, 0, mesh).total};
+        if (fixed >= budget_words || per_group == 0) {
+            return refuse("the task payloads alone fill the scratch region", fixed * 4,
+                          mesh_scratch->SizeBytes());
+        }
+        mesh_groups = static_cast<u32>(std::min<u64>(
+            {(budget_words - fixed) / per_group, u64{tasks} * MESH_MAX_GROUPS_PER_TASK, MaxDispatch}));
+        if (mesh_groups == 0) {
+            return refuse("no room for a mesh group", per_group * 4, mesh_scratch->SizeBytes());
+        }
+    } else {
+        mesh_groups = groups;
+        if (mesh_groups > MaxDispatch) {
+            return refuse("too many mesh workgroups", mesh_groups, MaxDispatch);
+        }
+    }
+    const MeshScratchPlan plan{PlanMeshScratch(tasks, mesh_groups, mesh)};
+    if (plan.total * sizeof(u32) > mesh_scratch->SizeBytes()) {
+        return refuse("the draw does not fit the scratch region", plan.total * 4,
+                      mesh_scratch->SizeBytes());
+    }
+    const VkDeviceAddress address{mesh_scratch->Address()};
+    const MeshComputeLayout push{
+        .scratch_low = static_cast<u32>(address),
+        .scratch_high = static_cast<u32>(address >> 32),
+        .tasks = tasks,
+        .groups = mesh_groups,
+        .group_corners = 3 * mesh.max_primitives,
+        .padding = {},
+    };
+    scheduler.RequestOutsideRenderPassOperationContext();
+    scheduler.Record([this, descriptor_data, descriptor_buffer_offset, descriptor_buffer_chunk, push,
+                      has_task, rescaling_data = rescaling.Data()](vk::CommandBuffer cmdbuf) {
+        const VkBuffer scratch{mesh_scratch->Handle()};
+        // The last draw's reads of the region come before this draw's writes; the header is cleared.
+        static constexpr VkMemoryBarrier reuse_barrier{
+            .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
