@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <cstdlib>
+
+#include "common/logging.h"
+#include "video_core/renderer_vulkan/vk_mesh_compute.h"
+#include "video_core/vulkan_common/vulkan_device.h"
+#include "video_core/vulkan_common/vulkan_memory_allocator.h"
+
+namespace Vulkan {
+
+bool MeshComputeScratch::Requested() noexcept {
+    static const bool requested = [] {
+        const char* value = std::getenv("EDEN_NX2_MESH_AS_COMPUTE");
+        return value != nullptr && value[0] == '1';
+    }();
+    return requested;
+}
+
+MeshComputeScratch::MeshComputeScratch(const Device& device, MemoryAllocator& memory_allocator) {
+    if (!device.IsBufferDeviceAddressSupported()) {
+        refusal = "the device has no buffer device addresses";
+        LOG_WARNING(Render_Vulkan, "Mesh draws as compute: off, {}", refusal);
+        return;
+    }
+    u64 mib = 32;
+    if (const char* value = std::getenv("EDEN_NX2_MESH_COMPUTE_MIB")) {
+        mib = std::clamp<u64>(std::strtoull(value, nullptr, 10), 4, 1024);
+    }
+    size = mib << 20;
+    const VkBufferCreateInfo buffer_ci{
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .pNext = nullptr,
+        .flags = 0,
+        .size = size,
+        .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT |
+                 VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr,
+    };
+    try {
+        buffer = memory_allocator.CreateBuffer(buffer_ci, MemoryUsage::DeviceLocal);
+    } catch (const vk::Exception& exception) {
+        refusal = "the scratch region could not be made";
+        LOG_WARNING(Render_Vulkan, "Mesh draws as compute: off, {} ({} MiB: {})", refusal, mib,
+                    exception.what());
+        size = 0;
+        return;
+    }
+    if (!buffer) {
+        refusal = "the scratch region could not be made";
+        LOG_WARNING(Render_Vulkan, "Mesh draws as compute: off, {} ({} MiB)", refusal, mib);
+        size = 0;
+        return;
+    }
+    address = device.GetLogical().GetBufferDeviceAddress(*buffer);
+    if (address == 0) {
+        refusal = "the scratch region has no device address";
+        LOG_WARNING(Render_Vulkan, "Mesh draws as compute: off, {}", refusal);
+        buffer.reset();
+        size = 0;
+        return;
+    }
+    LOG_INFO(Render_Vulkan, "Mesh draws as compute: on, scratch region of {} MiB", mib);
+}
+
+MeshComputeScratch::~MeshComputeScratch() = default;
+
+} // namespace Vulkan
