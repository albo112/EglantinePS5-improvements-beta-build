diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index db86637d72..158aee266e 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -952,6 +952,17 @@ ImageViewId TextureCache<P>::VisitImageView(u32 index, bool compute) {
     return id;
 }
 
+template <class P>
+void TextureCache<P>::LandDeferredClearBeforeCopy() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_NX2_CLEAR_BEFORE_COPY");
+        return value != nullptr && value[0] != '0';
+    }();
+    if (enabled) {
+        runtime.FlushDeferredClear();
+    }
+}
+
 template <class P>
 FramebufferId TextureCache<P>::GetFramebufferId(const RenderTargets& key) {
     const auto [pair, is_new] = framebuffers.try_emplace(key);
@@ -1131,6 +1142,12 @@ template <class P>
 bool TextureCache<P>::BlitImage(const Tegra::Engines::Fermi2D::Surface& dst,
                                 const Tegra::Engines::Fermi2D::Surface& src,
                                 const Tegra::Engines::Fermi2D::Config& copy) {
+    // A deferred clear parked before this copy has to land before it: realized afterwards, its
+    // clear pass starts after the copy and wipes what the copy wrote. Ocarina of Time clears an
+    // occlusion depth, blits the scene depth over it and reads it during a later draw (Lichii
+    // issue 101). GetFramebufferId only flushes when it creates a framebuffer, so this starts on
+    // the second frame. EDEN_NX2_CLEAR_BEFORE_COPY=1 turns it on.
+    LandDeferredClearBeforeCopy();
     const auto result = GetBlitImages(dst, src, copy);
     if (!result) {
         return false;
@@ -3434,6 +3451,7 @@ ImageId TextureCache<P>::FindDMAImage(const ImageInfo& info, GPUVAddr gpu_addr)
 template <class P>
 std::pair<u32, u32> TextureCache<P>::PrepareDmaImage(ImageId dst_id, GPUVAddr base_addr,
                                                      bool mark_as_modified) {
+    LandDeferredClearBeforeCopy(); // As in BlitImage
     const auto& image = slot_images[dst_id];
     const auto base = image.TryFindBase(base_addr);
     PrepareImage(dst_id, mark_as_modified, false);
@@ -4160,6 +4178,7 @@ void TextureCache<P>::PrepareImageView(ImageViewId image_view_id, bool is_modifi
 
 template <class P>
 void TextureCache<P>::CopyImage(ImageId dst_id, ImageId src_id, std::vector<ImageCopy> copies) {
+    LandDeferredClearBeforeCopy(); // As in BlitImage
     Image& dst = slot_images[dst_id];
     Image& src = slot_images[src_id];
     if (True(dst.flags & ImageFlagBits::UnwrittenSparse) ||
