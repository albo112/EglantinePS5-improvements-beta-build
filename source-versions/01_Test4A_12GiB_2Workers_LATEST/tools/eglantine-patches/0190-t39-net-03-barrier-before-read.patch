diff --git a/src/shader_recompiler/backend/spirv/emit_spirv_barriers.cpp b/src/shader_recompiler/backend/spirv/emit_spirv_barriers.cpp
index 0b9a3664ff..a61114a3fc 100644
--- a/src/shader_recompiler/backend/spirv/emit_spirv_barriers.cpp
+++ b/src/shader_recompiler/backend/spirv/emit_spirv_barriers.cpp
@@ -29,6 +29,15 @@ void EmitWorkgroupMemoryBarrier(EmitContext& ctx) {
     MemoryBarrier(ctx, spv::Scope::Workgroup);
 }
 
+// Keeps one subgroup's shared memory accesses in program order, nothing more: no other storage
+// class, and no wait for other subgroups.
+void EmitSubgroupMemoryBarrier(EmitContext& ctx) {
+    const auto semantics{spv::MemorySemanticsMask::AcquireRelease |
+                         spv::MemorySemanticsMask::WorkgroupMemory};
+    ctx.OpMemoryBarrier(ctx.Const(static_cast<u32>(spv::Scope::Subgroup)),
+                        ctx.Const(static_cast<u32>(semantics)));
+}
+
 void EmitDeviceMemoryBarrier(EmitContext& ctx) {
     MemoryBarrier(ctx, spv::Scope::Device);
 }
