@@ -211,6 +211,20 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
     const bool uses_async_copy = std::any_of(code.begin(), code.end(), [](const auto& instruction) {
         return instruction.Bits(0, 12) == 0xfae;
     });
+    // EDEN_NX2_NET_BARRIER=1: a warp's shared memory accesses stay in order on the console, so
+    // Ocarina of Time's upscaler (agl_ndsr_vr_light, 0x4c70 on) stores rows and reads other lanes'
+    // rows back with no BAR between them. Other compilers may reorder those accesses: on Metal
+    // about 100 pixels a frame came out wrong. In programs with HMMA, the first shared read after
+    // a store and before the next BAR gets a subgroup memory barrier.
+    static const bool order_warp_shared = [] {
+        const char* const text = std::getenv("EDEN_NX2_NET_BARRIER");
+        return text && text[0] == '1';
+    }();
+    const bool keep_shared_order = order_warp_shared &&
+        std::any_of(code.begin(), code.end(), [](const auto& instruction) {
+            return instruction.Bits(0, 12) == 0x23c;
+        });
+    bool shared_store_pending = false;
     for (const auto& instruction : code) {
         const u32 op = instruction.Bits(0, 12);
         uses_uniform_bank |= op == 0x4a4 || op == 0x2bf || op == 0x499;
@@ -1514,6 +1528,7 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
                 return fail(index, "native workgroup barrier mode");
             emit(0xf0a8000000000000ULL | predicate | (u64{1} << 43) |
                 (u64{1} << 44) | (u64{1} << 39) | (u64{7} << 39));
+            shared_store_pending = false;
             break;
         case 0x388: case 0x984: case 0x988: { // Shared memory load/store with scaled register offsets.
             const u32 width = insn.Bits(73, 3), stride = insn.Bits(78, 2);
@@ -1537,6 +1552,14 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
                 address = 250;
             }
             const bool store = opcode != 0x984;
+            if (keep_shared_order) {
+                if (!store && shared_store_pending) {
+                    emit(0xef98000000000000ULL | predicate | (u64{1} << 20)); // subgroup MEMBAR
+                    shared_store_pending = false;
+                } else if (store) {
+                    shared_store_pending = true;
+                }
+            }
             const u32 data = store ? insn.Bits(32, 8) : static_cast<u32>(dest);
             emit((store ? 0xef58000000000000ULL : 0xef48000000000000ULL) |
                 predicate | data | (u64{address} << 8) | (u64{insn.Bits(40, 24)} << 20) |
