 #include <memory>
 #include <numeric>
 #include <stdexcept>
@@ -100,6 +101,21 @@ void BufferCache<P>::RunGarbageCollector(bool aggressive_gc) {
     }
 }
 
+template <class P>
+void BufferCache<P>::ReportMemory() {
+    size_t buffers{};
+    u64 total{}, largest{};
+    for (const auto [buffer_id, buffer] : slot_buffers) {
+        const u64 bytes = buffer->SizeBytes();
+        ++buffers;
+        total += bytes;
+        largest = (std::max)(largest, bytes);
+    }
+    std::fprintf(stderr, "EDEN_REFUSED_BUFFERS %zu buffers hold %llu MiB, the largest %llu MiB\n",
+                 buffers, static_cast<unsigned long long>(total >> 20),
+                 static_cast<unsigned long long>(largest >> 20));
+}
