From 3650337016370ea486e15dd68f84a156663b3fb0 Mon Sep 17 00:00:00 2001
From: Aflakon <125590634+Aflakon@users.noreply.github.com>
Date: Sat, 7 Nov 2026 00:46:56 +0100
Subject: [PATCH] core: EDEN_NX2_MEMORY_GB=8 or 10 gives a Switch 2 title a
 smaller memory layout (Aflakon, cold-020-04)

Aflakon's patch 1903 (ocarina-cold-memory f0515ee16), unchanged: a title that sizes its heap
from the total memory may keep less of the 12 GB pool the guest, the emulator and graphics share.
Unset: the 12 GiB layout, as before. Untested here: a game may refuse a smaller layout.
---
 src/core/core.cpp | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/core/core.cpp b/src/core/core.cpp
index 3b5aa6e3fc..2c82d3279a 100644
--- a/src/core/core.cpp
+++ b/src/core/core.cpp
@@ -405,11 +405,22 @@ struct System::Impl {
 
         // Switch 2 titles size their heap from the total memory and need the 12 GiB layout. Set it
         // as a per-game value, so RestoreGlobalState brings back the configured layout afterwards.
-        if (switch2_program &&
-            Settings::values.memory_layout_mode.GetValue() != Settings::MemoryLayout::Memory_12Gb) {
-            LOG_INFO(Core, "Switch 2 program: using the 12 GiB memory layout");
+        // EDEN_NX2_MEMORY_GB=8 or 10 gives them a smaller layout instead (PS5: a 12 GB pool holds the
+        // guest's memory, the emulator and graphics together; a title that sizes its heap from the
+        // total may then keep less).
+        static const Settings::MemoryLayout switch2_layout = [] {
+            const char* value = std::getenv("EDEN_NX2_MEMORY_GB");
+            const int gb = value != nullptr ? std::atoi(value) : 12;
+            return gb == 8    ? Settings::MemoryLayout::Memory_8Gb
+                   : gb == 10 ? Settings::MemoryLayout::Memory_10Gb
+                              : Settings::MemoryLayout::Memory_12Gb;
+        }();
+        if (switch2_program && Settings::values.memory_layout_mode.GetValue() != switch2_layout) {
+            LOG_INFO(Core, "Switch 2 program: using the {} memory layout",
+                     switch2_layout == Settings::MemoryLayout::Memory_12Gb ? "12 GiB"
+                     : switch2_layout == Settings::MemoryLayout::Memory_10Gb ? "10 GiB" : "8 GiB");
             Settings::values.memory_layout_mode.SetGlobal(false);
-            Settings::values.memory_layout_mode.SetValue(Settings::MemoryLayout::Memory_12Gb);
+            Settings::values.memory_layout_mode.SetValue(switch2_layout);
         }
 
         // The Switch 2 counter runs at 31.25 MHz and its SDK converts ticks with that constant
-- 
