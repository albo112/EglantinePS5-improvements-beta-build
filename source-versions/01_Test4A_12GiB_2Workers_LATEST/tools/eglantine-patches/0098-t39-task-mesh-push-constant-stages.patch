diff --git a/src/video_core/renderer_vulkan/pipeline_helper.h b/src/video_core/renderer_vulkan/pipeline_helper.h
index 6958a64d98d5040aaf88cc432902eb4a7dd3ffb0..40b01f253d968275d5404b6fc78f68ba13ac0f6d 100644
--- a/src/video_core/renderer_vulkan/pipeline_helper.h
+++ b/src/video_core/renderer_vulkan/pipeline_helper.h
@@ -143,6 +143,17 @@ inline void WriteDescriptorBuffer(const Device& device, const DescriptorBufferLa
            Shader::NumDescriptors(info.image_descriptors);
 }
 
+// ALL_GRAPHICS is the vertex/tessellation/geometry/fragment mask. Task and mesh programs read the
+// same rescaling push constants (texture and image scaling, with a resolution other than 1x), so
+// the range and the updates name their stages too where the device has them.
+// From heydemoura/EglantinePS5 core patch 0004.
+inline VkShaderStageFlags GraphicsPushConstantStages(const Device& device) {
+    return VK_SHADER_STAGE_ALL_GRAPHICS |
+           (device.IsExtMeshShaderSupported()
+                ? VK_SHADER_STAGE_TASK_BIT_EXT | VK_SHADER_STAGE_MESH_BIT_EXT
+                : 0U);
+}
+
 class DescriptorLayoutBuilder {
 public:
     DescriptorLayoutBuilder(const Device& device_) : device{&device_} {}
@@ -248,11 +259,7 @@ public:
         const u32 size_offset = is_compute ? sizeof(RescalingLayout::down_factor) : 0u;
         const VkPushConstantRange range{
             .stageFlags = static_cast<VkShaderStageFlags>(
-                is_compute ? VK_SHADER_STAGE_COMPUTE_BIT
-                           : (uses_mesh ? VK_SHADER_STAGE_ALL_GRAPHICS |
-                                              VK_SHADER_STAGE_TASK_BIT_EXT |
-                                              VK_SHADER_STAGE_MESH_BIT_EXT
-                                        : VK_SHADER_STAGE_ALL_GRAPHICS)),
+                is_compute ? VK_SHADER_STAGE_COMPUTE_BIT : GraphicsPushConstantStages(*device)),
             .offset = 0,
             .size = static_cast<u32>(sizeof(RescalingLayout)) - size_offset +
                     static_cast<u32>(sizeof(RenderAreaLayout)),
