 }
+
+// EDEN_NX2_FETCH_COUNT=1, after kraibse's 2c9263140d (Djihads80/Eglantine): where each entry's
+// words came from, and how often the words the parser got differ from the words at submit. An
+// entry read live, or a copy read again after submit, is how a ring the game already refilled gets
+// parsed as this frame's commands. =2 also compares the entries that took their copy with memory
+// as it is at the parse: that reads every entry. DumpCurrentEntry adds the totals and the last
+// entries to its report, and so does the first nonzero word the parser drops (NoteDroppedWord).
+int FetchCountMode() {
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_NX2_FETCH_COUNT");
+        return value == nullptr ? 0 : value[0] - '0';
+    }();
+    return mode;
+}
+
+enum FetchReason : u32 {
+    FetchSubmitCopy,
+    FetchRefreshedCopy,
+    FetchResumed,
+    FetchNoCopy,
+    FetchEmptyAtSubmit,
+    FetchSuspendedCopy,
+    FetchSuspensionsChanged,
+    FetchDeferred,
+    FetchGpuWritten, // CountFetchedEntry splits off the next two by what ReadGpuWrittenCommands did
+    FetchGpuCopied,
+    FetchGpuLive,
+    FetchSafeDirty,
+    FetchReasonCount,
+};
+constexpr std::array<const char*, FetchReasonCount> fetch_reason_names{
+    "submit copy",
+    "copy read again after submit",
+    "resumed entry",
+    "no copy kept",
+    "empty at submit",
+    "copied during a suspension",
+    "suspension count changed",
+    "deferred entry",
+    "GPU-written page, after a flush",
+    "GPU-written page, host copy",
+    "GPU-written page, memory read live",
+    "safe read of dirty memory",
+};
+// DmaPusher::fetch_gpu_read
+constexpr u32 FetchReadCopy = 1;
+constexpr u32 FetchReadLive = 2;
+
+std::array<std::atomic<u64>, FetchReasonCount> fetch_seen{};
+std::array<std::atomic<u64>, FetchReasonCount> fetch_compared{};
+std::array<std::atomic<u64>, FetchReasonCount> fetch_differing{};
+std::atomic<u64> fetch_total{};
+std::atomic<u64> fetch_refreshed_lists{};
+std::atomic<u64> fetch_dropped_words{};
+
+void ReportFetchTotals() {
+    std::string totals;
+    for (size_t i = 0; i < fetch_reason_names.size(); ++i) {
+        totals += fmt::format("{}{} {}/{}/{}", i == 0 ? "" : ", ", fetch_reason_names[i],
+                              fetch_differing[i].load(std::memory_order_relaxed),
+                              fetch_compared[i].load(std::memory_order_relaxed),
+                              fetch_seen[i].load(std::memory_order_relaxed));
+    }
+    // New-mark calls: one per 64-page word with a new bit, so a lower bound on pages, any pages.
+    LOG_WARNING(HW_GPU,
+                "FETCH_COUNT differ/compared/seen: {}; lists read again {}, dropped words {}, "
+                "new-mark calls so far {}",
+                totals, fetch_refreshed_lists.load(std::memory_order_relaxed),
+                fetch_dropped_words.load(std::memory_order_relaxed),
+                Tegra::g_nx2_new_written_pages.load(std::memory_order_relaxed));
+}
 } // Anonymous namespace
 
