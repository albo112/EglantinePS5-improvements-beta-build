 }
 
+u32 DmaPusher::FetchReasonOf(const CommandList& list, bool submitted, bool gpu_written) const {
+    // In the order of Step's `submitted`.
+    const size_t index = dma_pushbuffer_subindex;
+    if (submitted) {
+        return list.refreshes != 0 ? FetchRefreshedCopy : FetchSubmitCopy;
+    }
+    if (command_resume_offset != 0) {
+        return FetchResumed;
+    }
+    if (index >= list.submitted_offsets.size()) {
+        return FetchNoCopy;
+    }
+    if (list.submitted_offsets[index] >= list.submitted_words.size()) {
+        return FetchEmptyAtSubmit;
+    }
+    if ((list.snapshot_suspensions & 1) != 0) {
+        return FetchSuspendedCopy;
+    }
+    if (list.snapshot_suspensions != suspensions.load(std::memory_order_acquire)) {
+        return FetchSuspensionsChanged;
+    }
+    if (std::ranges::binary_search(list.deferred_entries, static_cast<u32>(index))) {
+        return FetchDeferred;
+    }
+    return gpu_written ? FetchGpuWritten : FetchSafeDirty;
+}
+
+void DmaPusher::CountFetchedEntry(const CommandListHeader& header,
+                                  std::span<const CommandHeader> commands) {
+    const CommandList& list = dma_pushbuffer.front();
+    const size_t index = dma_pushbuffer_subindex;
+    u32 reason = fetch_reason;
+    if (reason == FetchGpuWritten && fetch_gpu_read != 0) {
+        reason = (fetch_gpu_read & FetchReadLive) != 0 ? FetchGpuLive : FetchGpuCopied;
+    }
+    // An all-zero entry's offset is out of range on purpose, a deferred entry's slot is unfilled,
+    // and a list read again without first_words no longer holds its words as submitted.
+    const bool has_copy =
+        index < list.submitted_offsets.size() &&
+        size_t{list.submitted_offsets[index]} + commands.size() <= list.submitted_words.size() &&
+        !std::ranges::binary_search(list.deferred_entries, static_cast<u32>(index)) &&
+        (list.refreshes == 0 || !list.first_words.empty());
+    u32 first = ~0U;
+    u32 words = 0;
+    bool compared = false;
+    const auto compare = [&](const CommandHeader* copy, size_t i, u32 value) {
+        if (copy[i].argument != value) {
+            first = (std::min)(first, static_cast<u32>(i));
+            ++words;
+        }
+    };
+    if (has_copy) {
+        const CommandHeader* const copy =
+            (list.first_words.empty() ? list.submitted_words : list.first_words).data() +
+            list.submitted_offsets[index];
+        if (reason != FetchSubmitCopy) {
+            // The words the parser got, not memory again: a GPU-written entry can come from a
+            // host copy that memory doesn't hold. A resumed entry parses from its resume word.
+            for (size_t i = command_resume_offset; i < commands.size(); ++i) {
+                compare(copy, i, commands[i].argument);
+            }
+            compared = true;
+        } else if (FetchCountMode() == 2) {
+            fetch_scratch.resize(commands.size());
+            memory_manager.ReadBlockUnsafe(header.addr, fetch_scratch.data(),
+                                           fetch_scratch.size() * sizeof(u32));
+            for (size_t i = 0; i < fetch_scratch.size(); ++i) {
+                compare(copy, i, fetch_scratch[i]);
+            }
+            compared = true;
+        }
+    }
+    fetch_seen[reason].fetch_add(1, std::memory_order_relaxed);
+    if (compared) {
+        fetch_compared[reason].fetch_add(1, std::memory_order_relaxed);
+    }
+    if (words != 0 && fetch_differing[reason].fetch_add(1, std::memory_order_relaxed) < 4) {
+        LOG_WARNING(HW_GPU,
+                    "Entry at {:#x}+{:#x} ({}) differs from its words at submit in {} words, first "
+                    "at word {}",
+                    header.addr.Value(), header.size.Value(), fetch_reason_names[reason], words,
+                    first);
+    }
+    fetched_entries[fetched_entry_count++ % fetched_entries.size()] = FetchedEntry{
+        .address = header.addr.Value(),
+        .index = static_cast<u32>(index),
+        .size = static_cast<u32>(commands.size()),
+        .reason = reason,
+        .carried = dma_state.method_count,
+        .resumed = static_cast<u32>(command_resume_offset),
+        .differing = words,
+        .refreshes = list.refreshes,
+        .compared = compared,
+        .gpu_written = fetch_gpu_written,
+    };
+    // Also in the log when the stream never reaches an unknown puller method (run 149).
+    if (((fetch_total.fetch_add(1, std::memory_order_relaxed) + 1) & 0xfffff) == 0) {
+        ReportFetchTotals();
+    }
+}
+
+void DmaPusher::ReportFetchCount() {
+    ReportFetchTotals();
+    const size_t kept = (std::min)(fetched_entry_count, fetched_entries.size());
+    for (size_t i = 0; i < kept; ++i) {
+        const FetchedEntry& entry =
+            fetched_entries[(fetched_entry_count - 1 - i) % fetched_entries.size()];
+        LOG_WARNING(HW_GPU,
+                    "FETCH_COUNT -{}: entry {} at {:#x}+{:#x} words from {}, words differing from "
+                    "submit: {}, list read again {} times, resumed at word {}, {} words wanted at "
+                    "its start, GPU-written at fetch {}, at this report {}",
+                    i, entry.index, entry.address, entry.size, fetch_reason_names[entry.reason],
+                    entry.compared ? fmt::format("{}", entry.differing) : "not compared",
+                    entry.refreshes, entry.resumed, entry.carried, entry.gpu_written,
+                    IsGpuWrittenCommands(entry.address, size_t{entry.size} * sizeof(u32)));
+    }
+}
+
+void DmaPusher::NoteDroppedWord(u32 word, size_t position) {
+    // A nonzero word where a header belongs goes without a trace, and in run 86 two of them went
+    // an entry before the unknown method. A healthy stream may have some too: 4 reports at most,
+    // one per entry, and the unknown method's report still comes after them.
+    if (fetch_dropped_words.fetch_add(1, std::memory_order_relaxed) < 16) {
+        LOG_WARNING(HW_GPU, "FETCH_COUNT dropped word {:08x}, word {} of the entry at {:#x}", word,
+                    position, dma_state.dma_get);
+    }
+    if (fetch_reports < 4 && fetch_report_entry != fetched_entry_count) {
+        ++fetch_reports;
+        fetch_report_entry = fetched_entry_count;
+        ReportFetchCount();
+    }
+}
+
 void DmaPusher::RecordParsedEntry(const CommandListHeader& header,
                                   std::span<const CommandHeader> commands) {
-    if (!g_record_parsed_entries) {
+    if (FetchCountMode() != 0) {
+        CountFetchedEntry(header, commands);
+    }
+    if (!RecordParsedEntries()) {
         return;
     }
     u64 hash = 0xcbf29ce484222325ULL;
@@ -924,6 +1157,9 @@ void DmaPusher::DumpCurrentEntry(const char* reason) {
                     entry_trace.carried_method, entry_trace.carried_count, entry_trace.gpu_written,
                     has_snapshot ? "kept" : "none", differ, first_differing, slot_state, ever_out);
     }
+    if (FetchCountMode() != 0) {
+        ReportFetchCount();
+    }
     const auto& lists = dma_pushbuffer.front().command_lists;
     const size_t first = dma_pushbuffer_subindex >= 2 ? dma_pushbuffer_subindex - 2 : 0;
     for (size_t i = first; i <= dma_pushbuffer_subindex && i < lists.size(); ++i) {
