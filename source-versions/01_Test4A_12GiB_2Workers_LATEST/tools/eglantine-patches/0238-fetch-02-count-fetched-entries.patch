@@ -389,8 +465,12 @@ static const u32 g_semaphore_watch = [] {
     return value ? static_cast<u32>(std::strtoull(value, nullptr, 16)) : 0U;
 }();
 
-// EDEN_NX2_PB_CHECK also keeps the last parsed entries, for DumpCurrentEntry.
-static const bool g_record_parsed_entries = std::getenv("EDEN_NX2_PB_CHECK") != nullptr;
+// EDEN_NX2_PB_CHECK also keeps the last parsed entries, for DumpCurrentEntry. Read at first use:
+// env.txt is applied in main, after the globals.
+static bool RecordParsedEntries() {
+    static const bool enabled = std::getenv("EDEN_NX2_PB_CHECK") != nullptr;
+    return enabled;
+}
 
