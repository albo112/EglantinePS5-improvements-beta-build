+    size_t fetched_entry_count{};
+    size_t fetch_report_entry{};
+    u32 fetch_reports{};
+    u32 fetch_reason{};
+    u32 fetch_gpu_read{}; ///< What ReadGpuWrittenCommands read: FetchReadCopy, FetchReadLive
+    bool fetch_gpu_written{};
+    std::vector<u32> fetch_scratch;
+    u32 FetchReasonOf(const CommandList& list, bool submitted, bool gpu_written) const;
+    void CountFetchedEntry(const CommandListHeader& header,
