+// A timed A/B inside one run, for pictures the log can't judge.
+// EDEN_NX2_AB_SKIP=<seconds>;<phase>;<phase>...: each phase is a comma list of program hashes, as
+// the workaround and shader dumps name them (lower case, no 0x, lowest bit ignored: it is the
+// salt). An empty phase is the plain picture. A phase's draws and dispatches are skipped for
+// <seconds>, then the next phase runs, round and round. The word d16 in a phase also makes depth
+// clears of a 1600x1600 target clear to 0. Every change of phase logs what the last one really
+// skipped, and the console's wall clock, so a hash that matched nothing shows and frames can be
+// matched (a capture's own clock can differ: measure the offset, don't assume it).
+// Skipping a dispatch leaves its output as it was, so skip the pass that reads it where one exists.
+// EDEN_NX2_AB_LOG=1 names every program once, with its targets.
+class TimedAb {
+public:
+    static TimedAb& Get() {
+        static TimedAb instance;
+        return instance;
+    }
+
+    [[nodiscard]] bool Active() const {
+        return !phases.empty() || log_programs;
+    }
+
+    template <typename Hashes>
+    [[nodiscard]] bool SkipDraw(const Hashes& hashes, const Tegra::Engines::Maxwell3D::Regs& regs) {
+        std::scoped_lock lock{mutex};
+        Tick();
+        if (log_programs && seen.size() < 4096 && seen.insert(hashes[1] ^ (hashes[5] << 1)).second) {
+            LOG_INFO(HW_GPU,
+                     "EDEN_AB program vs {:016x} fs {:016x} rt0 {:#x} {}x{} format {:#x} targets {} "
+                     "zeta {:#x} {}x{} format {:#x} enabled {}",
+                     hashes[1], hashes[5], regs.rt[0].Address(), regs.rt[0].width, regs.rt[0].height,
+                     static_cast<u32>(regs.rt[0].format), regs.rt_control.count.Value(),
+                     regs.zeta.Address(), regs.zeta_size.width, regs.zeta_size.height,
+                     static_cast<u32>(regs.zeta.format), static_cast<u32>(regs.zeta_enable));
+        }
+        for (const u64 hash : hashes) {
+            if (hash != 0 && Matches(hash)) {
+                ++skipped_draws;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    [[nodiscard]] bool SkipDispatch(u64 hash) {
+        std::scoped_lock lock{mutex};
+        Tick();
+        if (log_programs && seen.size() < 4096 && seen.insert(hash).second) {
+            LOG_INFO(HW_GPU, "EDEN_AB program cs {:016x}", hash);
+        }
+        if (Matches(hash)) {
+            ++skipped_dispatches;
+            return true;
+        }
+        return false;
+    }
+
+    [[nodiscard]] f32 ClearDepth(const Tegra::Engines::Maxwell3D::Regs& regs) {
+        if (phases.empty()) {
+            return regs.clear_depth;
+        }
+        std::scoped_lock lock{mutex};
+        if (!phases[current].clear_d16 || regs.zeta_size.width != 1600 ||
+            regs.zeta_size.height != 1600) {
+            return regs.clear_depth;
+        }
+        // A game that clears to 0 already gets no change: the count stays 0 and the log names the
+        // value it asked for, so a phase that did nothing can't be read as a result.
+        d16_asked = regs.clear_depth;
+        changed_clears += regs.clear_depth != 0.0f ? 1 : 0;
+        return 0.0f;
+    }
+
+private:
+    struct Phase {
+        std::vector<u64> hashes;
+        bool clear_d16 = false;
+    };
+
+    TimedAb() {
+        const char* const log = std::getenv("EDEN_NX2_AB_LOG");
+        log_programs = log != nullptr && log[0] != '0';
+        const char* const text = std::getenv("EDEN_NX2_AB_SKIP");
+        if (text == nullptr) {
+            return;
+        }
+        char* cursor = nullptr;
+        const unsigned long seconds = std::strtoul(text, &cursor, 10);
+        period = std::chrono::seconds{seconds != 0 ? seconds : 15};
+        while (*cursor == ';') {
+            ++cursor;
+            Phase phase;
+            while (*cursor != '\0' && *cursor != ';') {
+                if (std::string_view{cursor}.starts_with("d16") &&
+                    (cursor[3] == '\0' || cursor[3] == ',' || cursor[3] == ';')) {
+                    phase.clear_d16 = true;
+                    cursor += 3;
+                } else {
+                    char* end = nullptr;
+                    const u64 hash = std::strtoull(cursor, &end, 16);
+                    if (end == cursor) {
+                        break;
+                    }
+                    phase.hashes.push_back(hash | 1);
+                    cursor = end;
+                }
+                if (*cursor == ',') {
+                    ++cursor;
+                }
+            }
+            phases.push_back(std::move(phase));
+        }
+    }
+
+    [[nodiscard]] bool Matches(u64 hash) const {
+        return !phases.empty() &&
+               std::ranges::find(phases[current].hashes, hash | 1) != phases[current].hashes.end();
+    }
+
+    void Tick() {
+        if (phases.empty() || (++ticks & 63) != 0) {
+            return;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (start == std::chrono::steady_clock::time_point{}) {
+            start = now;
+        }
+        const size_t next = static_cast<size_t>((now - start) / period) % phases.size();
+        if (next == current) {
+            return;
+        }
+        const auto clock = std::chrono::duration_cast<std::chrono::seconds>(
+            std::chrono::system_clock::now().time_since_epoch());
+        LOG_WARNING(HW_GPU,
+                    "EDEN_AB phase {} ended: {} draws, {} dispatches skipped, {} clears changed "
+                    "(depth asked {}); phase {} starts at unix time {}",
+                    current, skipped_draws, skipped_dispatches, changed_clears, d16_asked, next,
+                    clock.count());
+        current = next;
+        skipped_draws = skipped_dispatches = changed_clears = 0;
+        d16_asked = -1.0f;
+    }
+
+    std::mutex mutex;
+    std::vector<Phase> phases;
+    std::set<u64> seen;
+    std::chrono::seconds period{15};
+    std::chrono::steady_clock::time_point start{};
+    size_t current = 0;
+    u64 ticks = 0;
+    u64 skipped_draws = 0;
+    u64 skipped_dispatches = 0;
+    u64 changed_clears = 0;
+    f32 d16_asked = -1.0f; ///< The depth the game last asked for in a d16 clear, -1 for none
+    bool log_programs = false;
+};
 } // Anonymous namespace
 
