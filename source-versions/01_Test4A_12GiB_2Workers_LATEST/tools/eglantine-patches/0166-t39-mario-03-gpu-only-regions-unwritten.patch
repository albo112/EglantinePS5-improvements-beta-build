         gpu_address >= g_nx2_sparse_high.load(std::memory_order_relaxed)) [[likely]] {
         return false;
@@ -341,7 +349,7 @@ inline bool Nx2SparseUnwritten(u64 gpu_address, u64 size) {
     }
     --it;
     const auto& [start, region] = *it;
-    if (gpu_address + size > start + region.size) {
+    if (region.gpu_only != gpu_only || gpu_address + size > start + region.size) {
         return false;
     }
     const u64 last = (gpu_address + size - 1 - start) / region.block_size;
@@ -353,6 +361,16 @@ inline bool Nx2SparseUnwritten(u64 gpu_address, u64 size) {
