 }
 
+/// True when [gpu_address, +size) lies in one sparse region and none of it has been written.
+inline bool Nx2SparseUnwritten(u64 gpu_address, u64 size) {
+    return Nx2RegionUnwritten(gpu_address, size, false);
+}
+
+/// The same for a GPU-only region backed as it is written, when its blocks are followed.
+inline bool Nx2GpuOnlyUnwritten(u64 gpu_address, u64 size) {
+    return Nx2RegionUnwritten(gpu_address, size, true);
+}
