+    // EDEN_NX2_GPU_ONLY_UNWRITTEN=1: nx2.h follows the blocks of GPU-only regions backed as they
+    // are written, as it does for sparse regions. Zeros over a block nobody wrote then need no
+    // memory there either (Nx2SparseBlockIsWritten says "written" for a region it does not know),
+    // and a large texture over such blocks gets none until they are written. Off, as before.
+    // The Legend of Zelda: Ocarina of Time has no such regions (LazyGpuOnlyRegions).
+    static bool FollowGpuOnlyBlocks() {
+        static const bool follow = [] {
+            const char* value = std::getenv("EDEN_NX2_GPU_ONLY_UNWRITTEN");
+            return value != nullptr && value[0] == '1';
+        }();
+        return follow;
+    }
