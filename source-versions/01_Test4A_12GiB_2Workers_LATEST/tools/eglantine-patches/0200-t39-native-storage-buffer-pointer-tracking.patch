+/// the driver constant buffer the program reads, all 16 for a dynamic read (see CheckCBufNVN).
+size_t PendingNvnBindings(const IR::Program& program, const StorageBufferSet& set) {
+    static constexpr u32 descriptor_size{0x10};
+    static constexpr u32 num_buffers{16};
