+            const IR::Value offset{inst.Arg(1)};
+            if (!index.IsImmediate() || (index.U32() == 0 && !offset.IsImmediate())) {
+                used.set();
+            } else if (index.U32() == 0 && offset.U32() >= base &&
+                       offset.U32() < base + descriptor_size * num_buffers) {
+                used.set((offset.U32() - base) / descriptor_size);
+            }
+        }
+    }
+    size_t pending{};
+    for (u32 slot = 0; slot < num_buffers; ++slot) {
+        const StorageBufferAddr address{.index = 0, .offset = base + slot * descriptor_size};
+        if (used.test(slot) && set.find(address) == set.end()) {
+            ++pending;
+        }
+    }
+    return pending;
+}
