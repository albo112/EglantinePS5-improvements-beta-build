diff --git a/src/tests/video_core/mesh_compute_interface.cpp b/src/tests/video_core/mesh_compute_interface.cpp
new file mode 100644
index 0000000000..aacff779ef
--- /dev/null
+++ b/src/tests/video_core/mesh_compute_interface.cpp
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <set>
+#include <stdexcept>
+
+#include <spirv/unified1/spirv.hpp>
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/backend/spirv/emit_spirv_mesh_readback.h"
+#include "shader_recompiler/backend/spirv/mesh_compute_interface.h"
+#include "shader_recompiler/frontend/ir/basic_block.h"
+#include "shader_recompiler/frontend/ir/ir_emitter.h"
+
+using namespace Shader;
+using namespace Shader::Backend::SPIRV;
+
+void Require(bool condition) {
+    if (!condition) {
+        throw std::runtime_error("mesh compute interface regression");
+    }
+}
+
+struct Module {
+    std::map<std::pair<u32, u32>, u32> decorations;
+    std::set<u32> flat;
+    std::set<u32> capabilities;
+    std::map<u32, u32> storage;
+    std::map<u32, u32> stores;
+    std::set<u32> loads;
+    bool sample{};
+    explicit Module(const std::vector<u32>& code, bool compute = true) {
+        for (size_t pos = 5; pos < code.size();) {
+            const u32 size = code[pos] >> 16;
+            Require(size != 0 && pos + size <= code.size());
+            const auto op = static_cast<spv::Op>(code[pos] & 0xffff);
+            if (op == spv::OpDecorate) {
+                if (size == 4)
+                    decorations[{code[pos + 1], code[pos + 2]}] = code[pos + 3];
+                if (code[pos + 2] == spv::DecorationFlat)
+                    flat.insert(code[pos + 1]);
+                if (compute)
+                    Require(code[pos + 2] != spv::DecorationPerPrimitiveEXT);
+            }
+            if (op == spv::OpCapability)
+                capabilities.insert(code[pos + 1]);
+            if (op == spv::OpVariable)
+                storage[code[pos + 2]] = code[pos + 3];
+            if (op == spv::OpStore)
+                stores[code[pos + 1]] = code[pos + 2];
+            if (op == spv::OpLoad)
+                loads.insert(code[pos + 2]);
+            if (op == spv::OpImageSampleImplicitLod)
+                sample = true;
+            pos += size;
+        }
+        if (compute)
+            Require(!capabilities.contains(spv::CapabilityMeshShadingEXT));
+    }
+    u32 Location(u32 location, spv::StorageClass sc) const {
+        for (const auto& [key, value] : decorations) {
+            if (key.second == spv::DecorationLocation && value == location &&
+                storage.at(key.first) == sc)
+                return key.first;
+        }
+        throw std::runtime_error("missing varying");
+    }
+};
+
+void Save(const char* name, const std::vector<u32>& code) {
+    std::ofstream out{name, std::ios::binary};
+    out.write(reinterpret_cast<const char*>(code.data()), code.size() * sizeof(u32));
+    Require(static_cast<bool>(out));
+}
+
+int main() {
+    MeshInfo mesh;
+    mesh.max_vertices = 3;
+    mesh.max_primitives = 1;
+    mesh.topology = 4;
+    mesh.vertex_lines = {u32(IR::Attribute::PositionX),     u32(IR::Attribute::PositionY),
+                         u32(IR::Attribute::PositionZ),     u32(IR::Attribute::PositionW),
+                         u32(IR::Attribute::Generic0X),     u32(IR::Attribute::Generic0Y),
+                         u32(IR::Attribute::ClipDistance0), u32(IR::Attribute::ClipDistance7)};
+    mesh.primitive_lines = {u32(IR::Attribute::PrimitiveId), u32(IR::Attribute::Generic1X),
+                            u32(IR::Attribute::Generic0X)};
+    Info fragment;
+    fragment.loads.Set(IR::Attribute::PrimitiveId, true);
+    fragment.loads.Set(IR::Attribute::Generic0X, true);
+    fragment.loads.Set(IR::Attribute::Generic0Y, true);
+    fragment.loads.Set(IR::Attribute::Generic1X, true);
+    fragment.loads.Set(IR::Attribute::Generic2X, true); // reserve even without a mesh output
+    RuntimeInfo runtime;
+    runtime.mesh_as_compute = true;
+    ConfigureMeshComputeInterface(runtime, mesh, fragment);
+    Require(runtime.mesh_compute_primitive_id_location == 3);
+    Require(runtime.per_primitive_generics[1] && !runtime.per_primitive_generics[0]);
+    Profile profile{};
+    profile.supported_spirv = 0x00010600;
+    profile.support_int64 = true;
+    profile.max_user_clip_distances = 8;
+    profile.unified_descriptor_binding = true;
+    const auto readback = EmitMeshReadbackVertex(profile, runtime, mesh);
+    Module vertex{readback};
+    Require(!vertex.flat.contains(vertex.Location(0, spv::StorageClassOutput)));
+    Require(vertex.flat.contains(vertex.Location(1, spv::StorageClassOutput)));
+    Require(vertex.flat.contains(vertex.Location(3, spv::StorageClassOutput)));
+    Require(vertex.capabilities.contains(spv::CapabilityClipDistance));
+    // The final PrimitiveId store must come from scratch, replacing the triangle fallback.
+    Require(vertex.loads.contains(vertex.stores.at(vertex.Location(3, spv::StorageClassOutput))));
+    bool clips{};
+    for (const auto& [key, value] : vertex.decorations) {
+        if (key.second == spv::DecorationBuiltIn && value == spv::BuiltInClipDistance)
+            clips = true;
+        Require(key.second != spv::DecorationBuiltIn || value != spv::BuiltInPrimitiveId);
+    }
+    Require(clips);
+    Save("mesh_interface_readback.spv", readback);
+
+    ObjectPool<IR::Inst> pool;
+    IR::Block block{pool};
+    IR::IREmitter ir{block};
+    ir.Prologue();
+    const auto uv = ir.CompositeConstruct(ir.GetAttribute(IR::Attribute::Generic0X),
+                                          ir.GetAttribute(IR::Attribute::Generic0Y));
+    IR::TextureInstInfo texture{};
+    texture.type.Assign(TextureType::Color2D);
+    const auto sampled = ir.ImageSampleImplicitLod(ir.Imm32(0), uv, {}, {}, {}, texture);
+    // The emitter consumes indexed texture IR, after the guest descriptor lowering pass.
+    sampled.Inst()->ReplaceOpcode(IR::Opcode::ImageSampleImplicitLod);
+    ir.SetFragColor(0, 0, IR::F32{ir.CompositeExtract(sampled, 0)});
+    ir.SetFragColor(0, 1, ir.GetAttribute(IR::Attribute::Generic1X));
+    ir.SetFragColor(0, 2, ir.BitCast<IR::F32>(ir.GetAttributeU32(IR::Attribute::PrimitiveId)));
+    ir.SetFragColor(0, 3, IR::F32{ir.CompositeExtract(sampled, 3)});
+    ir.Epilogue();
+    IR::Program program;
+    program.stage = Stage::Fragment;
+    program.blocks = {&block};
+    program.post_order_blocks = {&block};
+    program.syntax_list = {{{.block = &block}, IR::AbstractSyntaxNode::Type::Block},
+                           {{}, IR::AbstractSyntaxNode::Type::Return}};
+    program.info = fragment;
+    program.info.stores_frag_color[0] = true;
+    program.info.texture_descriptors.push_back({.type = TextureType::Color2D, .count = 1});
+    runtime.previous_stage_stores.mask.set();
+    runtime.generic_input_types.fill(AttributeType::Float);
+    runtime.color_output_types.fill(AttributeType::Float);
+    Backend::Bindings bindings{};
+    const auto frag = EmitSPIRV(profile, runtime, program, bindings);
+    Module input{frag};
+    Require(input.sample);
+    Require(!input.flat.contains(input.Location(0, spv::StorageClassInput)));
+    Require(input.flat.contains(input.Location(1, spv::StorageClassInput)));
+    Require(input.flat.contains(input.Location(3, spv::StorageClassInput)));
+    Save("mesh_interface_fragment.spv", frag);
+    program.info.interpolation[0] = Interpolation::NoPerspective;
+    bindings = {};
+    const auto no_perspective = EmitSPIRV(profile, runtime, program, bindings);
+    Module linear{no_perspective};
+    // NoPerspective is an operand-free decoration, like Flat.
+    bool has_no_perspective{};
+    const u32 uv_input = linear.Location(0, spv::StorageClassInput);
+    for (size_t pos = 5; pos < no_perspective.size(); pos += no_perspective[pos] >> 16) {
+        if ((no_perspective[pos] & 0xffff) == spv::OpDecorate &&
+            no_perspective[pos + 1] == uv_input &&
+            no_perspective[pos + 2] == spv::DecorationNoPerspective)
+            has_no_perspective = true;
+    }
+    Require(has_no_perspective);
+    Save("mesh_interface_linear.spv", no_perspective);
+    program.info.interpolation[0] = Interpolation::Flat;
+    bindings = {};
+    const auto flat = EmitSPIRV(profile, runtime, program, bindings);
+    Module flat_input{flat};
+    Require(flat_input.flat.contains(flat_input.Location(0, spv::StorageClassInput)));
+    Save("mesh_interface_flat.spv", flat);
+
+    RuntimeInfo native = runtime;
+    native.mesh_as_compute = false;
+    native.mesh_compute_primitive_id_location.reset();
+    bindings = {};
+    const auto native_code = EmitSPIRV(profile, native, program, bindings);
+    Module native_input{native_code, false};
+    Require(native_input.capabilities.contains(spv::CapabilityMeshShadingEXT));
+    bool builtin_id{};
+    for (const auto& [key, value] : native_input.decorations) {
+        if (key.second == spv::DecorationBuiltIn && value == spv::BuiltInPrimitiveId)
+            builtin_id = true;
+    }
+    Require(builtin_id);
+    Save("mesh_interface_native.spv", native_code);
+
+    profile.max_user_clip_distances = 4;
+    bool rejected{};
+    try {
+        EmitMeshReadbackVertex(profile, runtime, mesh);
+    } catch (const NotImplementedException&) {
+        rejected = true;
+    }
+    Require(rejected);
+    std::puts("textured fragment/readback interface and clip limit checked");
+    Info full = fragment;
+    for (u32 index = 0; index < 32; ++index)
+        full.loads.Set(IR::Attribute::Generic0X + index * 4, true);
+    rejected = false;
+    try {
+        ConfigureMeshComputeInterface(runtime, mesh, full);
+    } catch (const NotImplementedException&) {
+        rejected = true;
+    }
+    Require(rejected);
+    full.loads.Set(IR::Attribute::PrimitiveId, false);
+    ConfigureMeshComputeInterface(runtime, mesh, full);
+    Require(!runtime.mesh_compute_primitive_id_location);
+    std::puts("varying exhaustion and unused PrimitiveId checked");
+}
