diff --git a/src/shader_recompiler/backend/spirv/mesh_compute_interface.h b/src/shader_recompiler/backend/spirv/mesh_compute_interface.h
new file mode 100644
index 0000000000..b08165c1b8
--- /dev/null
+++ b/src/shader_recompiler/backend/spirv/mesh_compute_interface.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "shader_recompiler/exception.h"
+#include "shader_recompiler/runtime_info.h"
+#include "shader_recompiler/shader_info.h"
+
+namespace Shader::Backend::SPIRV {
+
+// Use the same interface for readback and fragment compilation, including disk-cache replay.
+inline void ConfigureMeshComputeInterface(RuntimeInfo& runtime, const MeshInfo& mesh,
+                                          const Info& fragment) {
+    std::bitset<32> occupied;
+    std::bitset<32> vertex;
+    for (u32 index = 0; index < 32; ++index) {
+        occupied[index] = fragment.loads.Generic(index);
+    }
+    for (const u32 line : mesh.vertex_lines) {
+        const auto attribute = static_cast<IR::Attribute>(line);
+        if (IR::IsGeneric(attribute)) {
+            vertex.set(IR::GenericAttributeIndex(attribute));
+        }
+    }
+    occupied |= vertex;
+    runtime.per_primitive_generics.reset();
+    runtime.mesh_compute_primitive_id_location.reset();
+    for (const u32 line : mesh.primitive_lines) {
+        const auto attribute = static_cast<IR::Attribute>(line);
+        if (IR::IsGeneric(attribute)) {
+            const u32 index = IR::GenericAttributeIndex(attribute);
+            occupied.set(index);
+            if (!vertex[index]) {
+                runtime.per_primitive_generics.set(index);
+            }
+        }
+    }
+    if (!fragment.loads[IR::Attribute::PrimitiveId]) {
+        return;
+    }
+    // A vertex shader cannot export BuiltIn PrimitiveId. Reserve a whole unused location;
+    // never alias guest texture coordinates or a fragment input absent from the output map.
+    for (u32 index = 0; index < 32; ++index) {
+        if (!occupied[index]) {
+            runtime.mesh_compute_primitive_id_location = index;
+            return;
+        }
+    }
+    throw NotImplementedException("Mesh compute PrimitiveId needs a free varying location");
+}
+
+} // namespace Shader::Backend::SPIRV
