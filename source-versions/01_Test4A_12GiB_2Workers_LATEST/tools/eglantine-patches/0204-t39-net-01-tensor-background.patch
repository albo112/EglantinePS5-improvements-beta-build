diff --git a/src/shader_recompiler/ir_opt/collect_shader_info_pass.cpp b/src/shader_recompiler/ir_opt/collect_shader_info_pass.cpp
index 85919bac42..1ef3851fdc 100644
--- a/src/shader_recompiler/ir_opt/collect_shader_info_pass.cpp
+++ b/src/shader_recompiler/ir_opt/collect_shader_info_pass.cpp
@@ -491,6 +491,7 @@ void VisitUsages(Info& info, IR::Inst& inst) {
         info.uses_rescaling_uniform = true;
         break;
     case IR::Opcode::TensorMulAdd:
+        info.uses_software_matrix = true;
         info.uses_subgroup_shuffles = true;
         info.uses_fp32_denorms_preserve = true;
         info.uses_subgroup_invocation_id = true;
diff --git a/src/shader_recompiler/shader_info.h b/src/shader_recompiler/shader_info.h
index 894ae47011..5985d13517 100644
--- a/src/shader_recompiler/shader_info.h
+++ b/src/shader_recompiler/shader_info.h
@@ -290,6 +290,7 @@ struct Info {
     bool uses_is_helper_invocation{};
     bool uses_subgroup_invocation_id{};
     bool uses_subgroup_shuffles{};
+    bool uses_software_matrix{};
     bool uses_quad_shuffles{};
     std::array<bool, 30> uses_patches{};
 
diff --git a/src/video_core/renderer_vulkan/vk_compute_pipeline.h b/src/video_core/renderer_vulkan/vk_compute_pipeline.h
index fba0519b58..82b39107fb 100644
--- a/src/video_core/renderer_vulkan/vk_compute_pipeline.h
+++ b/src/video_core/renderer_vulkan/vk_compute_pipeline.h
@@ -56,6 +56,16 @@ public:
         return static_cast<bool>(pipeline);
     }
 
+    /// The program runs HMMA through the SPIR-V helper.
+    [[nodiscard]] bool UsesSoftwareMatrix() const noexcept {
+        return info.uses_software_matrix;
+    }
+
+    /// Built, and the driver took it. A worker may still be on it: Configure would wait.
+    [[nodiscard]] bool IsRunnable() const noexcept {
+        return is_built.load(std::memory_order::acquire) && IsBound();
+    }
+
 private:
     const Device& device;
     vk::PipelineCache& pipeline_cache;
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 4f6f119cdd..2b77339c71 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1360,6 +1360,26 @@ void RasterizerVulkan::DispatchCompute() {
         if (kepler_compute->IsNativeMode()) throw Shader::RuntimeError("Native compute pipeline unavailable");
         return;
     }
+    // EDEN_NX2_TENSOR_BACKGROUND=1: a software matrix program's pipeline already builds on a
+    // worker, but Configure holds the scheduler until it is done, with every frame behind it:
+    // about 12 s for Ocarina of Time's network on PS5 Linux. Until it is built, and for good if
+    // the driver refuses it, this dispatch counts as rejected. "matrix multiply" in the text sends
+    // KeplerCompute to the upscale stand-in, which is what ran before the program was lowered.
+    static const bool tensor_background = [] {
+        const char* const value = std::getenv("EDEN_NX2_TENSOR_BACKGROUND");
+        return value != nullptr && value[0] != '0';
+    }();
+    if (tensor_background && kepler_compute->IsNativeMode() && pipeline->UsesSoftwareMatrix()) {
+        static bool held{};
+        if (!pipeline->IsRunnable()) {
+            held = true;
+            throw Shader::RuntimeError("native matrix multiply pipeline not ready, stand-in draws");
+        }
+        if (held) {
+            held = false;
+            LOG_INFO(Render_Vulkan, "Software matrix pipeline ready: the program itself runs now");
+        }
+    }
     if (TimedAb::Get().Active() && TimedAb::Get().SkipDispatch(pipeline_cache.LastComputeHash())) {
         return;
     }
