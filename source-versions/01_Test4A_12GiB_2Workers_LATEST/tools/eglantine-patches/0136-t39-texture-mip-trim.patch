+// A host image that keeps only guest levels >= offset (ImageFlagBits::TrimmedLevels): the copies
+// of the levels it does not keep go, and the ones left name host levels. Dropped before a
+// conversion (ConvertImage and ConvertedLayout read the guest level's size from the level number),
+// renumbered right before the upload.
+template <typename Copies>
+void DropTrimmedLevels(u32 offset, Copies& copies) {
+    if (offset == 0) {
+        return;
+    }
+    copies.erase(std::remove_if(copies.begin(), copies.end(),
+                                [offset](const BufferImageCopy& copy) {
+                                    return copy.image_subresource.base_level < static_cast<s32>(offset);
+                                }),
+                 copies.end());
+}
+template <typename Copies>
+void RenumberTrimmedLevels(u32 offset, Copies& copies) {
+    if (offset == 0) {
+        return;
+    }
+    for (BufferImageCopy& copy : copies) {
+        copy.image_subresource.base_level -= static_cast<s32>(offset);
+    }
+}
+
