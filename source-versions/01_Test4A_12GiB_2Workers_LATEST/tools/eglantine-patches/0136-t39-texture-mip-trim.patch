                 }
+                RenumberTrimmedLevels(image.host_level_offset, slice);
                 image.UploadMemory(*staging, slice);
                 has_uploads = true;
                 upload_budget -= (std::min)(upload_budget, bytes);
@@ -2789,6 +2823,7 @@ void TextureCache<P>::TickAsyncDecode() {
