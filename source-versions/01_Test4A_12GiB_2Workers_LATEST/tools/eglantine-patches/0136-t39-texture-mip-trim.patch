     } else {
-        const auto copies = UnswizzleImage(*gpu_memory, gpu_addr, image.info, swizzle_data, mapped_span);
+        auto copies = UnswizzleImage(*gpu_memory, gpu_addr, image.info, swizzle_data, mapped_span);
+        DropTrimmedLevels(image.host_level_offset, copies);
+        RenumberTrimmedLevels(image.host_level_offset, copies);
