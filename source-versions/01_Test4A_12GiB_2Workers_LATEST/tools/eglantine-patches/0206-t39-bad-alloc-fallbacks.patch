@@ -1760,6 +1794,9 @@ std::unique_ptr<ComputePipeline> PipelineCache::CreateComputePipeline(
 } catch (const Shader::Exception& exception) {
     LOG_ERROR(Render_Vulkan, "{}", exception.what());
     return nullptr;
+} catch (const std::bad_alloc&) {
+    SurviveBadAlloc("a compute pipeline");
