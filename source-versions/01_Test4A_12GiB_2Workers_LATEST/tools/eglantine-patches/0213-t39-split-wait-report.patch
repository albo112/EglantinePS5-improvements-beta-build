+void GpuSplit::Drain(DrainSite site) {
+    if (!SplitWaitsEnabled()) {
+        Drain();
+        return;
+    }
+    const bool behind = consumed.load(std::memory_order_acquire) != write_position;
+    const u64 start = WaitClockNs();
+    Drain();
+    if (behind) {
+        NoteWait(site, start);
+    }
+}
+
 bool GpuSplit::WaitForWriters() {
-    const u64 target = std::min(last_writer_position, write_position);
+    return WaitFor(std::min(last_writer_position, write_position), DrainSite::ListWriters);
+}
+
+// From Lichii (zortos293/Lichii, nx2 at 27226d2568): one wait with a site for the report. It waits
+// as WaitForWriters and WaitForSpace did, and now both wake a parked back and report as Drain does.
+bool GpuSplit::WaitFor(u64 target, DrainSite site) {
     consumed_cache = consumed.load(std::memory_order_acquire);
     if (consumed_cache >= target) {
         return false;
     }
-    wait_target.store(target, std::memory_order_seq_cst);
+    // Without EDEN_NX2_SPLIT_WAITS a full ring waits as WaitForSpace did: no early hand-back.
+    const bool plain_ring_wait = site == DrainSite::RingFull && !SplitWaitsEnabled();
+    if (!plain_ring_wait) {
+        wait_target.store(target, std::memory_order_seq_cst);
+    }
     Publish();
+    Nx2Profile::Scope scope{Nx2Profile::Zone::SplitDrain};
+    const u64 start = SplitWaitsEnabled() ? WaitClockNs() : 0;
+    std::chrono::steady_clock::time_point next_report{};
     for (u32 spins = 0;; ++spins) {
         consumed_cache = consumed.load(std::memory_order_acquire);
         if (consumed_cache >= target) {
-            wait_target.store(~u64{0}, std::memory_order_relaxed);
-            return true;
+            break;
         }
-        if (spins < 16384) {
+        if (spins < (plain_ring_wait ? 4096u : 16384u)) {
             Pause();
-        } else {
-            std::this_thread::yield();
+            continue;
+        }
+        std::this_thread::yield();
+        if ((spins & 1023) != 0) {
+            continue;
+        }
+        // As in Drain: re-wake a back thread whose wake-up was lost, and say so if it never ends.
+        if (back_waiting.load(std::memory_order_seq_cst)) {
+            wake.fetch_add(1, std::memory_order_seq_cst);
+            wake.notify_all();
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (next_report == std::chrono::steady_clock::time_point{}) {
+            next_report = now + std::chrono::seconds{5};
+        } else if (now >= next_report) {
+            next_report += std::chrono::seconds{5};
+            LOG_WARNING(HW_GPU,
+                        "GPU split wait on the back thread: {} of {} words consumed, waiting for "
+                        "{} at {}, back {} ({})",
+                        consumed_cache, write_position, target,
+                        drain_site_names[static_cast<size_t>(site)],
+                        back_waiting.load() ? "parked" : "running",
+                        g_back_busy.load() ? "inside a command" : "between batches");
+        }
+    }
+    wait_target.store(~u64{0}, std::memory_order_relaxed);
+    if (start != 0) {
+        NoteWait(site, start);
+    }
+    return true;
+}
+
+void GpuSplit::NoteWait(DrainSite site, u64 start) {
+    const auto index = static_cast<size_t>(site);
+    const u64 elapsed = WaitClockNs() - start;
+    wait_ns[index] += elapsed;
+    ++wait_count[index];
+    wait_max_ns[index] = std::max(wait_max_ns[index], elapsed);
+}
+
+void GpuSplit::ReportWaits() {
+    const u64 now = WaitClockNs();
+    if (waits_window_start == 0) {
+        waits_window_start = now;
+        waits_window_words = write_position;
+        return;
+    }
+    const u64 window = now - waits_window_start;
+    if (window < 10'000'000'000ULL) {
+        return;
+    }
+    const auto per_second = [window](u64 amount) {
+        return static_cast<double>(amount) * 1e9 / static_cast<double>(window);
+    };
+    u64 total_ns = 0;
+    std::string sites;
+    for (size_t i = 0; i < wait_count.size(); ++i) {
+        if (wait_count[i] == 0) {
+            continue;
         }
+        total_ns += wait_ns[i];
+        sites += fmt::format(", {} {:.1f} ms ({:.0f}/s, longest {:.1f} ms)", drain_site_names[i],
+                             per_second(wait_ns[i]) / 1e6, per_second(wait_count[i]),
+                             static_cast<double>(wait_max_ns[i]) / 1e6);
     }
+    LOG_INFO(HW_GPU, "GPU split per second: back idle {:.1f} ms, {:.0f} ring words, front waited "
+                     "{:.1f} ms{}",
+             per_second(back_idle_ns.exchange(0, std::memory_order_relaxed)) / 1e6,
+             per_second(write_position - waits_window_words), per_second(total_ns) / 1e6, sites);
+    wait_ns.fill(0);
+    wait_count.fill(0);
+    wait_max_ns.fill(0);
+    waits_window_start = now;
+    waits_window_words = write_position;
 }
 
