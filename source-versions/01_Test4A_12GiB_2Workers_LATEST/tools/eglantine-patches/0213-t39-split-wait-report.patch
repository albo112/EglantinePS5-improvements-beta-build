+// EDEN_NX2_SPLIT_WAITS=1: every 10 s the front logs where it waited for the back and how long the
+// back had nothing to do. Clocks are read only around waits and sleeps, so unlike
+// EDEN_NX2_GPU_PROFILE (a clock pair per method, ~25% of the GPU thread on the console) it barely
+// moves what it measures. A function-local static: env.txt is read in main, after the globals.
+bool SplitWaitsEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NX2_SPLIT_WAITS");
+        return value != nullptr && value[0] != '0';
+    }();
+    return enabled;
+}
+
+u64 WaitClockNs() {
+    return static_cast<u64>(Common::g_wall_clock.GetTimeNS().count());
+}
+
+struct BackIdleClock {
+    explicit BackIdleClock(std::atomic<u64>& total_)
+        : total{total_}, start{SplitWaitsEnabled() ? WaitClockNs() : 0} {}
+    ~BackIdleClock() {
+        if (start != 0) {
+            total.fetch_add(WaitClockNs() - start, std::memory_order_relaxed);
+        }
+    }
+    std::atomic<u64>& total;
+    u64 start;
+};
+
