+std::optional<StagingBufferRef> StagingBufferPool::TryRequest(size_t size, MemoryUsage usage,
+                                                              bool deferred) {
+    // A refusal walks the caches, trims the heap and writes to stderr, and the next fence comes
+    // within milliseconds: for 250 ms only what already exists is handed out.
+    constexpr auto RefusalPause = std::chrono::milliseconds(250);
+    const auto now = std::chrono::steady_clock::now();
+    no_new_buffers = now < refused_until;
+    try {
+        const StagingBufferRef ref = Request(size, usage, deferred);
+        no_new_buffers = false;
+        return ref;
+    } catch (const vk::Exception& refused) {
+        const bool paused = std::exchange(no_new_buffers, false);
+        if (refused.GetResult() != VK_ERROR_OUT_OF_DEVICE_MEMORY) {
+            throw;
+        }
+        if (!paused) {
+            refused_until = now + RefusalPause;
+        }
+        return std::nullopt;
+    }
+}
+
+StagingBufferRef StagingBufferPool::ReservedDownload() noexcept {
+    return StagingBufferRef{
+        .buffer = *reserved_download,
+        .device_address = {},
+        .offset = 0,
+        .mapped_span = reserved_download.Mapped(),
+        .usage = MemoryUsage::Download,
+        .log2_level = {},
+        .index = {},
+    };
+}
+
 void StagingBufferPool::FreeDeferred(StagingBufferRef& ref, bool completed) {
     auto& entries = GetCache(ref.usage)[ref.log2_level].entries;
     const auto is_this_one = [&ref](const StagingBuffer& entry) {
@@ -194,6 +233,9 @@ StagingBufferRef StagingBufferPool::GetStagingBuffer(size_t size, MemoryUsage us
     if (const std::optional<StagingBufferRef> ref = TryGetReservedBuffer(size, usage, deferred)) {
         return *ref;
     }
+    if (no_new_buffers) {
+        throw vk::Exception(VK_ERROR_OUT_OF_DEVICE_MEMORY);
+    }
     return CreateStagingBuffer(size, usage, deferred);
 }
 
