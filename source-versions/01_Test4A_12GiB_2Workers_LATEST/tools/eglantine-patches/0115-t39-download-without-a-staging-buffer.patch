+template <class P>
+void BufferCache<P>::DownloadInPieces(Buffer& buffer, const BufferCopy& copy) {
+    if constexpr (requires { runtime.ReservedDownloadBuffer(); }) {
+        const auto piece = runtime.ReservedDownloadBuffer();
+        const u64 piece_size = piece.mapped_span.size();
+        for (u64 done = 0; done < copy.size;) {
+            if (download_pieces_bytes >= piece_size) {
+                FinishDownloadPieces();
+            }
+            const u64 size = (std::min)(copy.size - done, piece_size - download_pieces_bytes);
+            const BufferCopy part{
+                .src_offset = copy.src_offset + done,
+                .dst_offset = piece.offset + download_pieces_bytes,
+                .size = size,
+            };
+            buffer.MarkUsage(part.src_offset, size);
+            runtime.CopyBuffer(piece.buffer, buffer, std::span{&part, 1}, true);
+            download_pieces.push_back({buffer.CpuAddr() + part.src_offset, download_pieces_bytes,
+                                       size});
+            download_pieces_bytes += Common::AlignUp(size, 64);
+            done += size;
+        }
+    }
+}
+
+template <class P>
+void BufferCache<P>::FinishDownloadPieces() {
+    if constexpr (requires { runtime.ReservedDownloadBuffer(); }) {
+        if (download_pieces.empty()) {
+            return;
+        }
+        static u64 times = 0;
+        if (++times; (times & (times - 1)) == 0) { // the 1st, 2nd, 4th, 8th ... time
+            LOG_WARNING(HW_GPU, "No staging buffer for a download, {} times so far: waited for the "
+                                "GPU and copied through the small buffer",
+                        times);
+        }
+        runtime.Finish();
+        const u8* const mapped = runtime.ReservedDownloadBuffer().mapped_span.data();
+        for (const DownloadPiece& piece : download_pieces) {
+            device_memory.WriteBlockUnsafe(piece.device_addr, mapped + piece.offset, piece.size);
+            // Older downloads of these bytes must not land over them when their fences pop.
+            ClearDownload(piece.device_addr, piece.size);
+            gpu_modified_ranges.Subtract(piece.device_addr, piece.size);
+        }
+        download_pieces.clear();
+        download_pieces_bytes = 0;
+    }
+}
