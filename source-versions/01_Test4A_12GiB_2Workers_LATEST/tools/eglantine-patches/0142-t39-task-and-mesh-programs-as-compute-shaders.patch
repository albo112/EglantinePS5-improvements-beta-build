+// Run as compute (mesh_compute_layout.h): the scratch region's address and counts come from push
+// constants after the graphics ones, and the region is reached through physical storage buffer
+// pointers, so the module's addressing model changes.
+void EmitContext::DefineMeshCompute() {
+    if (!profile.support_int64) {
+        throw NotImplementedException("Mesh programs as compute without 64-bit integers");
+    }
+    if (!Sirit::ValidId(U64)) {
+        // Only programs that use 64-bit integers get the type (DefineCommonTypes).
+        AddCapability(spv::Capability::Int64);
+        U64 = Name(TypeInt(64, false), "u64");
+    }
+    AddCapability(spv::Capability::PhysicalStorageBufferAddresses);
+    if (profile.supported_spirv < 0x00010500) {
+        AddExtension("SPV_KHR_physical_storage_buffer");
+    }
+    SetMemoryModel(spv::AddressingModel::PhysicalStorageBuffer64, spv::MemoryModel::GLSL450);
+    const std::array<Id, 5> members{U32[1], U32[1], U32[1], U32[1], U32[1]};
+    const Id block{TypeStruct(std::span(members.data(), members.size()))};
+    Decorate(block, spv::Decoration::Block);
+    Name(block, "MeshComputeLayout");
+    static constexpr std::array<const char*, 5> names{"scratch_low", "scratch_high", "tasks", "groups",
+                                                      "group_corners"};
+    for (u32 member = 0; member < names.size(); ++member) {
+        MemberDecorate(block, member, spv::Decoration::Offset, MESH_COMPUTE_PUSH_OFFSET + 4 * member);
+        MemberName(block, member, names[member]);
+    }
+    mesh_push_constants = AddGlobalVariable(TypePointer(spv::StorageClass::PushConstant, block),
+                                            spv::StorageClass::PushConstant);
+    Name(mesh_push_constants, "mesh_push_constants");
+    if (profile.supported_spirv >= 0x00010400) {
+        interfaces.push_back(mesh_push_constants);
+    }
+    mesh_scratch_u32 = TypePointer(spv::StorageClass::PhysicalStorageBuffer, U32[1]);
+    if (stage == Stage::Mesh) {
+        const Id private_u32{TypePointer(spv::StorageClass::Private, U32[1])};
+        mesh_task_index = AddGlobalVariable(private_u32, spv::StorageClass::Private, u32_zero_value);
+        Name(mesh_task_index, "mesh_task_index");
+        mesh_local_index = AddGlobalVariable(private_u32, spv::StorageClass::Private, u32_zero_value);
+        Name(mesh_local_index, "mesh_local_index");
+        if (profile.supported_spirv >= 0x00010400) {
+            interfaces.push_back(mesh_task_index);
+            interfaces.push_back(mesh_local_index);
+        }
+    }
