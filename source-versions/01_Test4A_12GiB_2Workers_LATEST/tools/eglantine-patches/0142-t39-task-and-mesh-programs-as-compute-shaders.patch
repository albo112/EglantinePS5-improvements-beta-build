diff --git a/src/shader_recompiler/backend/spirv/mesh_compute_layout.h b/src/shader_recompiler/backend/spirv/mesh_compute_layout.h
new file mode 100644
index 0000000000..0f48fa2db6
--- /dev/null
+++ b/src/shader_recompiler/backend/spirv/mesh_compute_layout.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Task and mesh programs run as compute (EDEN_NX2_MESH_AS_COMPUTE=1, RuntimeInfo::mesh_as_compute):
+// what the generated shaders and the Vulkan backend agree on. A task/mesh draw gets one scratch
+// region, addressed from push constants (MeshComputeLayout), laid out in 32-bit words:
+//
+//   0-3         VkDrawIndirectCommand of the readback draw: 3 * max_primitives corners per group
+//   4-6         VkDispatchIndirectCommand of the mesh pass after a task pass: groups, 1, 1
+//   7           the task pass's group count before the cap; zero (the CPU clears the header) when
+//               there is no task pass, and read instead of a region the draw does not have
+//   prefix      tasks + 1 words: each task's mesh group count, made exclusive prefix sums by the scan
+//   table       groups x 2 words (task pass only): each mesh group's task and index within it
+//   payload     tasks x payload_words: each task's output region, read by its mesh groups
+//   indices     groups x 3 x max_primitives: absolute vertex record indices; a primitive the program
+//               did not emit gets its group's vertex 0 three times (a degenerate triangle)
+//   vertices    groups x max_vertices x vertex_lines: the stage buffer's lines of each vertex
+//   primitives  groups x max_primitives x primitive_lines: the lines of each primitive
+//
+// tasks and groups are run-time values, the rest is fixed by the mesh program. The mesh pass
+// (emit_spirv_mesh.cpp), the scan (mesh_compute_scan.comp) and the readback vertex shader
+// (emit_spirv_mesh_readback.cpp) all compute PlanMeshScratch from the push constants.
+#pragma once
+
+#include <cstddef>
+
+#include "common/alignment.h"
+#include "common/common_types.h"
+#include "shader_recompiler/backend/spirv/emit_spirv.h"
+#include "shader_recompiler/shader_info.h"
+
+namespace Shader::Backend::SPIRV {
+
+/// Push constants of the compute passes and the readback vertex shader, after the graphics ones.
+/// The address is two 32-bit words: a 64-bit member read as zero on one driver tried (MoltenVK).
+struct MeshComputeLayout {
+    u32 scratch_low;   ///< device address of the draw's scratch region, low word
+    u32 scratch_high;  ///< its high word
+    u32 tasks;         ///< task workgroups of the draw; 0 for a pipeline without a task program
+    u32 groups;        ///< mesh groups the region holds: the draw's, or the cap after a task pass
+    u32 group_corners; ///< 3 * max_primitives, for the scan's draw header
+    u32 padding[3];
+};
+static_assert(sizeof(MeshComputeLayout) == 32);
+constexpr u32 MESH_COMPUTE_PUSH_OFFSET = sizeof(RescalingLayout) + sizeof(RenderAreaLayout);
+static_assert(MESH_COMPUTE_PUSH_OFFSET % 16 == 0);
+constexpr u32 MESH_COMPUTE_PUSH_END = MESH_COMPUTE_PUSH_OFFSET + sizeof(MeshComputeLayout);
+static_assert(MESH_COMPUTE_PUSH_END <= 128, "the smallest maxPushConstantsSize");
+
+constexpr u32 MESH_SCRATCH_HEADER_WORDS = 8;
+constexpr u32 MESH_SCRATCH_ZERO_WORD = 7;
+/// The most mesh workgroups one task workgroup may launch (Vulkan's maxMeshWorkGroupCount[0]).
+constexpr u32 MESH_MAX_GROUPS_PER_TASK = 65535;
+
+/// Region offsets in words, for the CPU side (the shaders compute the same from push constants).
+struct MeshScratchPlan {
+    u32 prefix;
+    u32 table;
+    u32 payload;
+    u32 indices;
+    u32 vertices;
+    u32 primitives;
+    u64 total; ///< words; 64-bit so a draw too large for a 32-bit size is still refused cleanly
+};
+
+inline MeshScratchPlan PlanMeshScratch(u32 tasks, u32 groups, const MeshInfo& mesh) noexcept {
+    const u64 vertex_words = mesh.vertex_lines.size();
+    const u64 primitive_words = mesh.primitive_lines.size();
+    MeshScratchPlan plan{};
+    plan.prefix = MESH_SCRATCH_HEADER_WORDS;
+    plan.table = Common::AlignUp(plan.prefix + tasks + 1, 4U);
+    plan.payload = plan.table + (tasks != 0 ? groups * 2 : 0);
+    const u64 indices = Common::AlignUp(u64{plan.payload} + u64{tasks} * mesh.payload_words, u64{4});
+    const u64 vertices = indices + u64{groups} * 3 * mesh.max_primitives;
+    const u64 primitives = vertices + u64{groups} * mesh.max_vertices * vertex_words;
+    plan.total = primitives + u64{groups} * mesh.max_primitives * primitive_words;
+    plan.indices = static_cast<u32>(indices);
+    plan.vertices = static_cast<u32>(vertices);
+    plan.primitives = static_cast<u32>(primitives);
+    return plan;
+}
+
+} // namespace Shader::Backend::SPIRV
diff --git a/src/shader_recompiler/backend/spirv/mesh_compute_scan.comp b/src/shader_recompiler/backend/spirv/mesh_compute_scan.comp
new file mode 100644
index 0000000000..867ebd1e0c
--- /dev/null
+++ b/src/shader_recompiler/backend/spirv/mesh_compute_scan.comp
@@ -0,0 +1,45 @@
+#version 450
+// EglantinePS5: the scan between a task pass run as compute and its mesh pass
+// (shader_recompiler/backend/spirv/mesh_compute_layout.h). One invocation: each task's mesh group
+// count becomes an exclusive prefix sum, every group gets its (task, index) table entry, and the
+// header gets the readback draw and the mesh dispatch, capped at the groups the region holds.
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+layout(local_size_x = 1) in;
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };
+layout(push_constant) uniform MeshComputeLayout {
+    layout(offset = 48) uint scratch_low; // MESH_COMPUTE_PUSH_OFFSET: sizeof(RescalingLayout) + sizeof(RenderAreaLayout)
+    uint scratch_high;
+    uint tasks;
+    uint groups;
+    uint group_corners;
+} push;
+void main() {
+    Words s = Words((uint64_t(push.scratch_high) << 32) | uint64_t(push.scratch_low));
+    const uint prefix = 8u;
+    const uint table = (prefix + push.tasks + 1u + 3u) & ~3u;
+    uint total = 0u;
+    for (uint t = 0u; t < push.tasks; ++t) {
+        const uint count = s.w[prefix + t];
+        s.w[prefix + t] = total;
+        for (uint m = 0u; m < count; ++m) {
+            const uint g = total + m;
+            if (g >= push.groups) {
+                break;
+            }
+            s.w[table + g * 2u] = t;
+            s.w[table + g * 2u + 1u] = m;
+        }
+        total += count;
+    }
+    s.w[prefix + push.tasks] = total;
+    const uint groups = min(total, push.groups);
+    s.w[0] = groups * push.group_corners;
+    s.w[1] = 1u;
+    s.w[2] = 0u;
+    s.w[3] = 0u;
+    s.w[4] = groups;
+    s.w[5] = 1u;
+    s.w[6] = 1u;
+    s.w[7] = total;
+}
