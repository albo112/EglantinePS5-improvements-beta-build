+// ---- Run as compute (mesh_compute_layout.h): the scratch region in place of the mesh outputs ----
+//
+// The task pass writes each task's mesh group count and payload, the scan (mesh_compute_scan.comp)
+// turns the counts into a table of (task, index) per mesh group and the draw header, the mesh pass
+// writes vertex records and primitive indices, and the readback vertex shader
+// (emit_spirv_mesh_readback.cpp) draws them as a triangle list.
+
+Id PushMember(EmitContext& ctx, u32 member) {
+    return ctx.OpLoad(ctx.U32[1],
+                      ctx.OpAccessChain(ctx.TypePointer(spv::StorageClass::PushConstant, ctx.U32[1]),
+                                        ctx.mesh_push_constants, ctx.Const(member)));
+}
+
+Id ScratchWord(EmitContext& ctx, Id base, Id word) {
+    const Id bytes{ctx.OpShiftLeftLogical(ctx.U64, ctx.OpUConvert(ctx.U64, word), ctx.Const(2U))};
+    return ctx.OpConvertUToPtr(ctx.mesh_scratch_u32, ctx.OpIAdd(ctx.U64, base, bytes));
+}
+
+Id LoadScratch(EmitContext& ctx, Id base, Id word) {
+    return ctx.OpLoad(ctx.U32[1], ScratchWord(ctx, base, word), spv::MemoryAccessMask::Aligned, 4U);
+}
+
+void StoreScratch(EmitContext& ctx, Id base, Id word, Id value) {
+    ctx.OpStore(ScratchWord(ctx, base, word), value, spv::MemoryAccessMask::Aligned, 4U);
+}
+
+Id AlignUp4(EmitContext& ctx, Id words) {
+    return ctx.OpBitwiseAnd(ctx.U32[1], ctx.OpIAdd(ctx.U32[1], words, ctx.Const(3U)),
+                            ctx.Const(~3U));
+}
+
+Id WorkgroupIndex(EmitContext& ctx) {
+    return ctx.OpCompositeExtract(ctx.U32[1], ctx.OpLoad(ctx.U32[3], ctx.workgroup_id), 0U);
+}
+
+// PlanMeshScratch, from the push constants.
+struct ScratchPlan {
+    Id base, tasks, groups, has_tasks, prefix, table, payload, indices, vertices, primitives;
+};
+
+ScratchPlan PlanScratch(EmitContext& ctx) {
+    const MeshInfo& mesh{ctx.mesh_info};
+    const u32 vertex_words{static_cast<u32>(mesh.vertex_lines.size())};
+    ScratchPlan plan{};
+    const Id low{ctx.OpUConvert(ctx.U64, PushMember(ctx, 0))};
+    const Id high{ctx.OpUConvert(ctx.U64, PushMember(ctx, 1))};
+    plan.base = ctx.OpBitwiseOr(ctx.U64, low, ctx.OpShiftLeftLogical(ctx.U64, high, ctx.Const(32U)));
+    plan.tasks = PushMember(ctx, 2);
+    plan.groups = PushMember(ctx, 3);
+    plan.has_tasks = ctx.OpINotEqual(ctx.U1, plan.tasks, ctx.u32_zero_value);
+    plan.prefix = ctx.Const(MESH_SCRATCH_HEADER_WORDS);
+    plan.table = AlignUp4(
+        ctx, ctx.OpIAdd(ctx.U32[1], plan.tasks, ctx.Const(MESH_SCRATCH_HEADER_WORDS + 1)));
+    const Id table_words{ctx.OpSelect(ctx.U32[1], plan.has_tasks,
+                                      ctx.OpIMul(ctx.U32[1], plan.groups, ctx.Const(2U)),
+                                      ctx.u32_zero_value)};
+    plan.payload = ctx.OpIAdd(ctx.U32[1], plan.table, table_words);
+    plan.indices = AlignUp4(
+        ctx, ctx.OpIAdd(ctx.U32[1], plan.payload,
+                        ctx.OpIMul(ctx.U32[1], plan.tasks, ctx.Const(mesh.payload_words))));
+    plan.vertices = ctx.OpIAdd(ctx.U32[1], plan.indices,
+                               ctx.OpIMul(ctx.U32[1], plan.groups, ctx.Const(3 * mesh.max_primitives)));
+    plan.primitives = ctx.OpIAdd(
+        ctx.U32[1], plan.vertices,
+        ctx.OpIMul(ctx.U32[1], plan.groups, ctx.Const(mesh.max_vertices * vertex_words)));
+    return plan;
+}
+
+// Mesh pass: which task this workgroup belongs to and its index within it, from the scan's
+// table; without a task pass the workgroup index is the mesh index and the table has no words,
+// so the zero word stands in for the read.
+void MeshComputePrologue(EmitContext& ctx) {
+    const ScratchPlan plan{PlanScratch(ctx)};
+    const Id group{WorkgroupIndex(ctx)};
+    const Id entry{ctx.OpIAdd(ctx.U32[1], plan.table, ctx.OpIMul(ctx.U32[1], group, ctx.Const(2U)))};
+    const Id zero_word{ctx.Const(MESH_SCRATCH_ZERO_WORD)};
+    const Id task{LoadScratch(ctx, plan.base, ctx.OpSelect(ctx.U32[1], plan.has_tasks, entry, zero_word))};
+    const Id local{LoadScratch(
+        ctx, plan.base,
+        ctx.OpSelect(ctx.U32[1], plan.has_tasks, ctx.OpIAdd(ctx.U32[1], entry, ctx.Const(1U)),
+                     zero_word))};
+    ctx.OpStore(ctx.mesh_task_index, task);
+    ctx.OpStore(ctx.mesh_local_index, ctx.OpSelect(ctx.U32[1], plan.has_tasks, local, group));
+}
+
+// Task pass: the mesh group count to the prefix table, the payload to the payload region.
+void TaskComputeEpilogue(EmitContext& ctx) {
+    Barrier(ctx);
+    const ScratchPlan plan{PlanScratch(ctx)};
+    const Id group{WorkgroupIndex(ctx)};
+    const Id invocation{LocalInvocation(ctx)};
+    const Id written{ctx.OpLoad(ctx.U32[1], PayloadWord(ctx, ctx.Const(1U)))};
+    const Id count{ctx.OpUMin(ctx.U32[1], written, ctx.Const(MESH_MAX_GROUPS_PER_TASK))};
+    If(ctx, ctx.OpIEqual(ctx.U1, invocation, ctx.u32_zero_value), [&] {
+        StoreScratch(ctx, plan.base, ctx.OpIAdd(ctx.U32[1], plan.prefix, group), count);
+    });
+    const u32 words{ctx.mesh_info.payload_words};
+    const u32 threads{ctx.mesh_threads};
+    const Id region{ctx.OpIAdd(ctx.U32[1], plan.payload, ctx.OpIMul(ctx.U32[1], group, ctx.Const(words)))};
+    for (u32 first = 0; first < words; first += threads) {
+        const Id index{ctx.OpIAdd(ctx.U32[1], invocation, ctx.Const(first))};
+        const auto copy = [&] {
+            StoreScratch(ctx, plan.base, ctx.OpIAdd(ctx.U32[1], region, index),
+                         ctx.OpLoad(ctx.U32[1], PayloadWord(ctx, index)));
+        };
+        if (first + threads > words) {
+            If(ctx, ctx.OpULessThan(ctx.U1, index, ctx.Const(words)), copy);
+        } else {
+            copy();
+        }
+    }
+}
+
+// Mesh pass: the vertex lines to records, the map's vertex indices (absolute, degenerate for a
+// primitive the program did not emit) and the primitive lines; group 0 writes the draw header when
+// there is no scan to write it.
+void MeshComputeEpilogue(EmitContext& ctx) {
+    const MeshInfo& mesh{ctx.mesh_info};
+    Barrier(ctx);
+    const ScratchPlan plan{PlanScratch(ctx)};
+    const Id group{WorkgroupIndex(ctx)};
+    const Id invocation{LocalInvocation(ctx)};
+    const Id count{ctx.OpUMin(ctx.U32[1], ctx.OpLoad(ctx.U32[1], ctx.mesh_primitive_count),
+                              ctx.Const(mesh.max_primitives))};
+    const u32 threads{ctx.mesh_threads};
+    const u32 vertex_words{static_cast<u32>(mesh.vertex_lines.size())};
+    const u32 primitive_words{static_cast<u32>(mesh.primitive_lines.size())};
+
+    const Id header_lane{ctx.OpLogicalAnd(
+        ctx.U1,
+        ctx.OpLogicalAnd(ctx.U1, ctx.OpIEqual(ctx.U1, group, ctx.u32_zero_value),
+                         ctx.OpIEqual(ctx.U1, invocation, ctx.u32_zero_value)),
+        ctx.OpLogicalNot(ctx.U1, plan.has_tasks))};
+    If(ctx, header_lane, [&] {
+        StoreScratch(ctx, plan.base, ctx.Const(0U),
+                     ctx.OpIMul(ctx.U32[1], plan.groups, ctx.Const(3 * mesh.max_primitives)));
+        StoreScratch(ctx, plan.base, ctx.Const(1U), ctx.Const(1U));
+        StoreScratch(ctx, plan.base, ctx.Const(2U), ctx.u32_zero_value);
+        StoreScratch(ctx, plan.base, ctx.Const(3U), ctx.u32_zero_value);
+    });
+
+    const auto& lines{mesh.vertex_lines};
+    const auto z_line{std::ranges::find(lines, static_cast<u32>(IR::Attribute::PositionZ))};
+    const auto w_line{std::ranges::find(lines, static_cast<u32>(IR::Attribute::PositionW))};
+    const bool convert_depth{ctx.runtime_info.convert_depth_mode && !ctx.profile.support_native_ndc &&
+                             z_line != lines.end() && w_line != lines.end()};
+    const u32 z_index{static_cast<u32>(z_line - lines.begin())};
+    const u32 w_index{static_cast<u32>(w_line - lines.begin())};
+    const Id first_vertex{ctx.OpIMul(ctx.U32[1], group, ctx.Const(mesh.max_vertices))};
+    for (u32 first = 0; first < mesh.max_vertices && vertex_words != 0; first += threads) {
+        const Id vertex{ctx.OpIAdd(ctx.U32[1], invocation, ctx.Const(first))};
+        const auto copy = [&] {
+            // Word of line 0 (CopyLines): (vertex / 32) * lines * 32 + vertex % 32.
+            const Id line0{ctx.OpIAdd(
+                ctx.U32[1],
+                ctx.OpIMul(ctx.U32[1], ctx.OpShiftRightLogical(ctx.U32[1], vertex, ctx.Const(5U)),
+                           ctx.Const(vertex_words * 32)),
+                ctx.OpBitwiseAnd(ctx.U32[1], vertex, ctx.Const(31U)))};
+            const Id record{ctx.OpIAdd(
+                ctx.U32[1], plan.vertices,
+                ctx.OpIMul(ctx.U32[1], ctx.OpIAdd(ctx.U32[1], first_vertex, vertex),
+                           ctx.Const(vertex_words)))};
+            const auto line_word = [&](u32 line) {
+                return ctx.OpLoad(ctx.U32[1],
+                                  SharedWord(ctx, ctx.mesh_attributes,
+                                             ctx.OpIAdd(ctx.U32[1], line0, ctx.Const(line * 32))));
+            };
+            Id converted_z{};
+            if (convert_depth) {
+                // OpenGL-style clip space: z = (z + w) / 2 (ConvertDepth).
+                const Id z{ctx.OpBitcast(ctx.F32[1], line_word(z_index))};
+                const Id w{ctx.OpBitcast(ctx.F32[1], line_word(w_index))};
+                converted_z = ctx.OpBitcast(
+                    ctx.U32[1], ctx.OpFMul(ctx.F32[1], ctx.OpFAdd(ctx.F32[1], z, w), ctx.Const(0.5f)));
+            }
+            for (u32 line = 0; line < vertex_words; ++line) {
+                const Id word{convert_depth && line == z_index ? converted_z : line_word(line)};
+                StoreScratch(ctx, plan.base, ctx.OpIAdd(ctx.U32[1], record, ctx.Const(line)), word);
+            }
+        };
+        if (first + threads > mesh.max_vertices) {
+            If(ctx, ctx.OpULessThan(ctx.U1, vertex, ctx.Const(mesh.max_vertices)), copy);
+        } else {
+            copy();
+        }
+    }
+    const Id first_primitive{ctx.OpIMul(ctx.U32[1], group, ctx.Const(mesh.max_primitives))};
+    for (u32 first = 0; first < mesh.max_primitives; first += threads) {
+        const Id primitive{ctx.OpIAdd(ctx.U32[1], invocation, ctx.Const(first))};
+        const auto copy = [&] {
+            const Id absolute{ctx.OpIAdd(ctx.U32[1], first_primitive, primitive)};
+            const Id culled{ctx.OpUGreaterThanEqual(ctx.U1, primitive, count)};
+            const Id triangle{ctx.OpIAdd(ctx.U32[1], plan.indices,
+                                         ctx.OpIMul(ctx.U32[1], absolute, ctx.Const(3U)))};
+            // Vertex indices: map bytes 4 + 3 * primitive, below the vertex count (MeshEpilogue).
+            const Id byte{ctx.OpIAdd(ctx.U32[1], ctx.OpIMul(ctx.U32[1], primitive, ctx.Const(3U)),
+                                     ctx.Const(4U))};
+            for (u32 element = 0; element < 3; ++element) {
+                const Id address{ctx.OpIAdd(ctx.U32[1], byte, ctx.Const(element))};
+                const Id index{ctx.OpLoad(ctx.U32[1], SharedWord(ctx, ctx.mesh_map, address))};
+                const Id bounded{MeshBounds() && mesh.max_vertices != 0
+                                     ? Clamped(ctx, index, mesh.max_vertices)
+                                     : index};
+                const Id chosen{ctx.OpSelect(ctx.U32[1], culled, ctx.u32_zero_value, bounded)};
+                StoreScratch(ctx, plan.base, ctx.OpIAdd(ctx.U32[1], triangle, ctx.Const(element)),
+                             ctx.OpIAdd(ctx.U32[1], first_vertex, chosen));
+            }
+            if (primitive_words != 0) {
+                const Id line0{ctx.OpIAdd(
+                    ctx.U32[1],
+                    ctx.OpIMul(ctx.U32[1],
+                               ctx.OpShiftRightLogical(ctx.U32[1], primitive, ctx.Const(5U)),
+                               ctx.Const(primitive_words * 32)),
+                    ctx.OpIAdd(ctx.U32[1], ctx.OpBitwiseAnd(ctx.U32[1], primitive, ctx.Const(31U)),
+                               ctx.Const(ctx.mesh_primitive_base)))};
+                const Id record{ctx.OpIAdd(ctx.U32[1], plan.primitives,
+                                           ctx.OpIMul(ctx.U32[1], absolute, ctx.Const(primitive_words)))};
+                for (u32 line = 0; line < primitive_words; ++line) {
+                    const Id word{ctx.OpLoad(
+                        ctx.U32[1], SharedWord(ctx, ctx.mesh_attributes,
+                                               ctx.OpIAdd(ctx.U32[1], line0, ctx.Const(line * 32))))};
+                    StoreScratch(ctx, plan.base, ctx.OpIAdd(ctx.U32[1], record, ctx.Const(line)), word);
+                }
+            }
+        };
+        if (first + threads > mesh.max_primitives) {
+            If(ctx, ctx.OpULessThan(ctx.U1, primitive, ctx.Const(mesh.max_primitives)), copy);
+        } else {
+            copy();
+        }
+    }
+}
+
 void TaskEpilogue(EmitContext& ctx) {
     Barrier(ctx);
     const Id written{ctx.OpLoad(ctx.U32[1], PayloadWord(ctx, ctx.Const(1U)))};
@@ -197,6 +431,23 @@ Id EmitIsbeRead(EmitContext& ctx, Id address) {
     if (ctx.stage == Stage::Task) {
         return workgroup; // the input region holds the workgroup index (VERTEX_ID)
     }
+    if (ctx.mesh_compute) {
+        // Run as compute: the index within the task, and the task's payload from the scratch
+        // region (the zero word without a task pass).
+        const ScratchPlan plan{PlanScratch(ctx)};
+        const Id index{ctx.OpShiftRightLogical(ctx.U32[1], address, ctx.Const(2U))};
+        const Id task{ctx.OpLoad(ctx.U32[1], ctx.mesh_task_index)};
+        const Id word{ctx.OpIAdd(
+            ctx.U32[1],
+            ctx.OpIAdd(ctx.U32[1], plan.payload,
+                       ctx.OpIMul(ctx.U32[1], task, ctx.Const(ctx.mesh_info.payload_words))),
+            Clamped(ctx, index, ctx.mesh_info.payload_words))};
+        const Id value{LoadScratch(
+            ctx, plan.base,
+            ctx.OpSelect(ctx.U32[1], plan.has_tasks, word, ctx.Const(MESH_SCRATCH_ZERO_WORD)))};
+        return ctx.OpSelect(ctx.U32[1], ctx.OpIEqual(ctx.U1, address, ctx.u32_zero_value),
+                            ctx.OpLoad(ctx.U32[1], ctx.mesh_local_index), value);
+    }
     const Id index{ctx.OpShiftRightLogical(ctx.U32[1], address, ctx.Const(2U))};
     const Id word{ctx.OpLoad(ctx.U32[1], PayloadWord(ctx, index))};
     return ctx.OpSelect(ctx.U32[1], ctx.OpIEqual(ctx.U1, address, ctx.u32_zero_value), workgroup,
@@ -240,6 +491,9 @@ void EmitMeshPrologue(EmitContext& ctx) {
     if (ctx.stage != Stage::Mesh) {
         return;
     }
+    if (ctx.mesh_compute) {
+        MeshComputePrologue(ctx);
+    }
     // Every invocation stores the zero: no branch here, the entry block's label is a phi
     // predecessor for later blocks.
     ctx.OpStore(ctx.mesh_primitive_count, ctx.u32_zero_value);
@@ -247,6 +501,14 @@ void EmitMeshPrologue(EmitContext& ctx) {
 }
 
 void EmitMeshEpilogue(EmitContext& ctx) {
+    if (ctx.mesh_compute) {
+        if (ctx.stage == Stage::Task) {
+            TaskComputeEpilogue(ctx);
+        } else if (ctx.stage == Stage::Mesh) {
+            MeshComputeEpilogue(ctx);
+        }
+        return;
+    }
     if (ctx.stage == Stage::Task) {
         TaskEpilogue(ctx);
     } else if (ctx.stage == Stage::Mesh) {
diff --git a/src/shader_recompiler/backend/spirv/emit_spirv_mesh_readback.cpp b/src/shader_recompiler/backend/spirv/emit_spirv_mesh_readback.cpp
new file mode 100644
index 0000000000..2d2219306e
--- /dev/null
+++ b/src/shader_recompiler/backend/spirv/emit_spirv_mesh_readback.cpp
@@ -0,0 +1,291 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <optional>
+
+#include <sirit/sirit.h>
+
+#include "shader_recompiler/backend/spirv/emit_spirv_mesh_readback.h"
+#include "shader_recompiler/backend/spirv/mesh_compute_layout.h"
+#include "shader_recompiler/backend/spirv/mesh_compute_scan_spv.h"
+#include "shader_recompiler/exception.h"
+#include "shader_recompiler/frontend/ir/attribute.h"
+
+namespace Shader::Backend::SPIRV {
+namespace {
+using Sirit::Id;
+
+constexpr u32 NUM_GENERICS = 32;
+
+class ReadbackEmitter : public Sirit::Module {
+public:
+    ReadbackEmitter(const Profile& profile_, const RuntimeInfo& runtime_info_, const MeshInfo& mesh_)
+        : Sirit::Module(profile_.supported_spirv), profile{profile_},
+          runtime_info{runtime_info_}, mesh{mesh_} {}
+
+    std::vector<u32> Emit() {
+        DefineTypes();
+        DefineInterface();
+        const Id main{OpFunction(void_type, spv::FunctionControlMask::MaskNone,
+                                 TypeFunction(void_type))};
+        AddLabel();
+        Body();
+        OpReturn();
+        OpFunctionEnd();
+        AddEntryPoint(spv::ExecutionModel::Vertex, main, "main",
+                      std::span<const Id>(interfaces.data(), interfaces.size()));
+        return Assemble();
+    }
+
+private:
+    const Profile& profile;
+    const RuntimeInfo& runtime_info;
+    const MeshInfo& mesh;
+
+    Id void_type{}, bool_type{}, uint_type{}, sint_type{}, ulong_type{}, float_type{}, vec4_type{};
+    Id push{}, vertex_index{}, position{}, layer{}, viewport{};
+    std::array<Id, NUM_GENERICS> vertex_generics{}, primitive_generics{};
+    std::vector<Id> interfaces;
+    bool uses_layer{}, uses_viewport{};
+
+    [[nodiscard]] bool ListsAllGlobals() const noexcept {
+        return profile.supported_spirv >= 0x00010400;
+    }
+
+    [[nodiscard]] Id Const(u32 value) {
+        return Constant(uint_type, value);
+    }
+
+    void DefineTypes() {
+        AddCapability(spv::Capability::Shader);
+        AddCapability(spv::Capability::Int64);
+        AddCapability(spv::Capability::PhysicalStorageBufferAddresses);
+        if (profile.supported_spirv < 0x00010500) {
+            AddExtension("SPV_KHR_physical_storage_buffer");
+        }
+        SetMemoryModel(spv::AddressingModel::PhysicalStorageBuffer64, spv::MemoryModel::GLSL450);
+        void_type = TypeVoid();
+        bool_type = TypeBool();
+        uint_type = TypeInt(32, false);
+        sint_type = TypeInt(32, true);
+        ulong_type = TypeInt(64, false);
+        float_type = TypeFloat(32);
+        vec4_type = TypeVector(float_type, 4);
+    }
+
+    Id Global(spv::StorageClass storage_class, Id type) {
+        const Id variable{AddGlobalVariable(TypePointer(storage_class, type), storage_class)};
+        if (ListsAllGlobals() || storage_class == spv::StorageClass::Input ||
+            storage_class == spv::StorageClass::Output) {
+            interfaces.push_back(variable);
+        }
+        return variable;
+    }
+
+    void DefineInterface() {
+        const std::array<Id, 5> members{uint_type, uint_type, uint_type, uint_type, uint_type};
+        const Id block{TypeStruct(std::span(members.data(), members.size()))};
+        Decorate(block, spv::Decoration::Block);
+        Name(block, "MeshComputeLayout");
+        for (u32 member = 0; member < members.size(); ++member) {
+            MemberDecorate(block, member, spv::Decoration::Offset, MESH_COMPUTE_PUSH_OFFSET + 4 * member);
+        }
+        push = Global(spv::StorageClass::PushConstant, block);
+        Name(push, "mesh_push_constants");
+
+        vertex_index = Global(spv::StorageClass::Input, sint_type);
+        Decorate(vertex_index, spv::Decoration::BuiltIn, spv::BuiltIn::VertexIndex);
+        position = Global(spv::StorageClass::Output, vec4_type);
+        Decorate(position, spv::Decoration::BuiltIn, spv::BuiltIn::Position);
+
+        for (const u32 line : mesh.vertex_lines) {
+            const auto attribute{static_cast<IR::Attribute>(line)};
+            if (!IR::IsGeneric(attribute)) {
+                continue;
+            }
+            Id& variable{vertex_generics[IR::GenericAttributeIndex(attribute)]};
+            if (!Sirit::ValidId(variable)) {
+                variable = Global(spv::StorageClass::Output, vec4_type);
+                Decorate(variable, spv::Decoration::Location, IR::GenericAttributeIndex(attribute));
+            }
+        }
+        for (const u32 line : mesh.primitive_lines) {
+            const auto attribute{static_cast<IR::Attribute>(line)};
+            if (IR::IsGeneric(attribute)) {
+                const u32 index{IR::GenericAttributeIndex(attribute)};
+                if (Sirit::ValidId(vertex_generics[index])) {
+                    continue; // written per vertex too: the vertex value wins
+                }
+                Id& variable{primitive_generics[index]};
+                if (!Sirit::ValidId(variable)) {
+                    variable = Global(spv::StorageClass::Output, vec4_type);
+                    Decorate(variable, spv::Decoration::Location, index);
+                    Decorate(variable, spv::Decoration::Flat);
+                }
+                continue;
+            }
+            switch (attribute) {
+            case IR::Attribute::Layer:
+                uses_layer = true;
+                break;
+            case IR::Attribute::ViewportIndex:
+                uses_viewport = true;
+                break;
+            case IR::Attribute::PrimitiveId:
+                // The fragment program reads the rasterizer's primitive id: the triangle's index
+                // in the draw, not what the mesh program wrote.
+                break;
+            default:
+                break;
+            }
+        }
+        if (uses_layer || uses_viewport) {
+            if (!profile.support_viewport_index_layer_non_geometry) {
+                throw NotImplementedException(
+                    "Mesh program as compute writes the layer or viewport without "
+                    "VK_EXT_shader_viewport_index_layer");
+            }
+            AddCapability(spv::Capability::ShaderViewportIndexLayerEXT);
+            AddExtension("SPV_EXT_shader_viewport_index_layer");
+        }
+        if (uses_layer) {
+            layer = Global(spv::StorageClass::Output, sint_type);
+            Decorate(layer, spv::Decoration::BuiltIn, spv::BuiltIn::Layer);
+        }
+        if (uses_viewport) {
+            viewport = Global(spv::StorageClass::Output, sint_type);
+            Decorate(viewport, spv::Decoration::BuiltIn, spv::BuiltIn::ViewportIndex);
+        }
+    }
+
+    Id PushWord(u32 member) {
+        return OpLoad(uint_type, OpAccessChain(TypePointer(spv::StorageClass::PushConstant, uint_type), push,
+                                         Const(member)));
+    }
+
+    Id LoadWord(Id base, Id word) {
+        const Id bytes{OpShiftLeftLogical(ulong_type, OpUConvert(ulong_type, word), Const(2U))};
+        const Id pointer{OpConvertUToPtr(TypePointer(spv::StorageClass::PhysicalStorageBuffer, uint_type),
+                                         OpIAdd(ulong_type, base, bytes))};
+        return OpLoad(uint_type, pointer, spv::MemoryAccessMask::Aligned, 4U);
+    }
+
+    Id AlignUp4(Id words) {
+        return OpBitwiseAnd(uint_type, OpIAdd(uint_type, words, Const(3U)), Const(~3U));
+    }
+
+    void Body() {
+        const u32 vertex_words{static_cast<u32>(mesh.vertex_lines.size())};
+        const u32 primitive_words{static_cast<u32>(mesh.primitive_lines.size())};
+        const Id base{OpBitwiseOr(ulong_type, OpUConvert(ulong_type, PushWord(0)),
+                                  OpShiftLeftLogical(ulong_type, OpUConvert(ulong_type, PushWord(1)),
+                                                     Const(32U)))};
+        const Id tasks{PushWord(2)};
+        const Id groups{PushWord(3)};
+        // PlanMeshScratch, from the push constants.
+        const Id table{AlignUp4(OpIAdd(uint_type, tasks, Const(MESH_SCRATCH_HEADER_WORDS + 1)))};
+        const Id has_tasks{OpINotEqual(bool_type, tasks, Const(0U))};
+        const Id table_words{OpSelect(uint_type, has_tasks, OpIMul(uint_type, groups, Const(2U)), Const(0U))};
+        const Id payload{OpIAdd(uint_type, table, table_words)};
+        const Id indices{AlignUp4(OpIAdd(uint_type, payload, OpIMul(uint_type, tasks, Const(mesh.payload_words))))};
+        const Id vertices{OpIAdd(uint_type, indices, OpIMul(uint_type, groups, Const(3 * mesh.max_primitives)))};
+        const Id primitives{OpIAdd(uint_type, vertices,
+                                   OpIMul(uint_type, groups, Const(mesh.max_vertices * vertex_words)))};
+
+        const Id corner{OpBitcast(uint_type, OpLoad(sint_type, vertex_index))};
+        const Id triangle{OpUDiv(uint_type, corner, Const(3U))};
+        const Id index{LoadWord(base, OpIAdd(uint_type, indices, corner))};
+        const Id record{OpIAdd(uint_type, vertices, OpIMul(uint_type, index, Const(vertex_words)))};
+        const Id primitive_record{OpIAdd(uint_type, primitives, OpIMul(uint_type, triangle, Const(primitive_words)))};
+
+        std::array<Id, 4> position_values{Constant(float_type, 0.0f), Constant(float_type, 0.0f),
+                                          Constant(float_type, 0.0f), Constant(float_type, 1.0f)};
+        std::array<std::array<Id, 4>, NUM_GENERICS> generic_values{};
+        for (u32 line = 0; line < vertex_words; ++line) {
+            const auto attribute{static_cast<IR::Attribute>(mesh.vertex_lines[line])};
+            const auto word = [&] { return LoadWord(base, OpIAdd(uint_type, record, Const(line))); };
+            if (IR::IsGeneric(attribute)) {
+                generic_values[IR::GenericAttributeIndex(attribute)]
+                              [IR::GenericAttributeElement(attribute)] = OpBitcast(float_type, word());
+                continue;
+            }
+            switch (attribute) {
+            case IR::Attribute::PositionX:
+            case IR::Attribute::PositionY:
+            case IR::Attribute::PositionZ:
+            case IR::Attribute::PositionW:
+                position_values[static_cast<u32>(attribute) -
+                                static_cast<u32>(IR::Attribute::PositionX)] = OpBitcast(float_type, word());
+                break;
+            default:
+                break; // point size and per-primitive values in vertex lines: not read
+            }
+        }
+        OpStore(position, OpCompositeConstruct(vec4_type, std::span<const Id>(position_values)));
+        for (u32 index_ = 0; index_ < NUM_GENERICS; ++index_) {
+            if (!Sirit::ValidId(vertex_generics[index_])) {
+                continue;
+            }
+            std::array<Id, 4> values{Constant(float_type, 0.0f), Constant(float_type, 0.0f), Constant(float_type, 0.0f),
+                                     Constant(float_type, 1.0f)};
+            for (u32 element = 0; element < 4; ++element) {
+                if (Sirit::ValidId(generic_values[index_][element])) {
+                    values[element] = generic_values[index_][element];
+                }
+            }
+            OpStore(vertex_generics[index_], OpCompositeConstruct(vec4_type, std::span<const Id>(values)));
+        }
+
+        std::array<std::array<Id, 4>, NUM_GENERICS> primitive_values{};
+        for (u32 line = 0; line < primitive_words; ++line) {
+            const auto attribute{static_cast<IR::Attribute>(mesh.primitive_lines[line])};
+            const auto word = [&] {
+                return LoadWord(base, OpIAdd(uint_type, primitive_record, Const(line)));
+            };
+            if (IR::IsGeneric(attribute)) {
+                const u32 index_{IR::GenericAttributeIndex(attribute)};
+                if (Sirit::ValidId(primitive_generics[index_])) {
+                    primitive_values[index_][IR::GenericAttributeElement(attribute)] =
+                        OpBitcast(float_type, word());
+                }
+                continue;
+            }
+            if (attribute == IR::Attribute::Layer && Sirit::ValidId(layer)) {
+                OpStore(layer, OpBitcast(sint_type, word()));
+            } else if (attribute == IR::Attribute::ViewportIndex && Sirit::ValidId(viewport)) {
+                OpStore(viewport, OpBitcast(sint_type, word()));
+            }
+        }
+        for (u32 index_ = 0; index_ < NUM_GENERICS; ++index_) {
+            if (!Sirit::ValidId(primitive_generics[index_])) {
+                continue;
+            }
+            std::array<Id, 4> values{Constant(float_type, 0.0f), Constant(float_type, 0.0f), Constant(float_type, 0.0f),
+                                     Constant(float_type, 1.0f)};
+            for (u32 element = 0; element < 4; ++element) {
+                if (Sirit::ValidId(primitive_values[index_][element])) {
+                    values[element] = primitive_values[index_][element];
+                }
+            }
+            OpStore(primitive_generics[index_],
+                    OpCompositeConstruct(vec4_type, std::span<const Id>(values)));
+        }
+    }
+};
+} // Anonymous namespace
+
+std::vector<u32> EmitMeshReadbackVertex(const Profile& profile, const RuntimeInfo& runtime_info,
+                                        const MeshInfo& mesh) {
+    if (!profile.support_int64) {
+        throw NotImplementedException("Mesh programs as compute without 64-bit integers");
+    }
+    ReadbackEmitter emitter{profile, runtime_info, mesh};
+    return emitter.Emit();
+}
+
+std::span<const u32> MeshComputeScanSpirv() noexcept {
+    return std::span<const u32>(MESH_COMPUTE_SCAN_SPV.data(), MESH_COMPUTE_SCAN_SPV.size());
+}
+
+} // namespace Shader::Backend::SPIRV
