+namespace Shader::Backend::SPIRV {
+
+// Task and mesh programs run as compute (mesh_compute_layout.h): the vertex shader that reads the
+// mesh pass's records back for the triangle list the pipeline draws instead. Vertex i is corner
+// i % 3 of primitive i / 3; its record gives the position and the generic attributes the mesh
+// program wrote per vertex, the primitive's record the ones it wrote per primitive (flat, the same
+// on every corner) and the layer or viewport.
+[[nodiscard]] std::vector<u32> EmitMeshReadbackVertex(const Profile& profile,
+                                                      const RuntimeInfo& runtime_info,
+                                                      const MeshInfo& mesh);
