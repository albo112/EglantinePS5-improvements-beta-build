 #include <utility>
 #include <vector>
 
@@ -78,13 +79,37 @@ size_t GetStreamBufferSize(const Device& device) {
     }
     return (std::min)(Common::AlignUp(size, MAX_ALIGNMENT), MAX_STREAM_BUFFER_SIZE);
 }
+
+// EDEN_STREAM_RING_MIB=<16..128>: a smaller stream ring, in whole MiB. It is taken whole at the
+// start of a session. It keeps its NUM_SYNCS regions at any size, so the fence checks and the wait
+// when it wraps do not change: only how often they come. An upload over one region goes through a
+// staging buffer, which can be refused, so under 16 MiB a region would be less than the 1 MiB
+// UploadInChunks falls back to. Only ever lowers what GetStreamBufferSize chose.
+// Unset, the size is what it was.
+size_t StreamRingSize(size_t chosen) {
+    const char* const value = std::getenv("EDEN_STREAM_RING_MIB");
+    if (value == nullptr) {
+        return chosen;
+    }
+    constexpr unsigned long long MinMiB = 16;
+    const unsigned long long mib = std::strtoull(value, nullptr, 10);
+    if (mib < MinMiB || mib > (MAX_STREAM_BUFFER_SIZE >> 20)) {
+        LOG_WARNING(Render_Vulkan, "EDEN_STREAM_RING_MIB={} is not {} to {}: ignored", value, MinMiB,
+                    MAX_STREAM_BUFFER_SIZE >> 20);
+        return chosen;
+    }
+    const size_t ring = (std::min)(chosen, static_cast<size_t>(mib) << 20);
+    LOG_INFO(Render_Vulkan, "Stream ring {} MiB, regions of {} KiB", ring >> 20,
+             (ring / StagingBufferPool::NUM_SYNCS) >> 10);
+    return ring;
+}
 } // Anonymous namespace
 
