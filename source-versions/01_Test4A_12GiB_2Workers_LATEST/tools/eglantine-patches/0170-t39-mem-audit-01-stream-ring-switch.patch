+// A slice has to fit a region: 8 MiB is one of a 128 MiB ring, and a smaller ring
+// (EDEN_STREAM_RING_MIB) has smaller regions. Over one it would need a staging buffer, just when
+// the pool has none, and the decode would wait with its data held.
+template <typename Runtime>
+[[nodiscard]] size_t UploadSliceLimit(Runtime& runtime) {
+    if constexpr (requires { runtime.UploadSliceBytes(); }) {
+        return (std::min)(UPLOAD_SLICE_BYTES, runtime.UploadSliceBytes());
+    } else {
+        return UPLOAD_SLICE_BYTES;
+    }
+}
