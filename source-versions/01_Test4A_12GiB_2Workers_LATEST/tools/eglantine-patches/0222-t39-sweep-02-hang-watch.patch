+void Scheduler::NoteHangPipeline(const HangPipeline& pipeline) {
+    Record([this, pipeline](vk::CommandBuffer) {
+        static constexpr size_t max_pipelines = 256;
+        auto& pipelines = hang_work.pipelines;
+        if (std::ranges::find(pipelines, pipeline) != pipelines.end()) {
+            return;
+        }
+        if (pipelines.size() < max_pipelines) {
+            pipelines.push_back(pipeline);
+        } else {
+            ++hang_work.not_kept;
+        }
+    });
+}
+
+void Scheduler::HangSubmit(u64 tick, bool waits_on_semaphore) {
+    static constexpr size_t max_submissions = 64;
+    hang_work.tick = tick;
+    hang_work.waits_on_semaphore = waits_on_semaphore;
+    std::scoped_lock lock{hang_mutex};
+    hang_submissions.push_back(std::move(hang_work));
+    hang_work = {};
+    if (hang_submissions.size() > max_submissions) {
+        hang_submissions.pop_front();
+    }
+}
+
+// Never blocks: it copies what it can get and logs without the lock. Pipelines for the first few
+// reports, and silence after 64, so that a GPU that stays slow cannot flood the log.
+void Scheduler::ReportStall(u64 tick, u64 gpu_tick, u64 next_tick) {
+    static std::atomic<u32> reports{};
+    const u32 report = reports.fetch_add(1, std::memory_order_relaxed);
+    if (report >= 64) {
+        return;
+    }
+    std::vector<HangSubmission> unfinished;
+    u64 last_submitted{};
+    if (std::unique_lock lock{hang_mutex, std::try_to_lock}; lock.owns_lock()) {
+        if (!hang_submissions.empty()) {
+            last_submitted = hang_submissions.back().tick;
+        }
+        for (const HangSubmission& submission : hang_submissions) {
+            if (submission.tick > gpu_tick) {
+                unfinished.push_back(submission);
+            }
+        }
+    }
+    LOG_WARNING(Render_Vulkan,
+                "Hang watch: waited 3 s for GPU tick {}; the GPU is at tick {}, the last "
+                "submitted tick is {}, the next to record is {}",
+                tick, gpu_tick, last_submitted, next_tick);
+    if (report >= 4) {
+        return;
+    }
+    for (const HangSubmission& submission : unfinished) {
+        LOG_WARNING(Render_Vulkan, "Hang watch: unfinished tick {} ({} pipelines, {} not kept{})",
+                    submission.tick, submission.pipelines.size(), submission.not_kept,
+                    submission.waits_on_semaphore ? ", waits on a semaphore" : "");
+        // Stages as in the source commit: s0 to s5 by unique_hashes index, s6 for compute.
+        std::string line;
+        u32 on_line{};
+        for (const HangPipeline& pipeline : submission.pipelines) {
+            bool first{true};
+            for (size_t stage = 0; stage < pipeline.size(); ++stage) {
+                if (pipeline[stage] != 0) {
+                    line += fmt::format("{}s{}:{:016x}", first ? " " : "+", stage, pipeline[stage]);
+                    first = false;
+                }
+            }
+            if (++on_line == 8) {
+                LOG_WARNING(Render_Vulkan, "Hang watch: tick {}:{}", submission.tick, line);
+                line.clear();
+                on_line = 0;
+            }
+        }
+        if (on_line != 0) {
+            LOG_WARNING(Render_Vulkan, "Hang watch: tick {}:{}", submission.tick, line);
+        }
+    }
+}
