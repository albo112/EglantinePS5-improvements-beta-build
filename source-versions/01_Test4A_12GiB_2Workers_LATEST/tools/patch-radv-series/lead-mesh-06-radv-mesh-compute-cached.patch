diff --git a/src/amd/vulkan/radv_mesh_compute.c b/src/amd/vulkan/radv_mesh_compute.c
index 94866f3b2ae..46323b612d2 100644
--- a/src/amd/vulkan/radv_mesh_compute.c
+++ b/src/amd/vulkan/radv_mesh_compute.c
