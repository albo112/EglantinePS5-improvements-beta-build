diff --git a/src/amd/vulkan/meta/radv_meta_mesh_draw.c b/src/amd/vulkan/meta/radv_meta_mesh_draw.c
index 1c9f9e39db1..72ae4a52a9f 100644
--- a/src/amd/vulkan/meta/radv_meta_mesh_draw.c
+++ b/src/amd/vulkan/meta/radv_meta_mesh_draw.c
@@ -110,6 +110,47 @@ radv_meta_mesh_draw_records(struct radv_cmd_buffer *cmd_buffer, uint64_t indirec
    return records_va;
 }
 
+/* The records of an emulated task chunk whose mesh shader runs as compute (radv_mesh_compute.h),
+ * from its draw ring (indirect_va, stride, up to max_count task workgroups, or the count at
+ * count_va), and the header at header_va: the counts and each of passes passes' dispatch and copy
+ * draw, capacity mesh workgroups a pass at most. */
+void
+radv_meta_mesh_compute_records(struct radv_cmd_buffer *cmd_buffer, uint64_t indirect_va, uint32_t stride,
+                               uint64_t count_va, uint32_t max_count, uint64_t records_va, uint32_t task_rings,
+                               uint32_t task_draw_id, uint64_t header_va, uint32_t capacity,
+                               uint32_t vertices_per_workgroup, uint32_t passes)
+{
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   VkPipelineLayout layout;
+   VkPipeline pipeline;
+
+   VkResult result = get_pipeline(device, RADV_META_OBJECT_KEY_MESH_COMPUTE_RECORDS, 60,
+                                  radv_meta_nir_build_mesh_compute_records_cs, &pipeline, &layout);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd_buffer->vk, result);
+      return;
+   }
+
+   radv_meta_begin(cmd_buffer);
+   radv_meta_save(cmd_buffer, RADV_META_SAVE_COMPUTE_PIPELINE | RADV_META_SAVE_CONSTANTS);
+
+   radv_meta_bind_compute_pipeline(cmd_buffer, pipeline);
+
+   const uint32_t constants[15] = {
+      indirect_va, indirect_va >> 32, records_va,   records_va >> 32,       count_va, count_va >> 32, stride, max_count,
+      task_rings,  task_draw_id,      header_va,    header_va >> 32,        capacity, vertices_per_workgroup,
+      passes,
+   };
+   radv_meta_push_constants(cmd_buffer, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants), constants);
+
+   radv_unaligned_dispatch(cmd_buffer, 32, 1, 1);
+
+   radv_meta_end(cmd_buffer);
+
+   /* The command processor reads the passes' dispatches and draws, the compute pass the records. */
+   cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_CS_PARTIAL_FLUSH | RADV_CMD_FLAG_INV_VCACHE | RADV_CMD_FLAG_INV_SCACHE;
+}
+
 /* An emulated indirect task draw's chunks (radv_task_emulated), for draws
  * draws from first_draw, of chunks chunks of up to entries task workgroups
  * each: at out_va, a radv_task_emu_block a chunk, then the chunks' dispatch
diff --git a/src/amd/vulkan/nir/radv_meta_nir.c b/src/amd/vulkan/nir/radv_meta_nir.c
index 5a01044f11a..f99ec2e582b 100644
--- a/src/amd/vulkan/nir/radv_meta_nir.c
+++ b/src/amd/vulkan/nir/radv_meta_nir.c
@@ -7,6 +7,7 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include "radv_mesh_compute.h"
 #include "radv_meta_nir.h"
 #include "radv_shader.h"
 #include "nir/nir_format_convert.h"
@@ -1567,6 +1568,102 @@ radv_meta_nir_build_mesh_draw_records_cs(void)
  * (radv_task_emu_block) and its dispatch's workgroups, 0 past the draw's, which
  * the chunk's records and draw take as their count. An invocation a chunk.
  */
+/* The records of an emulated task chunk whose mesh shader runs as compute (radv_mesh_compute.h):
+ * a record a task workgroup (its grid, task draw and first mesh workgroup, as the ordered records
+ * of radv_meta_nir_build_mesh_draw_records_cs), then in the header the count of records and of
+ * mesh workgroups, and each pass's dispatch (x, 1, 1, 0) and copy draw (x vertices a workgroup,
+ * 1, 0, 0), x being the pass's mesh workgroups, at most capacity.
+ */
+nir_shader *
+radv_meta_nir_build_mesh_compute_records_cs(void)
+{
+   nir_builder b = radv_meta_nir_init_shader(MESA_SHADER_COMPUTE, "meta_mesh_compute_records_cs");
+   /* One subgroup, whatever the wave size. */
+   b.shader->info.workgroup_size[0] = 32;
+
+   nir_def *indirect_addr = nir_load_push_constant(&b, 1, 64, nir_imm_int(&b, 0), .base = 0, .range = 8);
+   nir_def *records_addr = nir_load_push_constant(&b, 1, 64, nir_imm_int(&b, 0), .base = 8, .range = 8);
+   nir_def *count_addr = nir_load_push_constant(&b, 1, 64, nir_imm_int(&b, 0), .base = 16, .range = 8);
+   nir_def *stride = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 24, .range = 4);
+   nir_def *max_count = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 28, .range = 4);
+   nir_def *task_rings = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 32, .range = 4);
+   nir_def *task_draw_id = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 36, .range = 4);
+   nir_def *header_addr = nir_load_push_constant(&b, 1, 64, nir_imm_int(&b, 0), .base = 40, .range = 8);
+   nir_def *capacity = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 48, .range = 4);
+   nir_def *vertices_per_workgroup = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 52, .range = 4);
+   nir_def *passes = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 56, .range = 4);
+
+   nir_push_if(&b, nir_ine_imm(&b, count_addr, 0));
+   nir_def *count = nir_umin(&b, nir_build_load_global(&b, 1, 32, count_addr, .align_mul = 4), max_count);
+   nir_pop_if(&b, NULL);
+   count = nir_if_phi(&b, count, max_count);
+
+   nir_variable *first_var = nir_local_variable_create(b.impl, glsl_uint_type(), "first_draw");
+   nir_variable *workgroups_var = nir_local_variable_create(b.impl, glsl_uint64_t_type(), "workgroups");
+   nir_store_var(&b, first_var, nir_imm_int(&b, 0), 0x1);
+   nir_store_var(&b, workgroups_var, nir_imm_int64(&b, 0), 0x1);
+
+   nir_def *lane = nir_load_local_invocation_index(&b);
+   nir_push_loop(&b);
+   {
+      nir_def *first = nir_load_var(&b, first_var);
+      nir_break_if(&b, nir_uge(&b, first, count));
+
+      nir_def *draw = nir_iadd(&b, first, lane);
+      nir_def *active = nir_ult(&b, draw, count);
+      nir_push_if(&b, active);
+      nir_def *grid = mesh_draw_grid(&b, draw, indirect_addr, stride);
+      nir_pop_if(&b, NULL);
+      grid = nir_if_phi(&b, grid, nir_imm_zero(&b, 3, 32));
+
+      nir_def *own = nir_imul(&b, nir_imul(&b, nir_channel(&b, grid, 0), nir_channel(&b, grid, 1)),
+                              nir_channel(&b, grid, 2));
+      nir_def *before = nir_exclusive_scan(&b, own, .reduction_op = nir_op_iadd);
+      nir_def *sum = nir_reduce(&b, own, .reduction_op = nir_op_iadd);
+      nir_def *workgroups = nir_load_var(&b, workgroups_var);
+
+      nir_push_if(&b, active);
+      mesh_draw_record(&b, draw, records_addr, nir_imm_int(&b, 1), nir_imm_int(&b, 0),
+                       nir_iadd(&b, workgroups, nir_u2u64(&b, before)), grid, task_rings, task_draw_id);
+      nir_pop_if(&b, NULL);
+
+      nir_store_var(&b, workgroups_var, nir_iadd(&b, workgroups, nir_u2u64(&b, sum)), 0x1);
+      nir_store_var(&b, first_var, nir_iadd_imm(&b, first, 32), 0x1);
+   }
+   nir_pop_loop(&b, NULL);
+
+   nir_push_if(&b, nir_ieq_imm(&b, lane, 0));
+   {
+      /* What the passes hold: mesh workgroups past them are left out. */
+      nir_def *room = nir_u2u64(&b, nir_imul(&b, capacity, passes));
+      nir_def *total = nir_u2u32(&b, nir_umin(&b, nir_load_var(&b, workgroups_var), room));
+      nir_build_store_global(&b, nir_vec2(&b, count, total),
+                             nir_iadd_imm(&b, header_addr, RADV_MESH_COMPUTE_HEADER_RECORDS), .align_mul = 4);
+
+      nir_variable *pass_var = nir_local_variable_create(b.impl, glsl_uint_type(), "pass");
+      nir_store_var(&b, pass_var, nir_imm_int(&b, 0), 0x1);
+      nir_push_loop(&b);
+      {
+         nir_def *pass = nir_load_var(&b, pass_var);
+         nir_break_if(&b, nir_uge(&b, pass, passes));
+         nir_def *start = nir_umin(&b, nir_imul(&b, pass, capacity), total);
+         nir_def *x = nir_umin(&b, nir_isub(&b, total, start), capacity);
+         nir_def *args = nir_iadd(&b, header_addr,
+                                  nir_u2u64(&b, nir_iadd_imm(&b, nir_imul_imm(&b, pass, RADV_MESH_COMPUTE_PASS_BYTES),
+                                                             RADV_MESH_COMPUTE_HEADER_PASSES)));
+         nir_def *zero = nir_imm_int(&b, 0), *one = nir_imm_int(&b, 1);
+         nir_build_store_global(&b, nir_vec4(&b, x, one, one, zero), args, .align_mul = 16);
+         nir_build_store_global(&b, nir_vec4(&b, nir_imul(&b, x, vertices_per_workgroup), one, zero, zero),
+                                nir_iadd_imm(&b, args, 16), .align_mul = 16);
+         nir_store_var(&b, pass_var, nir_iadd_imm(&b, pass, 1), 0x1);
+      }
+      nir_pop_loop(&b, NULL);
+   }
+   nir_pop_if(&b, NULL);
+
+   return b.shader;
+}
+
 nir_shader *
 radv_meta_nir_build_task_chunks_cs(void)
 {
diff --git a/src/amd/vulkan/nir/radv_meta_nir.h b/src/amd/vulkan/nir/radv_meta_nir.h
index 1bead4e8b68..8ac1636a78b 100644
--- a/src/amd/vulkan/nir/radv_meta_nir.h
+++ b/src/amd/vulkan/nir/radv_meta_nir.h
@@ -99,6 +99,7 @@ nir_shader *radv_meta_nir_build_clear_hiz_compute_shader(uint32_t samples);
 
 nir_shader *radv_meta_nir_build_copy_memory_indirect_preprocess_cs(void);
 nir_shader *radv_meta_nir_build_mesh_draw_records_cs(void);
+nir_shader *radv_meta_nir_build_mesh_compute_records_cs(void);
 nir_shader *radv_meta_nir_build_task_chunks_cs(void);
 nir_shader *radv_meta_nir_build_copy_memory_indirect_cs(void);
 
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 89c8e8dba94..fc3cc127b6b 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -10,6 +10,9 @@
 
 #include "radv_cmd_buffer.h"
 #include "radv_gs_compute.h"
+#ifdef RADV_GS_COMPUTE
+#include "radv_mesh_compute.h"
+#endif
 #include "poly/geometry.h"
 #include "meta/radv_meta.h"
 #include "tools/radv_debug_hang.h"
@@ -9285,6 +9288,15 @@ radv_bind_rt_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_ray_tracin
       cmd_buffer->state.rt_stack_size = rt_pipeline->stack_size;
 }
 
+/* The stages whose shaders a pipeline binds: its API stages, and for a mesh shader run as compute
+ * on the PS5 (radv_mesh_compute.h) the vertex shader copying its output, which no API stage names.
+ */
+static VkShaderStageFlags
+radv_graphics_pipeline_bound_stages(const struct radv_graphics_pipeline *pipeline)
+{
+   return pipeline->active_stages | (pipeline->base.mesh_compute ? VK_SHADER_STAGE_VERTEX_BIT : 0);
+}
+
 static ALWAYS_INLINE void
 radv_bind_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_graphics_pipeline *graphics_pipeline)
 {
@@ -9296,8 +9308,8 @@ radv_bind_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_grap
    if (cmd_buffer->state.graphics_pipeline == graphics_pipeline)
       return;
 
-   radv_foreach_stage (
-      stage, (cmd_buffer->state.active_stages | graphics_pipeline->active_stages) & RADV_GRAPHICS_STAGE_BITS) {
+   radv_foreach_stage (stage, (cmd_buffer->state.active_stages | radv_graphics_pipeline_bound_stages(graphics_pipeline)) &
+                                 RADV_GRAPHICS_STAGE_BITS) {
       radv_bind_shader(cmd_buffer, graphics_pipeline->base.shaders[stage], stage);
    }
 
@@ -15685,6 +15697,179 @@ radv_task_emu_draw_indirect(struct radv_cmd_buffer *cmd_buffer, const struct rad
    radv_task_emu_end(cmd_buffer);
 }
 
+#ifdef RADV_GS_COMPUTE
+/* The compute pass of a mesh shader run as compute (radv_mesh_compute.h), over the workgroup
+ * count at indirect_va, with the graphics pipeline's descriptors and push constants. */
+static void
+radv_mesh_compute_dispatch(struct radv_cmd_buffer *cmd_buffer, const struct radv_shader *shader, uint64_t indirect_va)
+{
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   struct radv_cmd_stream *cs = cmd_buffer->cs;
+
+   radeon_check_space(device->ws, cs->b, 512);
+
+   cmd_buffer->queue_state.compute_scratch_size_per_wave_needed =
+      MAX2(cmd_buffer->queue_state.compute_scratch_size_per_wave_needed, shader->config.scratch_bytes_per_wave);
+   cmd_buffer->queue_state.compute_scratch_waves_wanted =
+      MAX2(cmd_buffer->queue_state.compute_scratch_waves_wanted,
+           radv_get_max_scratch_waves(device, (struct radv_shader *)shader));
+
+   radv_emit_compute_shader(pdev, cs, shader);
+   radv_emit_graphics_stage_for_compute(cmd_buffer, shader);
+
+   /* The compute state is this pass's now (as after radv_task_emu_dispatch). */
+   cmd_buffer->state.dirty |= RADV_CMD_DIRTY_COMPUTE_PIPELINE | RADV_CMD_DIRTY_RAY_TRACING_PIPELINE;
+   radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE);
+   radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR);
+   cmd_buffer->push_constant_stages |= VK_SHADER_STAGE_COMPUTE_BIT | RADV_RT_STAGE_BITS;
+
+   /* It reads the pass's first workgroup, which the command processor has just written. */
+   cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_INV_VCACHE | RADV_CMD_FLAG_INV_SCACHE;
+   radv_emit_cache_flush(cmd_buffer);
+
+   const struct radv_dispatch_info info = {
+      .indirect_va = indirect_va,
+   };
+   radv_emit_dispatch_packets(cmd_buffer, shader, &info);
+
+   /* The copy reads the slots. */
+   cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_CS_PARTIAL_FLUSH | RADV_CMD_FLAG_INV_VCACHE | RADV_CMD_FLAG_INV_SCACHE;
+}
+
+/* A chunk's mesh workgroups, from its draw ring (count task workgroups, or the count at
+ * count_va): the records pass, then per pass the first workgroup's index in the header, the
+ * compute pass and the copy draw. */
+static void
+radv_mesh_compute_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_task_emu *emu, uint32_t draw_id,
+                        uint32_t count, uint64_t count_va)
+{
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_pipeline *pipeline = &cmd_buffer->state.graphics_pipeline->base;
+   struct radv_cmd_stream *cs = cmd_buffer->cs;
+   const uint32_t capacity = pipeline->mesh_compute_capacity;
+   const uint32_t passes = MIN2(DIV_ROUND_UP(RADV_MESH_COMPUTE_CHUNK_WORKGROUPS, capacity), RADV_MESH_COMPUTE_MAX_PASSES);
+   const uint64_t header_va = radv_buffer_get_va(device->mesh_compute_bo);
+
+   radv_meta_mesh_compute_records(cmd_buffer, emu->draw_ring_va, AC_TASK_DRAW_ENTRY_BYTES, count_va, count,
+                                  emu->records_va, (uint32_t)emu->rings_va, draw_id, header_va, capacity,
+                                  pipeline->mesh_compute_vertices_per_workgroup, passes);
+
+   for (uint32_t pass = 0; pass < passes; pass++) {
+      const uint64_t args_va = header_va + RADV_MESH_COMPUTE_HEADER_PASSES + pass * RADV_MESH_COMPUTE_PASS_BYTES;
+      const uint32_t first = pass * capacity;
+
+      /* The records pass, or the last pass's compute pass and copy, are done with the header. */
+      radv_emit_cache_flush(cmd_buffer);
+      radeon_check_space(device->ws, cs->b, 16);
+      radv_cs_write_data(device, cs, V_371_MICRO_ENGINE, header_va + RADV_MESH_COMPUTE_HEADER_BASE, 1, &first, false);
+
+      radv_mesh_compute_dispatch(cmd_buffer, pipeline->mesh_compute, args_va);
+      radv_emit_cache_flush(cmd_buffer);
+
+      const struct radv_draw_info rast = {
+         .count = 1,
+         .indirect_va = args_va + 16,
+         .stride = 16,
+      };
+      radeon_check_space(device->ws, cs->b, 64);
+      radv_emit_indirect_draw_packets(cmd_buffer, &rast);
+
+      /* The next pass or chunk writes the header and the slots the copy reads, and the rings. */
+      cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_VS_PARTIAL_FLUSH;
+   }
+}
+
+/* A mesh draw of a pipeline whose mesh shader runs as compute: the emulated task draw's chunks
+ * (radv_task_emu_draw_direct, radv_task_emu_draw_indirect), each drawn by
+ * radv_mesh_compute_chunk, the copy as a triangle list. info is the indirect draw, or NULL with
+ * the direct draw's grid. */
+static void
+radv_mesh_compute_draw(struct radv_cmd_buffer *cmd_buffer, const struct radv_draw_info *info, uint32_t x, uint32_t y,
+                       uint32_t z)
+{
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_pipeline *pipeline = &cmd_buffer->state.graphics_pipeline->base;
+   struct radv_cmd_state *state = &cmd_buffer->state;
+   struct radv_dynamic_state *d = &state->dynamic;
+   const uint32_t workgroups = info ? 0 : x * y * z;
+
+   if ((!info && !workgroups) || (info && !info->count) || !pipeline->mesh_compute || !device->mesh_compute_bo)
+      return;
+
+   if (state->dirty & RADV_CMD_DIRTY_GRAPHICS_SHADERS)
+      radv_bind_graphics_shaders(cmd_buffer);
+
+   struct radv_task_emu emu;
+   if (!radv_task_emu_begin(cmd_buffer, &emu))
+      return;
+
+   radv_cs_add_buffer(device->ws, cmd_buffer->cs->b, device->mesh_compute_bo);
+
+   const uint32_t saved_topology = d->vk.ia.primitive_topology;
+   d->vk.ia.primitive_topology = V_008958_DI_PT_TRILIST;
+   state->dirty_dynamic |= RADV_DYNAMIC_PRIMITIVE_TOPOLOGY;
+   state->dirty |= RADV_CMD_DIRTY_VGT_PRIM_STATE;
+
+   const struct radv_draw_info rast = {
+      .count = 1,
+      .indirect_va = radv_buffer_get_va(device->mesh_compute_bo) + RADV_MESH_COMPUTE_HEADER_PASSES + 16,
+      .stride = 16,
+   };
+   if (radv_before_draw(cmd_buffer, &rast, 1, false)) {
+      if (!info) {
+         for (uint32_t first = 0; first < workgroups; first += emu.entries) {
+            const uint32_t count = MIN2(emu.entries, workgroups - first);
+            const struct radv_task_emu_block block = {.grid = {x, y, z}, .first_workgroup = first};
+            unsigned offset;
+            if (!radv_cmd_buffer_upload_data(cmd_buffer, sizeof(block), &block, &offset)) {
+               vk_command_buffer_set_error(&cmd_buffer->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+               break;
+            }
+            radv_task_emu_dispatch(cmd_buffer, &emu, radv_buffer_get_va(cmd_buffer->upload.upload_bo) + offset,
+                                   count, 0);
+            radv_mesh_compute_chunk(cmd_buffer, &emu, 0, count, 0);
+         }
+      } else {
+         /* As radv_task_emu_draw_indirect: every chunk the task workgroup limit allows, those past
+          * a draw's workgroups empty. */
+         const uint32_t chunks = DIV_ROUND_UP(1u << 22, emu.entries);
+         const uint32_t batch = MAX2(4096 / chunks, 1);
+         for (uint32_t first_draw = 0; first_draw < info->count; first_draw += batch) {
+            const uint32_t draws = MIN2(batch, info->count - first_draw);
+            unsigned offset;
+            if (!radv_cmd_buffer_upload_alloc_aligned(cmd_buffer, draws * chunks * 48, 16, &offset, NULL)) {
+               vk_command_buffer_set_error(&cmd_buffer->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+               break;
+            }
+            const uint64_t out_va = radv_buffer_get_va(cmd_buffer->upload.upload_bo) + offset;
+            radv_meta_task_chunks(cmd_buffer, info->indirect_va, info->stride, info->count_va, first_draw, draws,
+                                  chunks, emu.entries, out_va);
+
+            for (uint32_t i = 0; i < draws * chunks; i++) {
+               const uint64_t block_va = out_va + i * sizeof(struct radv_task_emu_block);
+               const uint64_t args_va = out_va + draws * chunks * sizeof(struct radv_task_emu_block) + i * 16;
+               radv_task_emu_dispatch(cmd_buffer, &emu, block_va, 0, args_va);
+               radv_mesh_compute_chunk(cmd_buffer, &emu, first_draw + i / chunks, emu.entries, args_va);
+            }
+         }
+      }
+      radv_after_draw(cmd_buffer);
+   }
+   radv_task_emu_end(cmd_buffer);
+
+   d->vk.ia.primitive_topology = saved_topology;
+   state->dirty_dynamic |= RADV_DYNAMIC_PRIMITIVE_TOPOLOGY;
+   state->dirty |= RADV_CMD_DIRTY_VGT_PRIM_STATE;
+}
