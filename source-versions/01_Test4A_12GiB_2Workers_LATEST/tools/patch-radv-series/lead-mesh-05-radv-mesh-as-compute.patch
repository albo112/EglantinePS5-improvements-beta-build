 #include "util/mesa-blake3.h"
 #include "util/os_time.h"
@@ -375,8 +378,13 @@ radv_pipeline_needed_dynamic_state(const struct radv_device *device, const struc
    if (pdev->info.gfx_level < GFX10_3)
